    (is (not (sheet-row model "could hold it whole")))))

(defun in-order-p (items list)
  "Whether ITEMS stand in LIST in their order, others between them."
  (loop with rest = list
        for item in items
        for at = (member item rest :test #'equal)
        always at
        do (setf rest (rest at))))

(defun page-labels (model key)
  "The labels of the settings the open sheet's page KEY holds."
  (mapcar #'nle::setting-label
          (nle::settings-section-rows (find key (nle::settings-sheet-sections model.dialog)
                                            :key #'nle::settings-section-key :test #'equal))))

(deftest settings-pages-gather-what-is-one-thing-by-what-it-is-for ()
  ;; The rail by what a section is for, every setting in one place: the
  ;; sections a page gathers stand under their heads, a provider's on Models,
  ;; a blank row before each group's name.
  (with-quick-settings (model port config :width 120 :height 40)
    (nlk:define-section ("transcription") ("enabled" :boolean :default t :doc "hear voice"))
    (nlk:define-section ("speech") ("enabled" :boolean :default t :doc "say replies"))
    (nlk:define-section ("cron") ("timeout_minutes" :integer :default 10 :min 1 :doc "a fire's limit"))
    (nlk:define-section ("openai-codex") (:owner "nl-codex") ("base_url" :string :doc "the backend"))
    (nlk:define-section ("codex-auth") (:owner "nl-codex-auth") ("endpoint" :string :doc "the sign-in"))
    (nlk:define-section ("nl-pro") (:owner "nl-pro") ("base_url" :string :doc "where it serves"))
    (dolist (key '("nl-codex" "nl-codex-auth" "nl-pro"))
      (nlk:hook :credential key (lambda (op next) (funcall next op))))
    (nle::slash-settings-op model)
    (let ((labels (sheet-sections model)))
      (is (equal '("General" "Models" "Latest changes") (subseq labels 0 3)) "the shell's own first")
      (is (in-order-p '("Memory" "Schedules" "Voice" "Updates" "Notifications" "Import" "Diagnostics" "Lane")
                      labels) "Agent, Channels, System, then a group no page names")
      (is (notany (lambda (label) (member label labels :test #'equal))
                  '("Transcription" "Spoken replies" "Terminal" "Request logging" "Codex auth" "OpenAI Codex" "Nl pro")) "no section doubles as a page of its own"))
    (let* ((rows (mapcar #'nle::plain-frame-row (sheet-rows model)))
           (agent (position-if (lambda (row) (search "AGENT" row)) rows)))
      (is (and agent (string= "" (string-trim " " (subseq (nth (1- agent) rows) 0 26)))) "a blank rail row before a group's name")
      (is (eql (search "AGENT" (nth agent rows)) (search "Memory" (nth (1+ agent) rows))) "the group's name and its pages on one edge"))
    (select-setting model "models" "Sign-in endpoint")
    (is (equal '("Default model" "Reasoning effort" "Auxiliary model" "Decider model" "Base url" "Sign-in endpoint" "Base url")
               (page-labels model "models")) "the models, then each provider's settings")
    (is (sheet-row model "OPENAI CODEX") "a provider under its name")
    (is (sheet-row model "NL PRO"))
    (is (null (sheet-row model "CODEX AUTH")) "the sign-in stands in Codex's block")
    (dialog-keys model :enter #\x :enter)
    (is (equal "x" (nlk:json-value (nle::read-shared-config) :string "codex-auth" "endpoint")) "a row a page gathers writes its own section")
    (select-setting model "voice" "Enabled")
    (is (sheet-row model "TRANSCRIPTION"))
    (is (sheet-row model "SPEECH"))
    (press model :enter)
    (is (equal '(nil t) (multiple-value-list (nlk:json-value (nle::read-shared-config) :any "transcription" "enabled"))) "the one under its head")
    (is (not (nth-value 1 (nlk:json-value (nle::read-shared-config) :any "speech" "enabled"))) "and not its namesake")
    (select-setting model "cron" "Job time limit")
    (is (equal "Schedules" (nle::settings-section-label (find "cron" (nle::settings-sheet-sections model.dialog)
                                                              :key #'nle::settings-section-key :test #'equal))))
    (is (sheet-row model "Job time limit" "10 min") "a fire's limit, said as what it bounds")))

