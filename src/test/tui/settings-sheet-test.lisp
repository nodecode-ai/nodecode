(deftest settings-pointer-picks-sections-settings-and-options ()
  (with-quick-settings (model port config :width 120 :height 40)
    (nle::slash-settings-op model)
    (let ((settings model.dialog))
      (flet ((click (needle)
               ;; The frame cell the last paint put NEEDLE at, clicked.
               (destructuring-bind (rows left top width) (nle::sheet-dialog-layout settings)
                 (declare (ignore width))
                 (loop for row in rows
                       for y from top
                       for at = (search needle (nle::plain-frame-row row))
                       when at
                         return (progn (nle::sheet-click model settings (+ left at) y) t)))))
        (sheet-rows model)
        (is (click "Lane") "a section in the rail")
        (is (equal "Lane" (nle::settings-section-label (nth (nle::settings-sheet-section-at settings)
                                                            (nle::settings-sheet-sections settings)))))
        (is (eq :pane (nle::settings-sheet-focus settings)))
        (sheet-rows model)
        (is (click "Loud"))
        (is (equal "Loud" (nle::setting-label (sheet-setting model))) "a setting's row chooses it")
        (sheet-rows model)
        (is (click " On "))
        (is (eq t (saved-setting :any "lane" "loud")) "an option clicked is written")))))

(deftest settings-key-row-caps-are-their-keys-to-click ()
  ;; A sheet's key row names keys as filled caps; a click on a cap or its
  ;; word is that key, run through UPDATE as a typed one: → opens the
  ;; section, ← goes back to the rail, esc closes the sheet.
  (with-quick-settings (model port config :width 120 :height 40)
    (nle::slash-settings-op model)
    (let ((settings model.dialog))
      (flet ((click (needle)
               ;; NEEDLE's frame cell as the last paint put it, pressed and
               ;; released through the shell's own UPDATE.
               (sheet-rows model)
               (destructuring-bind (rows left top width) (nle::sheet-dialog-layout settings)
                 (declare (ignore width))
                 (loop for row in rows
                       for y from top
                       for plain = (nle::plain-frame-row row)
                       for at = (search needle plain)
                       when at
                         return (progn (click-at model (+ left (nle::text-display-width (subseq plain 0 at)) 2)
                                                 (1+ y))
                                       t)))))
        (is (eq :rail (nle::settings-sheet-focus settings)))
        (is (click "→  open"))
        (is (eq :pane (nle::settings-sheet-focus settings)) "→'s cap opens the section")
        (is (click "←  sections"))
        (is (eq :rail (nle::settings-sheet-focus settings)) "←'s word goes back to the rail")
        (is (click "esc  close"))
        (is (null model.dialog) "esc's cap closes the sheet")))))

(deftest settings-a-wheel-notch-moves-the-list-under-the-pointer ()
  ;; A notch over the rail moved the pane's settings while the keys were
  ;; there (the operator: over the sidebar it scrolls its choice).
  (with-quick-settings (model port config :width 120 :height 40)
    (nle::slash-settings-op model)
    (let ((settings model.dialog))
      (sheet-rows model)
      (press model :right)
      (is (eq :pane (nle::settings-sheet-focus settings)) "the keys on General's settings")
      (destructuring-bind (rows left top width) (nle::sheet-dialog-layout settings)
        (declare (ignore rows width))
        (flet ((wheel (column direction)
                 (mouse-update model #'nlt:make-mouse-wheel-msg (+ left column 1) (+ top 8)
                               :direction direction)))
          (wheel 3 :down)
          (is (= 1 (nle::settings-sheet-section-at settings)) "a notch over the rail chooses the next page")
          (is (eq :rail (nle::settings-sheet-focus settings)))
          (wheel 3 :up)
          (is (= 0 (nle::settings-sheet-section-at settings)) "and the one before")
          (wheel 40 :down)
          (is (eq :pane (nle::settings-sheet-focus settings)) "a notch over the pane moves its settings")
          (is (= 0 (nle::settings-sheet-section-at settings)))
          (is (= 1 (nle::settings-sheet-setting-at settings))))))))

(deftest settings-the-pointer-resting-on-a-row-chooses-it ()
  ;; The pointer chooses nothing on the sheet, where a docked dialog's rows
  ;; follow it.
  (with-quick-settings (model port config :width 120 :height 40)
    (nle::slash-settings-op model)
    (let ((settings model.dialog))
      (labels ((label () (nle::settings-section-label (nth (nle::settings-sheet-section-at settings)
                                                          (nle::settings-sheet-sections settings))))
               (point (needle side &optional (past 0))
                 ;; The pointer onto NEEDLE where the last paint put it, in
                 ;; the rail or the pane; => whether nothing moved.
                 (sheet-rows model)
                 (destructuring-bind (rows left top width) (nle::sheet-dialog-layout settings)
                   (declare (ignore width))
                   (loop for row in rows
                         for y from top
                         for text = (nle::plain-frame-row row)
                         for at = (if (eq side :rail)
                                      (search needle text :end2 (min 26 (length text)))
                                      (search needle text :start2 (min 26 (length text))))
                         when at
                           return (nth-value 2 (mouse-update model #'nlt:make-mouse-motion-msg
                                                             (+ left at past 1) (1+ y)))))))
        (is (not (point "Latest changes" :rail)) "onto a page in the rail")
        (is (equal "Latest changes" (label)) "chooses it")
        (is (eq :rail (nle::settings-sheet-focus settings)))
        (is (point "Latest changes" :rail 3) "moving along it moves nothing")
        (point "Models" :rail)
        (is (equal "Models" (label)))
        (is (not (point "Reasoning effort" :pane)) "onto a setting in the pane")
        (is (eq :pane (nle::settings-sheet-focus settings)))
        (is (equal "Reasoning effort" (nle::setting-label (sheet-setting model))) "chooses it")
        (is (point "Reasoning effort" :pane 40) "its value is the same row")
        (press model #\t)
        (is (point "Latest changes" :rail) "under a query the rail stands still")
        (is (equal "Models" (label)))))))

(deftest settings-a-long-description-is-cut-and-says-so ()
  (with-quick-settings (model port config)
    (nlk:define-section ("nl-settings" "wordy")
      ("verbose" :boolean :default :false
                 :doc "One sentence after another about what this switch does, where it reads, when it applies, why it exists, what it costs, who asked for it, and every caveat a reader might want before turning it on, said at length until no pane could hold it whole."))
    (nle::slash-settings-op model)
