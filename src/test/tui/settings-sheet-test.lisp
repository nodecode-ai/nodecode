          (is (sheet-row model "Lane › Loud") "the ask lists what it gives back")
          (is (sheet-row model "General › Theme"))
          (is (null (sheet-row model "Rooms")) "a member the section needs is not listed")
          (is (sheet-row model "enter" "reset" "esc" "keep"))
