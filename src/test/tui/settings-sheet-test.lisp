(deftest settings-latest-changes-says-what-the-release-changed-and-is-new-until-opened ()
  (with-quick-settings (model port config :width 120 :height 40)
    (with-temp-file (nle::*changes-seen-path* :type "seen")
      (with-saved-globals ((nlk::*effective-version* "tv9")
                           (nle::*release-fetch*
                            (lambda (url)
                              (declare (ignore url))
                              (format nil "~{~a~%~}" '("tv9 core: the newest" "tv9b" "tv8 core: the one before"
                                                      "tv7 core: older")))))
        (nlk:session-state-put "gateway" "release" (nle::encode-json-object (nlk:json-object "label" "tv9" "from" "tv8")))
        (nle::slash-settings-op model)
        (flet ((latest () (find "latest" (nle::settings-sheet-sections model.dialog)
                                :key #'nle::settings-section-key :test #'equal)))
          (is (equal "new" (nle::settings-section-badge (latest))) "new until it is opened")
          (is (search "new" (subseq (nle::plain-frame-row (sheet-row model "Latest changes")) 0 26)) "beside its name")
          (dialog-keys model :down :down)
          (is (eq (latest) (nth (nle::settings-sheet-section-at model.dialog) (nle::settings-sheet-sections model.dialog))))
          (is (null (nle::settings-section-badge (latest))) "seen once chosen")
          (is (equal "tv9" (nle::changes-seen)) "and kept as seen")
          (is (sheet-row model "tv9" "core: the newest") "a change a row, its commit beside it")
          (is (null (sheet-row model "tv9b")) "a commit that changed nothing that ships is no change")
          (is (null (sheet-row model "core: the one before")) "nor is what the release before carried")
          (is (sheet-row model "since tv8"))
          (dialog-keys model :escape)
          (nle::slash-settings-op model)
          (is (null (nle::settings-section-badge (latest))) "a sheet opened again has nothing new")
          (dialog-keys model #\n #\e #\w #\e #\s #\t)
          (is (sheet-row model "Nothing matches") "what a release changed is read, not searched")))
      (with-saved-globals ((nlk::*effective-version* "tv10")
                           (nle::*release-fetch* (lambda (url) (declare (ignore url)) (values nil "HTTP 404"))))
        (loop while model.dialog do (press model :escape))
        (nle::slash-settings-op model)
        (dialog-keys model :down :down)
        (is (sheet-row model "no list of what tv10 changed") "a release the host lists nothing for says so")))))

(deftest settings-a-narrow-sheet-keeps-each-group-whole-in-a-column ()
  ;; Which group opens the second column follows from how many pages the
  ;; core declares: the fork section's page took SYSTEM to seven lines, more
  ;; than the first column has left at 24 rows, and SYSTEM itself moved over
  ;; ahead of NL SETTINGS. The claim is the shape: the second column opens on
  ;; a group's name, never on the tail of a group the first could not hold.
  (with-quick-settings (model port config :width 80 :height 24)
    (nle::slash-settings-op model)
    (let* ((rows (mapcar #'nle::plain-frame-row (sheet-rows model)))
           (system (position-if (lambda (row) (search "SYSTEM" row)) rows))
           (general (position-if (lambda (row) (search "General" row)) rows))
           (beside (and general (let ((row (nth general rows))) (subseq row (+ (search "General" row) (length "General"))))))
           (start (and beside (position-if #'alpha-char-p beside)))
           (opener (and start (subseq beside start (or (search "  " beside :start2 start) (length beside))))))
      (is system)
      (is (eql (search "SYSTEM" (nth system rows)) (search "Updates" (nth (1+ system) rows))) "a group's pages under its name")
      (is (and opener (string= opener (string-upcase opener)))
          (format nil "a group a column cannot hold whole starts the next one:~%~{  ~a~%~}" rows)))))

(deftest settings-the-gateway-runs-in-the-background-until-turned-off-there ()
  ;; Hermes' setup offers a user service first; here the gateway is on from
  ;; a home's first boot, and /settings turns it off.
  (with-quick-settings (model port config)
    (with-scripted-systemd (fake)
      (with-stubbed-fdefinition (nlk:organism-binary () +test-binary+)
        (nlk:gateway-on)
        (nle::slash-settings-op model)
        (is (member "Gateway" (sheet-sections model) :test #'equal) "a page of System")
        (select-setting model "gateway" "Run in the background")
        (is (sheet-row model "Run in the background" "[On]"))
        (press model :right)
        (is (not (nlk:gateway-installed-p)) "Off takes the unit out")
        (is (nlk:gateway-off-p) "and keeps the operator's off: no boot turns it on again")
        (is (sheet-row model "Run in the background" "[Off]"))
        (press model :delete)
        (is (nlk:gateway-installed-p) "its default back is On")
        (is (not (nlk:gateway-off-p)))
        (is (sheet-row model "Run in the background" "[On]"))))))

