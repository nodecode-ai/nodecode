(in-package #:nodecode.test)

(defun sheet-rows (model)
  "The open sheet's window as the frame paints it: plain text under the
suite's profile."
  (nle::compose-frame model)
  (first (nle::sheet-dialog-layout model.dialog)))

(defun sheet-row (model &rest needles)
  "The first row of the open sheet carrying every one of NEEDLES, or NIL."
  (find-if (lambda (row) (every (lambda (needle) (search needle row)) needles))
           (sheet-rows model)))

(defun sheet-sections (model)
  "The section labels the open sheet shows, in order."
  (mapcar #'nle::settings-section-label (nle::settings-sheet-sections model.dialog)))

(defun sheet-setting (model)
  "The setting the open sheet's keys act on."
  (nle::settings-current model.dialog))

(defun select-setting (model key label)
  "Choose the setting LABEL of the section KEY with the keys an operator
presses: Esc back to the sections, the arrows down or up to the section,
Right into it, Down to the setting."
  (let ((settings model.dialog))
    (loop while (or (plusp (length (nle::settings-sheet-query settings)))
                    (eq :pane (nle::settings-sheet-focus settings)))
          do (press model :escape))
    (let ((at (position key (nle::settings-sheet-sections settings)
                        :key #'nle::settings-section-key :test #'equal)))
      (assert at () "no section ~a" key)
      (loop until (= at (nle::settings-sheet-section-at settings))
            do (press model (if (< at (nle::settings-sheet-section-at settings)) :up :down)))
      (press model :enter)
      (let ((index (position label (nle::settings-section-rows (nth at (nle::settings-sheet-sections settings)))
                             :key #'nle::setting-label :test #'equal)))
        (assert index () "no setting ~a in ~a" label key)
        (loop repeat index do (press model :down))
        (assert (equal label (nle::setting-label (sheet-setting model))))))
    settings))

(defun saved-setting (type &rest path)
  "What config.jsonc holds at PATH under nl-settings, read as TYPE."
  (apply #'nlk:json-value (nle::read-shared-config) type "nl-settings" path))

(defmacro with-quick-settings ((model port config &key (width 100) (height 35)) &body body)
  `(with-settings-lane (,port ,config)
     (nlk:define-section ("nl-settings" "controls")
       ("count" :integer :default 3 :min 0 :doc "how many")
       ("active" :boolean :default t :doc "enabled by default"))
     (let ((,model (make-frame-model ,width ,height :http-port ,port :http-token "test-token"
                                                    :session-id "quick-settings")))
       ,@body)))

(deftest settings-command-opens-the-sheet-over-the-shell-not-a-turn ()
  (with-quick-settings (model port config)
    (let ((entry (nle::find-slash-command "settings")))
      (is (null (nle::slash-command-session entry)) "config is home-owned, not session-owned")
      (is (equal :guarded (nle::slash-command-dispatch entry)))
      (is (search "/settings" (nle::execute-slash-command model "settings" "unexpected")))
      (is (null model.dialog)))
    (nle::editor-insert model.editor "/settings")
    (nle:update model (nlt:make-key-press-msg :code :enter))
    (is (equal "" (nle::editor-value model.editor)))
    (is (nle::settings-sheet-p model.dialog))
    (is (eq :settings (nle::picker-dialog-kind model.dialog)) "the footer's toggle finds it by kind")
    (is (null (nle::chat-model-turn-in-flight model)))
    (is (equal "General" (first (sheet-sections model))) "the shell's own settings come first")
    (is (member "Lane" (sheet-sections model) :test #'equal))
    (sheet-rows model)
    (destructuring-bind (rows x y width) (nle::sheet-dialog-layout model.dialog)
      (is (and (plusp x) (plusp y)) "the window stands in the middle, not docked")
      (is (every (lambda (row) (= width (nle::text-display-width (nle::plain-frame-row row)))) rows) "every row is the window's width"))
    (is (null (nle::docked-dialog-frame-rows model)) "nothing docks: the composer stays behind it")
    (is (sheet-row model "Search every setting"))))

(deftest settings-sheet-folds-to-the-window-and-never-loses-its-settings ()
  ;; Wide, the rail of sections beside the open one; under 84 columns one
  ;; view at a time; under 50 columns or 16 rows the whole frame. The docked
  ;; panel this replaced showed no setting at all below 15 rows.
  (with-quick-settings (model port config :width 120 :height 40)
    (nle::slash-settings-op model)
    (flet ((size (width height)
             (nle:update model (nlt:make-window-size-msg :width width :height height))
             (sheet-rows model)))
      (is (row-carrying "Search every setting" (size 120 40)) "wide: the search field over the pane")
      (is (row-carrying "General" (size 120 40)))
      (is (row-carrying "type to search" (size 80 24)) "narrow: the sections alone")
      (destructuring-bind (rows x y width) (progn (size 48 12) (nle::sheet-dialog-layout model.dialog))
        (is (and (zerop x) (zerop y) (= width 48)) "tiny: the whole frame")
        (is (every (lambda (row) (= 48 (nle::text-display-width (nle::plain-frame-row row)))) rows)))
      (select-setting model "nl-settings.lane" "Loud")
      (is (row-carrying "Mode" (size 70 14)) "70x14 shows the chosen setting's neighbours")
      (dolist (size '((70 14) (60 12) (48 12)))
        (is (row-carrying "Loud" (apply #'size size)) (format nil "~{~ax~a~} still shows the setting" size))))))

(deftest settings-booleans-toggle-explicit-false-default-true-and-reset ()
  (with-quick-settings (model port config)
    (nle::slash-settings-op model)
    (let ((settings (select-setting model "nl-settings.lane" "Loud")))
      (press model #\Space)
      (is (eq settings model.dialog) "Space keeps the same sheet")
      (is (eq t (saved-setting :any "lane" "loud")))
      (is (search "Saved" (car (nle::settings-sheet-flash settings))))
      (is (equal "Loud" (nle::setting-label (sheet-setting model))) "the choice stays on the setting it wrote")
      (press model :enter)
      (is (null (saved-setting :any "lane" "loud")) "Enter writes explicit JSON false")
      (is (nth-value 1 (saved-setting :any "lane" "loud")))
      (press model :right)
      (is (eq t (saved-setting :any "lane" "loud")) "Right steps on, round past the last option")
      (press model :left :mod nlt:+mod-shift+)
      (is (eq t (saved-setting :any "lane" "loud")) "Shift+Left stops at the first option")
      (press model :down)
      (press model :left)
      (is (eq :rail (nle::settings-sheet-focus settings)) "Left goes back to the sections from any setting")
      (is (eq t (saved-setting :any "lane" "loud")) "and changes nothing on its way")
      (select-setting model "nl-settings.controls" "Active")
      (press model #\Space)
      (is (null (saved-setting :any "controls" "active")) "an absent true default toggles to false")
      (press model :delete)
      (is (not (nth-value 1 (saved-setting :any "controls" "active"))) "Delete removes the override")
      (is (sheet-row model "Active" "[On]"))
      (is (search "the operator's own note" (nlk:read-text config)) "the canonical writer retains comments")
      (loop repeat 4 while model.dialog do (press model :escape))
      (is (null model.dialog) "Esc walks back out and closes")
      (nle::slash-settings-op model)
      (select-setting model "nl-settings.controls" "Active")
      (is (sheet-row model "Active" "[On]") "reopening reads the saved file"))))

(deftest settings-notification-popups-toggle-now-persist-and-reset ()
  (with-settings-lane (port config)
    (let ((model (make-frame-model 100 35 :http-port port :http-token "test-token" :session-id "popup-settings")))
      (is (nlk:find-section '("tui")) "popup visibility is a declared setting")
      (when (nlk:find-section '("tui"))
        (nle::editor-insert (nle::chat-model-editor model) "/settings")
        (press model :enter)
        (select-setting model "notifications" "Popups")
        (is (sheet-row model "Popups" "[Off]") "the absent setting defaults to Off, on Notifications")
        (nle::toast model "SETTINGS-POPUP-PROBE" :stays t)
        (nle::compose-frame model)
        (is (null (nle::chat-model-toast-layout model)))
        (press model :enter)
        (is (eq t (nlk:json-value (nle::read-shared-config) :any "tui" "notification_popups")))
        (is (equal "Saved · applies now" (car (nle::settings-sheet-flash model.dialog))) "no restart is required")
        (is (not (nth-value 1 (nlk:json-value (nle::read-shared-config) :any "notify"))) "popup opt-in does not enable desktop notifications")
        (nle::compose-frame model)
        (is (nle::chat-model-toast-layout model) "On paints the popup immediately")
        (press model :enter)
        (nle::compose-frame model)
        (is (null (nlk:json-value (nle::read-shared-config) :any "tui" "notification_popups")) "Off persists explicit false")
        (is (null (nle::chat-model-toast-layout model)) "Off removes an already-visible popup")
        (press model :enter)
        (press model :delete)
        (nle::compose-frame model)
        (is (not (nth-value 1 (nlk:json-value (nle::read-shared-config) :any "tui" "notification_popups"))) "reset removes the override")
        (is (null (nle::chat-model-toast-layout model)) "reset restores hidden-by-default")
        (is (search "the operator's own note" (nlk:read-text config)) "the config writer keeps comments")))))

(deftest settings-choice-number-and-text-change-where-they-stand ()
  (with-quick-settings (model port config)
    (nlk:define-section ("nl-settings" "text")
      ("greeting" :string :doc "what it says first"))
    (nle::slash-settings-op model)
    (let ((settings (select-setting model "nl-settings.lane" "Mode")))
      (is (sheet-row model "Mode" "[Not set]") "a choice with no default says it is unset")
      (press model :right)
      (is (equal "a" (saved-setting :string "lane" "mode")) "Right writes the next option")
      (press model :right)
      (is (equal "b" (saved-setting :string "lane" "mode")))
      (press model #\Space)
      (is (not (nth-value 1 (saved-setting :any "lane" "mode"))) "Space wraps to unset, which removes it")
      (select-setting model "nl-settings.controls" "Count")
      (press model :right)
      (is (= 4 (saved-setting :any "controls" "count")) "Right steps the number")
      (press model :left :mod nlt:+mod-shift+)
      (is (= 3 (saved-setting :any "controls" "count")) "Shift+Left steps it down")
      (press model :right)
      (press model :enter)
      (is (equal "4" (cdr (nle::settings-sheet-edit settings))) "the field opens on the number")
      (dialog-keys model #\x :enter)
      (is (nle::settings-sheet-edit settings) "a number that is not one stays open")
      (is (sheet-row model "whole number") "and says why")
      (press model :escape)
      (is (null (nle::settings-sheet-edit settings)))
      (is (= 4 (saved-setting :any "controls" "count")) "Esc writes nothing")
      (press model :enter)
      (setf (cdr (nle::settings-sheet-edit settings)) "-1")
      (press model :enter)
      (is (sheet-row model ">= 0") "the canonical owner's refusal is said under the setting")
      (is (= 4 (saved-setting :any "controls" "count")))
      (press model :enter)
      (setf (cdr (nle::settings-sheet-edit settings)) "7")
      (press model :enter)
      (is (= 7 (saved-setting :any "controls" "count")))
      (is (null (nle::settings-sheet-edit settings)))
      (select-setting model "nl-settings.text" "Greeting")
      (dialog-keys model :enter #\h #\i :enter)
      (is (equal "hi" (saved-setting :string "text" "greeting")))
      (press model :enter)
      (is (equal "hi" (cdr (nle::settings-sheet-edit settings))) "the field opens on what is set")
      (dialog-keys model :enter)
      (press model :enter)
      (setf (cdr (nle::settings-sheet-edit settings)) "")
      (press model :enter)
      (is (not (nth-value 1 (saved-setting :any "text" "greeting"))) "an emptied field takes the member out"))))

(deftest settings-held-reads-cannot-reopen-replace-or-overwrite ()
  (with-quick-settings (model port config)
    (let ((pending nil))
      (flet ((land ()
               (destructuring-bind (thunk . continuation) (pop pending)
                 (funcall continuation model (funcall thunk)))))
        (with-stubbed-fdefinition (nle::off-loop (model thunk continuation)
                                    (setf pending (append pending (list (cons thunk continuation)))))
          (nle::slash-settings-op model)
          (is (null (nle::settings-sheet-answer model.dialog)))
          (is (sheet-row model "Reading settings") "the sheet stands at once and says it is reading")
          (press model :escape)
          (is (eq :quiet (land)))
          (is (null model.dialog) "a late read cannot reopen a closed sheet")
          (nle::slash-settings-op model)
          (nle::open-picker-dialog model "Other" nil nil :kind :other)
          (let ((other model.dialog))
            (is (eq :quiet (land)))
            (is (eq other model.dialog) "a late read cannot replace another dialog"))
          (nle::slash-settings-op model)
          (press model :escape)
          (nle::slash-settings-op model)
          (let ((new model.dialog))
            (is (eq :quiet (land)))
            (is (null (nle::settings-sheet-answer new)) "an older answer cannot fill a reopened sheet")
            (land)
            (is (eq new model.dialog))
            (is (nle::settings-sheet-answer new))
            (land)
            (is (nle::settings-sheet-release new) "what the release changed is read once the sections are")
            (select-setting model "nl-settings.lane" "Loud")
            (press model #\Space)
            (is (nle::settings-sheet-busy new))
            (press model #\Space)
            (is (= 1 (length pending)) "a change while a write is under way is not sent twice")
            (loop repeat 3 while model.dialog do (press model :escape))
            (is (eq :quiet (land)))
            (is (null model.dialog) "a late save receipt cannot reopen its sheet")
            (is (eq t (saved-setting :any "lane" "loud")) "a submitted write is not undone by closing its sheet")))))))

(deftest settings-read-failure-and-application-timing-are-explicit ()
  (with-frame-model (model 80 25 :session-id "settings-refusal")
    (with-stubbed-fdefinition (nle::gateway-model-http-call (model method path body)
                                (error "gateway unavailable"))
      (nle::slash-settings-op model)
      (is (search "gateway unavailable" (nle::settings-sheet-failed model.dialog)))
      (is (sheet-row model "gateway unavailable") "the refusal is said in its own words")
      (press model :escape)
      (is (null model.dialog))))
  (is (equal "restart Discord to apply" (nle::settings-apply-text (nlk:json-object "applies" "cell" "cell" "discord"))))
  (is (equal "restart Chrome to apply" (nle::settings-apply-text (nlk:json-object "applies" "cell" "cell" "nodecode-chrome"))) "a cell is named as its section is")
  (is (equal "restart Nodecode to apply" (nle::settings-apply-text (nlk:json-object "applies" "restart"))))
  (is (equal "applies now" (nle::settings-apply-text (nlk:json-object "applies" "now")))))

(deftest settings-sections-and-a-search-over-every-setting ()
  (with-quick-settings (model port config)
    (nle::slash-settings-op model)
    (let ((settings model.dialog))
      (is (eq :rail (nle::settings-sheet-focus settings)) "the sheet opens on its sections")
      (is (sheet-row model "SYSTEM") "the core's sections under the group they are for")
      (press model :down)
      (press model :right)
      (is (eq :pane (nle::settings-sheet-focus settings)) "Right opens the chosen section")
      (press model :escape)
      (is (eq :rail (nle::settings-sheet-focus settings)) "Esc goes back to the sections")
      (dialog-keys model #\l #\o #\u)
      (is (equal "Loud" (nle::setting-label (sheet-setting model))) "typing finds a setting in any section")
      (is (sheet-row model "match"))
      (press model :left)
      (is (null (saved-setting :any "lane" "loud")) "Left changes no result")
      (press model :right)
      (is (eq t (saved-setting :any "lane" "loud")) "a result changes where it stands")
      (press model :escape)
      (is (equal "" (nle::settings-sheet-query settings)) "Esc clears the query first")
      (is (eq :rail (nle::settings-sheet-focus settings)) "and goes back where it was")
      (dialog-keys model #\m #\o #\d #\e)
      (is (equal "Mode" (nle::setting-label (sheet-setting model))) "a setting named the query comes before Model")
      (press model :escape)
      (dialog-keys model #\l #\a #\n #\e)
      (is (<= 6 (length (nle::settings-results settings))) "a section's name brings every setting of it")
      (dialog-keys model #\z #\z #\z)
      (is (null (sheet-setting model)))
      (is (sheet-row model "Nothing matches"))
      (dialog-keys model :enter :right #\Space)
      (is (not (nth-value 1 (saved-setting :any "lane" "mode"))) "a query with no result acts on nothing")
      (press model :escape)
      (press model :escape)
      (is (null model.dialog) "Esc on the sections closes"))))

(deftest settings-values-line-up-and-the-chosen-setting-explains-itself ()
  (with-quick-settings (model port config)
    (nlk:define-section ("nl-settings" "display")
      ("require_mention" :boolean :default :false :doc "Only answer messages addressed to this bot.")
      ("stream" :boolean :default t :doc "Show the reply as it is written.")
      ("turn_budget_minutes" :integer :default 10 :min 0 :doc "Stop tool calls after this many minutes."))
    (nle::slash-settings-op model)
    (select-setting model "nl-settings.display" "Turn time limit")
    (dialog-keys model :up :up)
    (let ((rows (sheet-rows model)))
      (is (equal '("Require a mention" "Stream replies" "Turn time limit")
                 (mapcar #'nle::setting-label (nle::settings-section-rows
                                               (nth (nle::settings-sheet-section-at model.dialog)
                                                    (nle::settings-sheet-sections model.dialog))))))
      (is (row-carrying "Only answer messages" rows) "the chosen setting explains itself")
      (is (not (row-carrying "Show the reply" rows)) "the others do not dump descriptions")
      (is (not (row-carrying "Stop tool calls" rows)))
      (let ((on (row-carrying "Stream replies" rows))
            (limit (row-carrying "Turn time limit" rows)))
        (is (= (+ (search "On" on) 2) (+ (search "10 min" limit) 6)) "values stand flush against one edge: no zig-zag")))
    (press model :down)
    (is (sheet-row model "Show the reply") "the description follows the choice")
    (is (not (sheet-row model "Only answer messages")))))

