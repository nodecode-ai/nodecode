(deftest settings-edit-text-ids-and-secrets-and-run-the-check ()
  ;; What a cell's section declares beyond a switch is set here too, through
  ;; the same route: a secret pasted is kept in a 0600 file the section names
  ;; and never shown, an inline secret reads only Set, ids come from the
  ;; platform's own list, and the section's check runs in the organism.
  (with-quick-settings (model port config)
    (nle::slash-settings-op model)
    (let ((settings (select-setting model "nl-settings.lane" "Token")))
      (flet ((text-of (label)
               (let ((setting (find label (nle::settings-section-rows
                                           (nth (nle::settings-sheet-section-at settings)
                                                (nle::settings-sheet-sections settings)))
                                    :key #'nle::setting-label :test #'equal)))
                 (and setting (nle::setting-text setting)))))
        (is (equal "Not set" (text-of "Token")) "the paste row, while nothing names the secret")
        (is (equal "Set" (text-of "Api key")) "a secret already there says only Set")
        (press model :enter)
        (dialog-keys model #\z #\q #\9)
        (is (sheet-row model "***") "the paste is masked")
        (is (not (sheet-row model "zq9")))
        (press model :enter)
        (is (null (nle::settings-sheet-edit settings)) "Enter leaves the field")
        (is-present (file (saved-setting :string "lane" "token_file")) "token_file names the kept secret"
          (is (equal (format nil "zq9~%") (uiop:read-file-string file)))
          #-win32
          (is (= #o600 (logand #o777 (sb-posix:stat-mode (sb-posix:stat file))))))
        (is (not (sheet-row model "zq9")) "never drawn")
        (is (null (text-of "Token")) "the file names it now")
        ;; an inline secret: typed masked, said only as Set
        (select-setting model "nl-settings.lane" "Api key")
        (dialog-keys model :enter #\k #\1 :enter)
        (is (equal "k1" (saved-setting :string "lane" "api_key")))
        (is (equal "Set" (text-of "Api key")))
        ;; ids from the platform: a checklist marked as the config has them
        (select-setting model "nl-settings.lane" "Rooms")
        (press model :enter)
        (is (sheet-row model "[x] #general"))
        (is (sheet-row model "[ ] #random"))
        (dialog-keys model :down #\Space :enter)
        (is (null (nle::settings-sheet-ids settings)) "Enter writes the marks and the row comes back")
        (is (equal '("r1" "r2") (nlk:config-string-list (saved-setting :object "lane") "rooms")))
        ;; a probe the platform refuses says why, under the row
        (select-setting model "nl-settings.shut" "Rooms")
        (press model :enter)
        (is (sheet-row model "unauthorized (401)"))
        ;; the section's check, where the organism runs it
        (select-setting model "nl-settings.lane" "Check")
        (press model :enter)
        (is (sheet-row model "token: ok, 2 rooms"))
        (is (search "the operator's own note" (nlk:read-text config)) "comments kept")))))

(deftest settings-general-lands-through-the-shells-own-writers ()
  (with-quick-settings (model port config)
    (with-temp-file (nle::*theme-selection-path* :type "theme")
      (nlk:bind ((nle::*palette* nle::*palette*))
        (nle::slash-settings-op model)
        (select-setting model "general" "Transcript view")
        (press model :right)
        (is (eq :developer model.tool-detail) "the view switches as /details switches it")
        (is (sheet-row model "[Developer]"))
        (select-setting model "general" "Theme")
        (let ((before (nle::setting-value (sheet-setting model))))
          (press model :right)
          (is (nle::saved-theme-selection) "the theme saves as /themes saves it")
          (is (not (equal before (nle::saved-theme-selection))))
          (is (equal (nle::saved-theme-selection) (nle::setting-value (sheet-setting model))) "the row says the theme now in use"))
        (is (equal '("Theme" "Transcript view" "Reset to defaults")
                   (mapcar #'nle::setting-label (nle::settings-section-rows (first (nle::settings-sheet-sections model.dialog))))) "General is how the shell looks")
        (select-setting model "models" "Default model")
        (let ((landed nil))
          (with-stubbed-fdefinition (nle::open-models-picker (model &key lands then provider)
                                      (setf landed lands)
                                      (values nil nil))
            (press model :enter)
            (is (eq :default landed) "the default model opens the picker that moves the default alone"))
          (is (null model.dialog) "in the sheet's place"))))))

