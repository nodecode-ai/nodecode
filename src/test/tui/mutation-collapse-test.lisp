;;;; mutation-collapse-test.lisp --- completed process summaries own successful mutations.
(in-package #:nodecode.test)

(defun mutation-collapse-state (&key (commands 2) (mutations 3) (turn-id "mutate-turn"))
  (let ((state (nle::ingest-message-fact nil "user" "rewrite" :turn-id turn-id)))
    (dotimes (i (max commands mutations))
      (when (< i commands)
        (setf state (nle::ingest-tool-call-fact state (format nil "call-~d" i) "eval" "{}" :turn-id turn-id)
              state (nle::ingest-tool-result-fact state (format nil "call-~d" i) "eval" "result" :turn-id turn-id)))
      (when (< i mutations)
        (setf state (mutation-collapse-notice state i turn-id))))
    state))

(defun mutation-collapse-notice (state index turn-id &key error-p)
  (nle::ingest-system-notice state (format nil "receipt-~d" index) :turn-id turn-id :error-p error-p
    :retention :live-only :metadata (nlk:json-object "summary"
      (nlk:json-object "name" "Mutate" "comment" (format nil "rewrite-~d" index)))))

(defun mutation-collapse-lines (state &optional start)
  (mapcan (lambda (block) (copy-list (nle::display-block-plain-lines block)))
          (nle:project-state state :width 100 :start start)))

(deftest standard-completed-process-counts-and-folds-all-successful-mutations ()
  (let* ((nle::*tool-detail* :standard)
         (state (mutation-collapse-state)))
    ;; Standard's live run names its newest round, a receipt by its comment.
    (is (rows-carry-p (activity-label-text "rewrite-2" "Mutate · rewrite-2") (mutation-collapse-lines state)) "live mutations stay visible")
    (setf state (nle::ingest-message-fact state "assistant" "answer" :turn-id "mutate-turn")
          state (nle::ingest-turn-terminal state "completed" :turn-id "mutate-turn"))
    (dotimes (pass 2)
      (let* ((blocks (nle:project-state state :width 100))
             (group (nle::display-block-row (second blocks)))
             (lines (mutation-collapse-lines state)))
        (is (= 3 (length blocks)) "prompt, one work summary and answer")
        (is (rows-carry-p "Ran 2 commands, Mutated 3 times" lines))
        (is (not (rows-carry-p (activity-label-text "Mutate " "Mutate ·") lines)))
        (is (rows-carry-p "answer" lines))
        (is (equal '(:tool-call :system-notice :tool-call :system-notice :system-notice)
                   (mapcar #'nle::transcript-row-kind (nle::tool-group-members group))))
        (let ((nle::*expanded-tool-call* (nle::tool-group-key group)))
          (let ((open (mutation-collapse-lines state)))
            (is (rows-carry-p (activity-label-text "rewrite-2" "Mutate · rewrite-2") open))
            (is (< (row-index-of "rewrite-0" open :required t) (row-index-of "rewrite-1" open :required t)
                   (row-index-of "rewrite-2" open :required t)))))
        (let ((nle::*expanded-tool-call* (car (last (nle::tool-group-members group)))))
          (is (rows-carry-p "receipt-2" (mutation-collapse-lines state)) "opening a mutation receipt also opens its parent"))))))

(deftest mutation-count-wording-keeps-zero-singular-and-developer-policy ()
  (dolist (counts '((1 0 "Ran 1 command") (1 1 "Ran 1 command, Mutated 1 time")
                    (0 2 "Ran 0 commands, Mutated 2 times")))
    (destructuring-bind (commands mutations title) counts
      (let ((state (mutation-collapse-state :commands commands :mutations mutations)))
        (setf state (nle::ingest-turn-terminal state "cancelled" :turn-id "mutate-turn"))
        (let ((nle::*tool-detail* :standard))
          (is (rows-carry-p title (mutation-collapse-lines state)))))))
  (let* ((state (mutation-collapse-state)) (nle::*tool-detail* :developer))
    (setf state (nle::ingest-turn-terminal state "completed" :turn-id "mutate-turn"))
    (is (= 3 (count-if (lambda (line) (search (activity-label-text "Mutate " "Mutate ·") line)) (mutation-collapse-lines state))))))

(deftest completed-process-never-hides-diagnostics-or-counts-another-turns-mutations ()
  (let* ((nle::*tool-detail* :standard)
         (state (mutation-collapse-state :commands 1 :mutations 1)))
    (setf state (mutation-collapse-notice state 9 "mutate-turn" :error-p t)
          state (nle::ingest-system-notice state "ordinary notice" :turn-id "mutate-turn")
          state (nle::ingest-tool-call-fact state "last-call" "eval" "{}" :turn-id "mutate-turn")
          state (nle::ingest-tool-result-fact state "last-call" "eval" "ok" :turn-id "mutate-turn")
          state (nle::ingest-turn-terminal state "failed" :turn-id "mutate-turn" :detail "visible failure")
          state (mutation-collapse-notice state 10 "other-turn")
          state (mutation-collapse-notice state 11 nil))
    (let ((lines (mutation-collapse-lines state)))
      ;; Standard folds another turn's receipt into that turn's own run, and
      ;; a receipt no turn owns stands alone under its label.
      (is-table (in) (rows-carry-p in lines) ("Ran 1 command, Mutated 1 time") ("receipt-9")
        ("ordinary notice") ("visible failure")
        ((activity-label-text "Ran 0 commands, Mutated 1 time" "Mutate · rewrite-10"))
        ((activity-label-text "rewrite-10" "Mutate · rewrite-10"))
        ((activity-label-text "Mutate   rewrite-11" "Mutate · rewrite-11"))))))

(deftest completed-mutation-summary-mouse-reopens-members-and-the-receipt ()
  (with-frame-model (model 100 40 :session-id "mutation-click-summary" :tool-detail :standard
                     :state (nle::ingest-turn-terminal (mutation-collapse-state) "completed" :turn-id "mutate-turn"))
    (click-at model 12 (frame-row-carrying model "Ran 2 commands, Mutated 3 times"))
    (is (rows-carry-p (activity-label-text "rewrite-2" "Mutate · rewrite-2") (nle::compose-frame model)))
    (click-at model 12 (frame-row-carrying model (activity-label-text "rewrite-2" "Mutate · rewrite-2")))
    (is (rows-carry-p "receipt-2" (nle::compose-frame model)))
    (click-at model 12 (frame-row-carrying model "Ran 2 commands, Mutated 3 times"))
    (is (not (rows-carry-p (activity-label-text "rewrite-" "Mutate ·") (nle::compose-frame model))))))

(deftest loaded-frame-carries-a-typed-explicit-turn-id ()
  (let ((seen nil)
        (nle::*current-durable-turn* (nlk::%make-durable-turn :session-id "s" :turn-id "explicit-turn"
                                      :command-id "c" :definition-revision "base")))
    (with-stubbed-fdefinition (nle::broadcast-organism (kind payload)
                               (setf seen payload) (values t 1))
      (nle::announce-loaded #p"/tree/probe.lisp" '(("DEFUN" . "probe")))
      (is (equal "explicit-turn" (nlk:json-value seen :string "turn_id")))
      (let ((nle::*current-durable-turn* nil))
        (nle::announce-loaded #p"/tree/probe.lisp" '(("DEFUN" . "probe")))
        (is (null (nlk:json-value seen :any "turn_id"))))))
  (dolist (bad '(7 ""))
    (is (signals-error nlk:protocol-error
          (nlk:decode-sync-message (nlk:encode-unsequenced-frame "organism.loaded"
             (nlk:json-object "path" "/tree/x.lisp" "definitions" #() "turn_id" bad)))))))

(deftest mutation-turn-attribution-reaches-the-attached-peer-unsequenced ()
  (with-gateway-session (port "mutation-owner-peer")
    (let* ((frames (frames-while (ws port :subscribe '("mutation-owner-peer") :pid 424245)
                     (await (:tries 50) (nle::attached-shells))
                     (let ((nle::*current-durable-turn*
                             (nlk::%make-durable-turn :session-id "mutation-owner-peer" :turn-id "explicit-turn"
                                :command-id "c" :definition-revision "base")))
                       (nlk:source-loaded #p"/tree/probe.lisp" '(("DEFUN" . "probe"))))))
           (frame (find-frame frames "organism.loaded")))
      (is frame)
      (is-shape frame ((:string "payload" "turn_id") "explicit-turn")
        ((:string "payload" "session_id") "mutation-owner-peer") ("sequence" eql 0)))))

(deftest mutation-load-consumer-uses-event-turn-not-whichever-turn-is-active ()
  (with-source-tree (root)
    (let* ((model (detached-shell "mutation-session"))
           (path (merge-pathnames "mutation-owner.lisp" root)))
      (write-temp-file path (format nil "(in-package #:nodecode.evolved)~%(defun mutation-owner-probe () :live)~%"))
      (setf (nle::gateway-model-active-turn-id model) "different-active-turn")
      (with-stubbed-fdefinition (nle::render-state (m) nil)
        (feed-wire model (nlk:encode-unsequenced-frame "organism.loaded"
          (nlk:json-object "path" (namestring path) "definitions"
            (vector (nlk:json-object "operator" "DEFUN" "label" "mutation-owner-probe"))
            "session_id" "mutation-session" "turn_id" "explicit-turn" "comment" "rewrite")))
        (let ((row (car (last (nle::transcript-rows (nle::chat-model-state model))))))
          (is (equal "explicit-turn" (nle::transcript-row-turn-id row)))
          (is (equal (namestring path) (nlk:json-value (nle::row-notice-summary row) :string "path")))
          (is (eq :live-only (nle::transcript-row-retention row))))))))

(deftest completed-work-summary-hover-changes-only-its-title-foreground ()
  (dolist (transparent '(t nil))
    (dolist (nle::*color-profile* '(:truecolor :ansi256 :ansi :none))
      (let* ((nle::*palette* (theme-palette "Tungstene" :user
                              (if transparent nil "{\"themes\":[{\"name\":\"Tungstene\",\"transparent-background\":false}]}")))
             (nle::*tool-detail* :standard)
             (nle::*expanded-tool-call* nil)
             (nle::*hover-row* nil)
             (state (nle::ingest-turn-terminal (mutation-collapse-state) "completed" :turn-id "mutate-turn"))
             (group (nle::display-block-row (second (nle:project-state state :width 100))))
             (title "Ran 2 commands, Mutated 3 times"))
        (is (equal '(232 78 14) (nle::visual-style-fg (nle::style-for-tone :disclosure-hover))) "Tungstene owns the deep orange accent #e84e0e")
        (dolist (open '(nil t))
          (let* ((nle::*expanded-tool-call* (and open (nle::tool-group-key group)))
                 (quiet (nle::tool-group-display-block group 100))
                 (nle::*hover-row* group)
                 (hovered (nle::tool-group-display-block group 100))
                 (again (nle::tool-group-display-block group 100)))
            (is (equal (nle::display-block-plain-lines quiet) (nle::display-block-plain-lines hovered)))
            (let ((accent (nle::make-lline :text title :tone :disclosure-hover :gutter-tone :muted
                                           :role (if open :disclosure-open :disclosure))))
              (is (equal (first (nle::display-block-lines hovered)) (first (nle::lline-render accent 100))) "hover paints the title accent without adding any background"))
            (is (equal (rest (nle::display-block-lines quiet)) (rest (nle::display-block-lines hovered))) "open member paint is unchanged")
            (is (equal (nle::display-block-lines hovered) (nle::display-block-lines again)))
            (is (eq :muted (nle::lline-tone (nle::tool-group-line group))) "hover never mutates the shared title")
            (let ((nle::*hover-row* nil))
              (is (equal (nle::display-block-lines quiet)
                         (nle::display-block-lines (nle::tool-group-display-block group 100))) "leaving hover restores quiet paint"))))))))
(deftest a-work-summary-says-it-opens-in-the-gutter ()
  ;; Without this, the at-rest summary would be a plain muted line, and only
  ;; hover would tell it opened; the gutter rail shows ▸ shut and ▾ open.
  (let* ((nle::*tool-detail* :standard)
         (nle::*expanded-tool-call* nil)
         (nle::*hover-row* nil)
         (state (nle::ingest-turn-terminal (mutation-collapse-state) "completed" :turn-id "mutate-turn"))
         (group (nle::display-block-row (second (nle:project-state state :width 100)))))
    (is (eql 0 (search " ▸ Ran 2 commands" (first (nle::display-block-plain-lines (nle::tool-group-display-block group 100))))))
    (let ((nle::*expanded-tool-call* (nle::tool-group-key group)))
      (is (eql 0 (search " ▾ Ran 2 commands" (first (nle::display-block-plain-lines (nle::tool-group-display-block group 100)))))))))

(defun expanded-process-model (model)
  "A completed long work trail, opened in the Standard viewport."
  (setf (nle::chat-model-tool-detail model) :standard
        (nle::chat-model-state model)
        (nle::ingest-turn-terminal (mutation-collapse-state :commands 30) "completed" :turn-id "mutate-turn"))
  (nle::render-state model)
  (click-at model 12 (frame-row-carrying model "Ran 30 commands, Mutated 3 times"))
  (nle::scroll-transcript model :home)
  model)

(deftest expanded-process-header-pins-with-paint-pointer-and-copy-parity ()
  (with-frame-model (model 100 24 :session-id "process-pin-scroll")
    (expanded-process-model model)
    (let* ((window (nle::chat-model-band model))
           (header (row-index-of "Ran 30 commands, Mutated 3 times" (nle::chat-model-line-plain model) :required t))
           (group (aref (nle::chat-model-line-rows model) header)))
      (dolist (offset '(8 20 40))
        (setf (nle::band-window-offset window) offset)
        (let* ((rows (band-row-texts model))
               (title (position "▾ Ran 30 commands, Mutated 3 times" rows :test #'equal)))
          (is title "the collapse header stays visible deep inside the expanded members")
          (is (member "rewrite" rows :test #'equal) "the user prompt remains pinned above it")
          (is (= 1 (count "▾ Ran 30 commands, Mutated 3 times" rows :test #'equal)) "one title, never an inline duplicate, its open mark in the gutter")
          (when title
            (is (= header (nle::band-window-row-index window title)))
            (is (eq group (nle::transcript-item-at-line model (nle::band-window-row-index window title))))
            (let* ((painted (nle::band-window-visible window))
                   (frame-row (frame-row-carrying model "Ran 30 commands, Mutated 3 times")))
              (is (search "Ran 30 commands, Mutated 3 times" (nth title painted)))
              (setf model.selection (cons (cons (1- frame-row) 0) (cons (1- frame-row) 89)))
              (is (search "Ran 30 commands, Mutated 3 times" (nle::frame-selection-text model)))
              (setf (nle::chat-model-selection model) nil))))
        (is (<= (length (nle::band-window-visible window)) (nle::band-window-height window))))
      (click-at model 12 (frame-row-carrying model "Ran 30 commands, Mutated 3 times"))
      (is (null (nle::chat-model-expanded-tool-call model)) "clicking the pinned header collapses without scrolling up")
      (is (not (rows-carry-p "receipt-2" (coerce (nle::chat-model-line-plain model) 'list))) "the long members are folded again"))))

(deftest expanded-process-header-unpins-outside-its-members ()
  (with-frame-model (model 100 24 :session-id "process-pin-boundary")
    (expanded-process-model model)
    (paint-model model
      (nle::ingest-message-fact "assistant" (numbered-body "after-work" 50) :turn-id "mutate-turn"))
    (let* ((window model.band) (after (row-index-of "after-work 20" model.line-plain :required t)))
      (setf (nle::band-window-offset window) after)
      (is (not (member "▾ Ran 30 commands, Mutated 3 times" (band-row-texts model) :test #'equal)) "the disclosure does not outlive its work block")
      (is (member "rewrite" (band-row-texts model) :test #'equal)))))

(deftest expanded-process-pin-keeps-wrapped-tiny-and-promptless-geometry ()
  (let* ((group (nle::make-tool-group '(:process "p")))
         (member (nle::make-transcript-row :kind :tool-call :tool-call-id "member"))
         (lines (loop for i below 14 collect (format nil "line ~d" i)))
         (window (nle::make-band-window :height 6)))
    (setf (nle::tool-group-members group) (list member)
          (nle::row-groups member) group)
    (let* ((refs (append (list nil group group) (make-list 8 :initial-element member) (list nil nil nil)))
           (spans (nle::refs-disclosure-spans refs "member")))
      (is (equal '((1 11 2)) spans) "opening a member pins its two wrapped parent title rows")
      (is (null (nle::refs-disclosure-spans refs nil)) "closed groups reserve no rows")
      (setf (nle::band-disclosure-spans lines) spans)
      (nle::band-window-set-lines window lines)
      (dolist (height '(1 2 3 6))
        (setf (nle::band-window-height window) height
              (nle::band-window-offset window) 4)
        (is (= 1 (nle::band-window-row-index window 0)) "even a tiny promptless band keeps the collapse control")
        (is (<= (length (nle::band-window-visible window)) height))
        (is (equal (nle::band-window-pieces window) (nle::band-window-pieces window)) "memo/idle reads preserve exactly the same geometry"))
      (setf (nle::band-window-height window) 3
            (nle::band-window-offset window) 11)
      (is (= 11 (nle::band-window-row-index window 0)) "a new block drops the old disclosure")
      (setf (nle::band-window-offset window) 1)
      (is (equal '((1 3)) (nle::band-window-pieces window)) "the inline title is not duplicated before scrolling"))))


(defun file-mutation-notice (state path &key (turn-id "file-turn") error-p)
  (nle::ingest-system-notice state (format nil "receipt for ~a" path)
    :turn-id turn-id :error-p error-p :retention :live-only
    :metadata (nlk:json-object "summary"
                (nlk:json-object "name" "Mutate" "path" path "comment" "change"))))

(defun file-mutation-state (paths &key command)
  "The `edit files' prompt of file-turn, a call after it when COMMAND, then a
Mutate receipt for each of PATHS."
  (let ((state (nle::ingest-message-fact nil "user" "edit files" :turn-id "file-turn")))
    (when command
      (setf state (nle::ingest-tool-call-fact state "c" "eval" "{}" :turn-id "file-turn")))
    (reduce #'file-mutation-notice paths :initial-value state)))

(deftest multi-file-mutation-parent-shared-by-both-viewports ()
  ;; Developer gathers the receipts under one Mutate parent; Standard folds
  ;; them into the turn's run, whose standing round lists each file.
  (let* ((nle::*tool-detail* :standard)
         (state (file-mutation-state '("src/alpha.lisp" "src/βeta.lisp"))))
    (dotimes (pass 2)
      (let* ((blocks (nle:project-state state :width 100))
             (group (nle::display-block-row (second blocks)))
             (lines (mutation-collapse-lines state)))
        (is (= 2 (length blocks)) "prompt and the turn's run, including memo hits")
        (is (and (nle::tool-group-p group) (eq :process (first (nle::tool-group-key group)))))
        (is (rows-carry-p "Ran 0 commands, Mutated 2 times" lines))
        (is (not (rows-carry-p "Mutate · 2 files" lines)))
        (is (< (row-index-of "change · src/alpha.lisp" lines :required t)
               (row-index-of "change · src/βeta.lisp" lines :required t)))
        (is (not (rows-carry-p "receipt for" lines))))))
  (dolist (nle::*tool-detail* '(:developer))
    (let ((state (file-mutation-state '("src/alpha.lisp" "src/βeta.lisp"))))
      (dotimes (pass 2)
        (let* ((blocks (nle:project-state state :width 100))
               (group (nle::display-block-row (second blocks))))
          (is (= 2 (length blocks)) "prompt and one mutation parent, including memo hits")
          (is (nle::tool-group-p group))
          (is (rows-carry-p (activity-label-text "Mutate 2 files" "Mutate · 2 files") (mutation-collapse-lines state)))
          (is (not (rows-carry-p "alpha.lisp" (mutation-collapse-lines state))))
          (when (nle::tool-group-p group)
            (is (eq :live-only (nle::display-block-retention (second blocks))))
            (let ((nle::*expanded-tool-call* (nle::tool-group-key group)))
              (let ((lines (mutation-collapse-lines state)))
                (is (< (row-index-of "alpha.lisp" lines :required t)
                       (row-index-of "βeta.lisp" lines :required t)))
                (is (not (rows-carry-p "receipt for" lines)))))
            (let ((nle::*expanded-tool-call* (second (nle::tool-group-members group))))
              (is (rows-carry-p "receipt for src/βeta.lisp" (mutation-collapse-lines state))))))))))

(deftest mutation-file-groups-respect-turn-command-error-and-single-file-boundaries ()
  (dolist (nle::*tool-detail* '(:standard :developer))
    (dolist (boundary '(:turn :command :error :same-file))
      (let* ((state (file-mutation-notice nil "a.lisp"))
             (state (case boundary
                      (:command (nle::ingest-tool-call-fact state "c" "eval" "{}" :turn-id "file-turn"))
                      (:error (file-mutation-notice state "broken.lisp" :error-p t))
                      (t state)))
             (state (file-mutation-notice state (if (eq boundary :same-file) "a.lisp" "b.lisp")
                      :turn-id (if (eq boundary :turn) "other-turn" "file-turn")))
             (lines (mutation-collapse-lines state)))
        (is (not (rows-carry-p (activity-label-text "Mutate 2 files" "Mutate · 2 files") lines)))
        ;; Standard folds the receipts into the turn's run, each a line naming
        ;; its comment and file.
        (is (rows-carry-p (activity-label-text "change · " "Mutate · change") lines))
        (when (eq boundary :error) (is (rows-carry-p "receipt for broken.lisp" lines)))))))

(deftest multi-file-parent-real-click-opens-files-receipt-and-recollapses ()
  ;; Standard's live run keeps its standing round listed while shut, so
  ;; closing it takes the opened receipt away and leaves the files' lines.
  (dolist (mode '(:standard :developer))
    (with-frame-model (model 100 40 :session-id "file-mutation-click" :tool-detail mode
                       :state (file-mutation-state '("src/alpha.lisp" "src/βeta.lisp")))
      (let ((title (activity-label-text "Ran 0 commands, Mutated 2 times" "Mutate · 2 files" mode)))
        (click-at model 12 (frame-row-carrying model title))
        (is (rows-carry-p (format nil "▾ ~a" title) (nle::compose-frame model)))
        (is (rows-carry-p "src/alpha.lisp" (nle::compose-frame model)))
        (click-at model 12 (frame-row-carrying model "src/βeta.lisp"))
        (is (rows-carry-p "receipt for src/βeta.lisp" (nle::compose-frame model)))
        (click-at model 12 (frame-row-carrying model title))
        (is (rows-carry-p (format nil "▸ ~a" title) (nle::compose-frame model)))
        (is (not (rows-carry-p "receipt for" (nle::compose-frame model))))
        (is (eq (eq mode :standard) (rows-carry-p "src/alpha.lisp" (nle::compose-frame model))))))))

(deftest completed-standard-process-lists-each-file-receipt-with-owner-parity ()
  ;; Standard lists a run's receipts a line each, comment and file, with no
  ;; Mutate parent between them and the run.
  (let* ((nle::*tool-detail* :standard)
         (state (nle::ingest-turn-terminal
                  (file-mutation-state '("src/alpha.lisp" "src/βeta.lisp") :command t)
                  "completed" :turn-id "file-turn"))
         (process (nle::display-block-row (second (nle:project-state state :width 100)))))
    (is (rows-carry-p "Ran 1 command, Mutated 2 times" (mutation-collapse-lines state)))
    (is (not (rows-carry-p "src/alpha.lisp" (mutation-collapse-lines state))) "a finished run stands shut")
    (let* ((nle::*expanded-tool-call* (nle::tool-group-key process))
           (block (second (nle:project-state state :width 100)))
           (lines (nle::display-block-plain-lines block)))
      (is (< (row-index-of "change · src/alpha.lisp" lines :required t)
             (row-index-of "change · src/βeta.lisp" lines :required t)))
      (is (not (rows-carry-p "Mutate · 2 files" lines)))
      (is (notany (lambda (ref) (and (nle::tool-group-p ref) (not (eq ref process))))
                  (nle::display-block-refs block)) "no group nests inside the run"))
    (let ((nle::*expanded-tool-call* (third (nle::tool-group-members process))))
      (is (eq t (nle::tool-group-open-p process)) "opening a receipt opens its run")
      (is (rows-carry-p "receipt for src/βeta.lisp" (mutation-collapse-lines state)))
      (let ((spans (nle::refs-disclosure-spans
                     (nle::display-block-refs (second (nle:project-state state :width 100)))
                     nle::*expanded-tool-call*)))
        (is (= 1 (length spans)) "the opened receipt stays inside the run's one span")))))


(deftest mutation-tail-projection-keeps-every-affected-file-in-one-group ()
  (dolist (nle::*tool-detail* '(:standard :developer))
    (let ((state (file-mutation-state (loop for i below 40 collect (format nil "file-~d.lisp" i)))))
      (let ((first (second (nle::transcript-rows state))))
        (setf state (nle::ingest-message-fact state "assistant" "answer" :turn-id "file-turn"))
        (let ((quota (1+ (length (nle::display-block-lines
                                  (nle::row-display-block (car (last (nle::transcript-rows state))) :width 100))))))
          (is (eq first (nle::tail-projection-start state 100 quota)) "a bounded tail cannot lose early affected files"))
        (let ((nle::*expanded-tool-call* (list :mutation first)))
          (let ((lines (mutation-collapse-lines state first)))
            (is (rows-carry-p "file-0.lisp" lines))
            (is (rows-carry-p "file-39.lisp" lines))))))))

(deftest mutation-parent-collapse-keeps-full-and-retained-history-reachable ()
  (dolist (mode '(:standard :developer))
    (dolist (partial '(nil t))
      (dolist (gesture '((mouse-update nlt:make-mouse-wheel-msg 8 8 :direction :up) (press :page-up)
                         (press :home) (click-at 98 4)))
        (with-frame-model (model 100 (if partial 24 90) :session-id "mutation-history")
          (let ((state nil))
            (dotimes (i (if partial 30 3))
              (setf state (exchange state (format nil "Previous mutation turn ~d" i)
                                    "Earlier answer" :turn-id (format nil "before-~d" i))))
            (setf state (nle::ingest-message-fact state "user" "Current mutation" :turn-id "file-turn"))
            (dotimes (i 40) (setf state (file-mutation-notice state (format nil "file-~d.lisp" i))))
            ;; Standard's live run lists its standing round shut or open; the
            ;; run that contracts on a click is a finished one.
            (when (eq mode :standard)
              (setf state (nle::ingest-turn-terminal state "completed" :turn-id "file-turn")))
            (setf (nle::chat-model-tool-detail model) mode (nle::chat-model-state model) state)
            (nle::render-state model)
            (when partial (is (cdr (nle::chat-model-projection-start model))))
            (click-at model 12 (frame-row-carrying model (activity-label-text "Mutated 40 times" "Mutate · 40 files" mode)))
            ;; Find the disclosure after the long child list has contracted.
            (let* ((group (find-if #'nle::tool-group-p (coerce (nle::chat-model-line-rows model) 'list)))
                   (line (position group (nle::chat-model-line-rows model))))
              (setf (nle::chat-model-follow-bottom model) nil
                    (nle::band-window-offset (nle::chat-model-band model))
                    (max 0 (- line nle::+max-pinned-prompt-rows+ 1)))
              (click-at model 12 (frame-row-carrying model (activity-label-text "Mutated 40 times" "Mutate · 40 files" mode))))
            (press model :end)
            (apply (first gesture) model (rest gesture))
            (is (rows-carry-p "Previous mutation turn" (band-row-texts model)) "each upward gesture reaches earlier input after child contraction")
            (press model :home)
            (is (rows-carry-p "Previous mutation turn 0" (band-row-texts model)))))))))


(deftest duplicate-file-mutations-retain-one-visible-disclosure-per-file ()
  ;; Standard's run lists every receipt a line, so a file mutated twice is
  ;; two lines under `Mutated 2 times'; Developer's Mutate parent keeps one per file.
  (let ((nle::*tool-detail* :standard))
    (dolist (paths '(("src/alpha.lisp" "src/alpha.lisp")
                    ("src/alpha.lisp" "src/βeta.lisp" "src/alpha.lisp" "src/βeta.lisp")))
      (let ((state (file-mutation-state paths)))
        (dotimes (pass 2)
          (let* ((blocks (nle:project-state state :width 100))
                 (item (nle::display-block-row (second blocks)))
                 (lines (mutation-collapse-lines state)))
            (is (= 2 (length blocks)) "prompt plus the turn's one run")
            (is (and (nle::tool-group-p item) (= (length paths) (length (nle::tool-group-members item)))))
            (is (rows-carry-p (format nil "Ran 0 commands, Mutated ~d times" (length paths)) lines))
            (dolist (path (remove-duplicates paths :test #'string=))
              (is (= (count path paths :test #'string=)
                     (count-if (lambda (line) (search (format nil "change · ~a" path) line))
                               lines)) "each receipt keeps its own line")))))))
  (dolist (nle::*tool-detail* '(:developer))
    (dolist (paths '(("src/alpha.lisp" "src/alpha.lisp")
                    ("src/alpha.lisp" "src/βeta.lisp" "src/alpha.lisp" "src/βeta.lisp")))
      (let ((state (file-mutation-state paths)))
        (dotimes (pass 2)
          (let* ((blocks (nle:project-state state :width 100))
                 (item (nle::display-block-row (second blocks))))
            (is (= 2 (length blocks)) "deduplication retains prompt plus a visible Mutate disclosure")
            (is (= 1 (count-if (lambda (line) (search (activity-label-text "Mutate " "Mutate ·") line)) (mutation-collapse-lines state))))
            (if (nle::tool-group-p item)
                (let ((nle::*expanded-tool-call* (nle::tool-group-key item)))
                  (is (= 2 (length (nle::tool-group-members item))))
                  (dolist (path '("src/alpha.lisp" "src/βeta.lisp"))
                    (is (= 1 (count-if (lambda (line) (search path line)) (mutation-collapse-lines state))) "each affected file appears once beneath the parent")))
                (progn
                  (is (rows-carry-p (activity-label-text "Mutate change" "Mutate · change") (mutation-collapse-lines state)))
                  (let ((nle::*expanded-tool-call* item))
                    (is (rows-carry-p "receipt for src/alpha.lisp" (mutation-collapse-lines state))) "single-file duplicates keep an openable receipt")))))))))

(deftest duplicate-file-mutations-survive-standard-completion-and-nested-clicks ()
  (with-frame-model (model 100 40 :session-id "duplicate-mutations"
                     :state (nle::ingest-turn-terminal
                            (file-mutation-state '("src/alpha.lisp" "src/βeta.lisp" "src/alpha.lisp"
                                                   "src/βeta.lisp") :command t)
                            "completed" :turn-id "file-turn"))
    ;; The completed Standard trail lists each receipt a line under its run.
    (is (not (rows-carry-p "src/alpha.lisp" (nle::compose-frame model))) "a finished run stands shut")
    (click-at model 12 (frame-row-carrying model "Ran 1 command, Mutated 4 times"))
    (dolist (path '("src/alpha.lisp" "src/βeta.lisp"))
      (is (= 2 (count-if (lambda (line) (search (format nil "change · ~a" path) line)) (nle::compose-frame model))) "each mutation of a file keeps its own line"))
    (click-at model 12 (frame-row-carrying model "src/βeta.lisp"))
    (is (rows-carry-p "receipt for src/βeta.lisp" (nle::compose-frame model)))
    (click-at model 12 (frame-row-carrying model "Ran 1 command, Mutated 4 times"))
    (is (not (rows-carry-p "src/alpha.lisp" (nle::compose-frame model))))
    (is (not (rows-carry-p "receipt for" (nle::compose-frame model))))
    (is (rows-carry-p "▸ Ran 1 command, Mutated 4 times" (nle::compose-frame model)))))

(deftest closed-process-summary-is-its-title-and-opens-one-gap-down ()
  ;; A shut run is its title alone; the block after it brings its own pad, and
  ;; opened, one gap stands between the title and its first member.
  (dolist (width '(40 100))
    (let* ((nle::*tool-detail* :standard)
           (state (nle::ingest-turn-terminal
                   (nle::ingest-message-fact (mutation-collapse-state) "assistant" "answer" :turn-id "mutate-turn")
                   "completed" :turn-id "mutate-turn"))
           (lines (mapcan (lambda (block) (copy-list (nle::display-block-plain-lines block)))
                          (nle:project-state state :width width)))
           (group (nle::display-block-row (second (nle:project-state state :width width))))
           (closed (nle::tool-group-display-block group width))
           (plain (nle::display-block-plain-lines closed)))
      (is (search "Ran 2 commands, Mutated 3 times" (first plain)))
      (is (= 1 (length plain)) "a closed summary is its title alone")
      (let ((title (row-index-of "Ran 2 commands, Mutated 3 times" lines :required t)))
        (is (string= "" (string-trim " " (nth (1+ title) lines))) "following blocks never touch the collapsed title"))
      (is (equal (list group) (nle::display-block-refs closed)) "the title is the summary's one pointer row")
      (is (eq closed (nle::tool-group-display-block group width)) "memo hits keep the gap")
      (let* ((nle::*hover-row* group)
             (hovered (nle::tool-group-display-block group width)))
        (is (equal plain (nle::display-block-plain-lines hovered))))
      (let* ((nle::*expanded-tool-call* (nle::tool-group-key group))
             (open (nle::display-block-plain-lines (nle::tool-group-display-block group width))))
        (is (string= "" (string-trim " " (second open))) "one gap under the opened title")
        (is (notany (lambda (line) (string= "" (string-trim " " line))) (cddr open)) "expanded compact members keep their gapless layout"))
      (dolist (member (nle::tool-group-members group))
        (is (= 1 (length (nle::display-block-plain-lines (nle::row-display-block member :width width)))) "individual tool and Mutate disclosures stay compact")))))

;;; Edits are the durable result's workspace delta, not a guessed verb in Lisp.
(defun workspace-diff (&rest files)
  "A workspace_diff metadata object over FILES, each the keys and values of one file's entry."
  (nlk:json-object "workspace_diff"
    (nlk:json-object "files" (map 'vector (lambda (f) (apply #'nlk:make-json-object f)) files))))

(defun edit-disclosure-state (&key failed (name "eval") (document t) second-file (tail 0))
  "An edit call's state; TAIL more added lines on each file's diff carry it
past the head a shut file shows (*DIFF-PREVIEW-LINES*)."
  (let* ((args (nlk:json-object "form" (format nil ";; Update greeting~%(write-file path text)")))
         (state (nle::ingest-tool-call-fact nil "edit-call" name (shasht:write-json args nil) :turn-id "edit-turn")))
    (nle::ingest-tool-result-fact state "edit-call" name
      (if failed "write succeeded, later operation failed" "receipt-only-do-not-paint")
      :turn-id "edit-turn" :error-p failed
      :metadata (when document
        (apply #'workspace-diff
          (list "path" "greeting.txt" "added" (1+ tail) "removed" 1
            "patch" (format nil "--- a/greeting.txt~%+++ b/greeting.txt~%@@ -1 +1,~d @@~%-hello old~%+hello new~%~{+greeting tail ~d~%~}"
                            (1+ tail) (loop for k from 1 to tail collect k)))
          (when second-file
            (list (list "path" "second-β.txt" "added" (1+ tail) "removed" 0
              "patch" (format nil "--- /dev/null~%+++ b/second-β.txt~%@@ -0,0 +1,~d @@~%+second file tail~%~{+second tail ~d~%~}"
                              (1+ tail) (loop for k from 1 to tail collect k))))))))))

(deftest edit-disclosure-uses-durable-diff-not-the-submitted-verb ()
  (dolist (mode '(:standard :developer))
    (let* ((nle::*tool-detail* mode) (nle::*expanded-tool-call* nil)
           (row (first (nle::transcript-rows (edit-disclosure-state))))
           (closed (nle::row-llines row 100)))
      ;; Shut, a file shows its diff to *DIFF-PREVIEW-LINES*: a short one whole.
      (is (equal (list (activity-label-text "Eval     Update greeting" "Eval · Update greeting") "   +1 -1 greeting.txt" "1 - hello old" "1 + hello new") (mapcar #'nle::lline-text closed)))
      (let ((spans (nle::lline-spans (second closed))))
        (is (subsetp '(:diff-added :diff-removed) (mapcar #'nle::mspan-tone spans)))
        (is (every (lambda (span) (equal '(:diff "edit-call" "greeting.txt") (nle::mspan-link span))) spans)))
      (let* ((nle::*expanded-tool-call* '(:diff "edit-call" "greeting.txt")) (open (nle::row-llines row 100)))
        (is (equal (list (activity-label-text "Eval     Update greeting" "Eval · Update greeting") "   +1 -1 greeting.txt" "1 - hello old" "1 + hello new")
                   (mapcar #'nle::lline-text open)))
        (is (eq :diff-removed-line (nle::lline-fill (third open))))
        (is (eq :diff-added-line (nle::lline-fill (fourth open)))))))
  (let* ((nle::*tool-detail* :standard) (nle::*expanded-tool-call* '(:process "edit-call"))
         (lines (mutation-collapse-lines (edit-disclosure-state :document nil))))
    (is (rows-carry-p "Update greeting" lines))
    (is (not (rows-carry-p "+1" lines)) "a submitted write without a delta counts no lines")))

(deftest edit-disclosure-survives-completed-and-partial-projections ()
  (let* ((nle::*tool-detail* :standard) (state (edit-disclosure-state)))
    (setf state (nle::ingest-turn-terminal state "completed" :turn-id "edit-turn"))
    (let* ((blocks (nle:project-state state :width 100))
           (group (nle::display-block-row (first blocks))) (nle::*expanded-tool-call* group.key))
      (is (rows-carry-p "Update greeting +1 -1" (mutation-collapse-lines state)) "opened, its run lists the call with its lines counted")
      (let ((nle::*expanded-tool-call* '(:diff "edit-call" "greeting.txt")))
        (dolist (start (list nil (first (nle::transcript-rows state))))
          (let ((lines (mutation-collapse-lines state start)))
            (is (rows-carry-p "1 + hello new" lines))
            (is (not (rows-carry-p "receipt-only-do-not-paint" lines)))))))))

(deftest edit-disclosure-failed-write-keeps-diff-first-and-diagnostics ()
  (let* ((nle::*tool-detail* :standard) (nle::*expanded-tool-call* '(:diff "edit-call" "greeting.txt"))
         (row (first (nle::transcript-rows (edit-disclosure-state :failed t))))
         (lines (mapcar #'nle::lline-text (nle::row-llines row 100))))
    (is (search (activity-label-text "Eval     Update greeting" "Eval · Update greeting") (first lines)))
    (is (< (row-index-of "1 + hello new" lines :required t)
           (row-index-of "later operation failed" lines :required t)))
    (is (not (rows-carry-p "(write-file path text)" lines)))))

(deftest edit-disclosure-mouse-opens-direct-diff-and-closes ()
  (with-frame-model (model 100 40 :session-id "edit-disclosure-click" :tool-detail :standard
                     :state (edit-disclosure-state :tail 20))
    (flet ((transcript () (coerce (nle::chat-model-line-plain model) 'list)))
      ;; The live turn's run names its edit and lists the call, the file it
      ;; changed under it with its diff's head: no click to see an edit.
      (is (rows-carry-p "▸ Edited 1 file +21 -1" (nle::compose-frame model)))
      (is (rows-carry-p "Update greeting" (nle::compose-frame model)) "folded, the live run keeps its standing round listed")
      (is (rows-carry-p "1 + hello new" (transcript)) "the diff, not a receipt, stands under the call")
      (is (not (rows-carry-p "greeting tail 15" (transcript))) "past its head, the rest waits for a click")
      (nle::scroll-transcript model :end)
      (let ((y (frame-row-carrying model "+21 -1 greeting.txt")))
        (click-at model (1+ (search "+21 -1" (aref (nle::frame-plain-rows model) (1- y)))) y)
        (is (= y (frame-row-carrying model "+21 -1 greeting.txt")) "opening preserves the clicked file, even near the bottom")
        (is (rows-carry-p "greeting tail 15" (transcript)) "opened, the whole diff"))
      (is (not (rows-carry-p "receipt-only-do-not-paint" (nle::compose-frame model))))
      (let ((y (frame-row-carrying model "+21 -1 greeting.txt")))
        (click-at model (1+ (search "+21 -1" (aref (nle::frame-plain-rows model) (1- y)))) y))
      (is (not (rows-carry-p "greeting tail 15" (transcript))) "closed, its head again")
      (is (rows-carry-p "1 + hello new" (transcript))))))

(deftest edit-disclosure-multifile-binary-and-bounded-documents ()
  (dolist (nle::*tool-detail* '(:standard :developer))
    (let* ((nle::*expanded-tool-call* '(:diff "edit-call" "greeting.txt"))
           (row (first (nle::transcript-rows (edit-disclosure-state))))
           (document (nlk:json-object "files" (vector
                       (nlk:json-object "path" "large.txt" "added" 400 "removed" 350)
                       (nlk:json-object "path" "image.png" "added" 0 "removed" 0 "binary" t))
                                     "truncated" 3)))
      (setf (nle::transcript-row-tool-args row) "{}"
            (nle::transcript-row-metadata row) (nlk:json-object "workspace_diff" document))
      (is (eq t (nle::row-edited-p row)))
      (is (equal (list (activity-label-text "Eval     2 files" "Eval · 2 files") "+400 -350 large.txt" "   +0 -0 image.png (binary)" "... +3 more files")
                 (mapcar #'nle::lline-text (nle::row-llines row 100)))))
    (let ((row (first (nle::transcript-rows (edit-disclosure-state)))))
      (setf (nle::transcript-row-tool-args row) "{}")
      (is (equal (activity-label-text "Eval     greeting.txt" "Eval · greeting.txt") (nle::lline-text (nle::tool-summary-lline row))))
      (setf (nle::transcript-row-metadata row) (nlk:json-object "workspace_diff" (nlk:json-object "files" #())))
      (is (eq nil (nle::row-edited-p row)))
      (setf (nle::transcript-row-kind row) :system-notice)
      (is (eq nil (nle::row-edited-p row))))))

(deftest edit-disclosure-never-folds-into-a-routine-read-group ()
  (let* ((nle::*tool-detail* :developer)
         (row (first (nle::transcript-rows (edit-disclosure-state)))))
    (setf (nle::transcript-row-tool-args row) (eval-args "(help :eval)"))
    (is (not (nle::routine-call-p row)) "captured changes override a routine-looking command")
    (is (equal (activity-label-text "Eval     greeting.txt" "Eval · greeting.txt") (nle::lline-text (nle::tool-summary-lline row))))))

(deftest edit-disclosure-files-toggle-independently-inside-completed-trail ()
  ;; An ended turn's run stays shut, its edit listed with each file's diff
  ;; to its head; a file's header opens the rest of that file alone.
  (with-frame-model (model 120 90 :session-id "edit-files" :tool-detail :standard
                     :state (nle::ingest-turn-terminal (edit-disclosure-state :second-file t :tail 20)
                                                       "completed" :turn-id "edit-turn"))
    (flet ((click (needle)
             (nlk:bind (((x y) (needle-cell needle (nle::compose-frame model))))
               (click-at model x y)))
           (shown (needle) (rows-carry-p needle (coerce (nle::chat-model-line-plain model) 'list))))
      (is (rows-carry-p "▸ Edited 2 files +42 -1" (nle::compose-frame model)) "an ended turn's run stands folded, named for its edits")
      (is (and (shown "hello new") (shown "second file tail")) "both files' heads, unclicked")
      (is (not (or (shown "greeting tail 15") (shown "second tail 15"))))
      (click "+21 -1 greeting.txt")
      (is (shown "greeting tail 15"))
      (is (not (shown "second tail 15")))
      (click "+21 -0 second-β.txt")
      (is (shown "second tail 15"))
      (is (not (shown "greeting tail 15")))
      (click "+21 -0 second-β.txt")
      (is (not (shown "second tail 15")))
      (is (rows-carry-p "+21 -1 greeting.txt" (nle::compose-frame model)) "closing one file keeps every file header")
      (is (rows-carry-p "+21 -0 second-β.txt" (nle::compose-frame model))))))
