;;;; channel-setup-test.lisp --- /gateway setup on the shell: the sheet walked with the keys
;;;; an operator presses, over a fake organism.
;;;; SPDX-License-Identifier: MIT

(in-package #:nodecode.test)

;;; The organism's routes as the sheet calls them, faked: it installs the
;;; cell, keeps the secret, refuses one token at the check and offers two
;;; channels.

(defun setup-fake-object (&rest members)
  (let ((object (make-hash-table :test #'equal)))
    (loop for (key value) on members by #'cddr do (setf (gethash key object) value))
    object))

(defun setup-fake-organism (&key offer &aux (calls '()) installed secret chosen restarted)
  "A control surface for the setup sheet: (values CALL CALLS), CALLS answering every
call made so far, oldest first, as (METHOD PATH BODY-JSON). OFFER, when
given, answers a field's choices probe from the field's name, and the owner
field offers choices too."
  (labels ((field (name type &rest more)
             (apply #'setup-fake-object "name" name "type" type "doc" (format nil "~a doc" name) more))
           (section ()
             (setup-fake-object
              "key" "channels.discord" "path" (vector "channels" "discord")
              "guide" "make an app; copy the token" "check" t
              "needs" (if (and secret chosen) "complete" "still needed: bot token, allowed_channels or allowed_users")
              "secret" (setup-fake-object "noun" "bot token" "env" "bot_token_env" "file" "bot_token_file")
              "fields" (vector (field "bot_token_env" "env")
                               (field "bot_token_file" "path" "set" (and secret t) "essential" (and secret t))
                               (field "allowed_channels" "list" "essential" t "choices" t "set" (and chosen t))
                               (field "allowed_users" "list" "essential" t)
                               (field "owner" "list" "choices" (and offer t))
                               (field "pairing" "boolean" "default" t))))
           (call (method path body)
             (push (list method path (and body (nlk:encode-json-object body))) calls)
             (cond ((equal path "/api/gateway/cells")
                    (when (eq method :post) (setf installed t))
                    (setup-fake-object "text" (and (eq method :post) "nodecode-channel-discord is on")
                                       "cells" (vector (setup-fake-object "name" "nodecode-channel-discord" "on" installed)
                                                       (setup-fake-object "name" "nodecode-channel-kit" "on" t)
                                                       (setup-fake-object "name" "nodecode-channel-telegram" "on" t))))
                   ((equal path "/api/channels")
                    (setup-fake-object "channels" (vector (setup-fake-object "id" "telegram" "state" "running" "connected" t)
                                                          (setup-fake-object "id" "discord" "state" (if restarted "running" "unconfigured")
                                                                             "connected" restarted "detail" "as nodebot"))))
                   ((equal path "/api/channels?op=restart") (setf restarted t) (setup-fake-object "channels" #()))
                   ((equal path "/api/gateway/config")
                    (when (eq method :post)
                      (cond ((gethash "secret" body) (setf secret (gethash "secret" body)))
                            ((equal "allowed_channels" (aref (gethash "path" body) 2))
                             (setf chosen (coerce (gethash "value" body) 'list)))))
                    (setup-fake-object "said" (and (eq method :post) "saved it")
                                       "sections" (if installed (vector (section)) #())))
                   ((equal path "/api/gateway/config/probe")
                    (cond ((and offer (gethash "field" body)) (funcall offer (gethash "field" body)))
                          ((gethash "field" body)
                           (setup-fake-object "choices" (vector (setup-fake-object "id" "111" "label" "#general (Home)")
                                                                (setup-fake-object "id" "222" "label" "#bots (Home)"))))
                          ((equal secret "good-token") (setup-fake-object "text" "token: ok — bot nodebot"))
                          ((equal secret "bad-token") (setup-fake-object "text" "token: unauthorized (401): the token is wrong"))
                          (t (error 'nle::gateway-http-error :status 400 :code "refused"
                                                            :detail "channels.discord is unreadable"))))
                   (t (error "the fake organism has no ~a ~a" method path)))))
    (values #'call (lambda () (reverse calls)))))

(deftest channel-setup-picks-by-number-range-name-or-all ()
  (let ((choices '(("111" . "#general  Home") ("222" . "#bots  Home") ("333" . "#ops  Away") ("444" . "@mods  Home"))))
    (is (equal '("111" "222" "333" "444") (nle::gateway-setup-picks "all" choices)) "all picks every one")
    (is (equal '("111" "222" "333" "444") (nle::gateway-setup-picks " * " choices)))
    (is (equal '("222" "333") (nle::gateway-setup-picks "2-3" choices)) "a range of numbers")
    (is (equal '("111" "333") (nle::gateway-setup-picks "general, #ops" choices)) "names, the # optional")
    (is (equal '("444" "222") (nle::gateway-setup-picks "@mods 2 2" choices)) "each once, in the order named")
    (is (equal '("999" "5") (nle::gateway-setup-picks "999 5" choices)) "an id, or a number past the list, as typed")
    (is (equal '("2") (nle::gateway-setup-picks "2" nil)) "no choices: words as typed")))

(deftest channel-setup-opens-the-shell-from-the-command-line ()
  ;; `nodecode gateway setup [CHANNEL]' is the shell, opened on the sheet.
  (nlk:bind (((serve child _ _ _ setup) (nle::parse-launch-arguments '("gateway" "setup" "discord"))))
    (is (null serve)) (is (null child) "no child: the shell itself")
    (is (equal '(:channel-setup "discord") setup) "the sheet asked for on the first frame"))
  (flet ((plan (&rest words) (multiple-value-list (nle::parse-launch-arguments words))))
    (is (equal '(:channel-setup nil) (sixth (plan "gateway" "setup"))) "no channel: the sheet asks which")
    (is (equal '(:gateway ("setup" "--help")) (second (plan "gateway" "setup" "--help"))) "--help is the verbs' help")
    (is (equal '(:gateway ("status")) (second (plan "gateway" "status"))) "every other gateway verb is the child's"))
  (is (search "gateway setup is a shell's verb" (launch-refusal "serve" "gateway" "setup")))
  (is (search "takes one CHANNEL" (launch-refusal "gateway" "setup" "discord" "slack")))
  (is (search "setup" (nlk:gateway-text "help" :command "nodecode gateway")) "help lists setup")
  (let ((said (handler-case (nlk:gateway-text "setup" :command "/gateway")
                (nlk:gateway-usage-error (refusal) (princ-to-string refusal)))))
    (is (search "`nodecode gateway setup discord' opens it there" said) "a room points at the shell")))

(deftest channel-setup-opens-on-the-first-frame-when-the-launch-asked ()
  (multiple-value-bind (call) (setup-fake-organism)
    (with-frame-model (model 100 35 :session-id "channel-setup-first-frame")
      (setf (nle::chat-model-setup-requested model) '(:channel-setup "discord"))
      (with-stubbed-fdefinition (nle::gateway-model-http-call (model method path body &key raw stream read-timeout)
                                  (funcall call method path (and body (nlk:decode-json body))))
        (nle::open-requested-setup model))
      (is (nle::channel-setup-sheet-p model.dialog) "the sheet, not the setup walk")
      (is (equal "discord" (nle::channel-setup-sheet-channel model.dialog)))
      (is (null (nle::chat-model-setup-requested model)) "asked once")
      (is (sheet-row model "Set up Discord")))))


(defun setup-sheet-offer (asks)
  "Choices for the fake organism: the owner offered with its maker the
default; the channels after two asks that say to wait, ASKS counting them."
  (lambda (field)
    (cond ((equal field "owner")
           (setup-fake-object "choices" (vector (setup-fake-object "id" "77" "label" "peas  made the app")
                                                (setup-fake-object "id" "88" "label" "ada  Home"))
                              "default" (vector "77")))
          ((< (incf (car asks)) 3)
           (setup-fake-object "choices" #() "wait" "nodebot is in no server yet. Add it to one: open https://discord.com/oauth2/authorize?client_id=1"))
          (t (setup-fake-object "choices" (vector (setup-fake-object "id" "111" "label" "#general  Home")
                                                  (setup-fake-object "id" "222" "label" "#bots  Home"))
                                "found" "nodebot is in Home")))))

(deftest channel-setup-sheet-walks-a-channel-step-by-step ()
  (let ((asks (list 0))
        (nle::*channel-setup-poll-seconds* 0))
    (multiple-value-bind (call calls) (setup-fake-organism :offer (setup-sheet-offer asks))
      (with-frame-model (model 100 35 :session-id "channel-setup")
        (nle::open-channel-setup model "discord" :call call)
        (is (nle::channel-setup-sheet-p model.dialog))
        (is (sheet-row model "Set up Discord"))
        (is (sheet-row model "✓" "nodecode-channel-discord is on") "the cell was off: switched on, one line")
        (is (sheet-row model "1" "make an app") "the guide's steps, numbered")
        (nle:update model (nlt:make-paste-msg :text "good-token"))
        (is (sheet-row model "••••") "what is pasted shows as dots")
        (is (notany (lambda (row) (search "good-token" row)) (sheet-rows model)) "never the token")
        (press model :enter)
        (is (sheet-row model "What the token sees"))
        (is (sheet-row model "token: ok"))
        (press model :enter)
        (is (= 3 (car asks)) "asked again until there was something to pick")
        (is (sheet-row model "✓" "nodebot is in Home") "the wait folds into what was found")
        (is (sheet-row model "allowed channels:"))
        (is (sheet-row model "[ ]" "#general"))
        (press model #\a)
        (is (sheet-row model "[x]" "#bots") "a ticks every one")
        (press model :enter)
        (is (sheet-row model "✓" "allowed channels: #general, #bots"))
        (is (sheet-row model "allowed users:") "no choices: a typed line")
        (press model :enter)
        (is (sheet-row model "-" "allowed users: none") "an Enter on nothing keeps it")
        (is (sheet-row model "[x]" "peas" "made the app") "the owner's default comes ticked")
        (press model :enter)
        (is (sheet-row model "✓" "owner: peas"))
        (is (sheet-row model "✓" "discord is connected: as nodebot"))
        (is (notany (lambda (row) (search "What the token sees" row)) (sheet-rows model)) "finished steps stand as one line each")
        (flet ((wrote (json) (member json (funcall calls) :key #'third :test #'equal)))
          (is (wrote "{\"path\":[\"channels\",\"discord\"],\"secret\":\"good-token\"}") "the token kept by reference")
          (is (wrote "{\"path\":[\"channels\",\"discord\",\"allowed_channels\"],\"value\":[\"111\",\"222\"]}") "every channel")
          (is (wrote "{\"path\":[\"channels\",\"discord\",\"owner\"],\"value\":[\"77\"]}") "the owner's default"))
        (press model :enter)
        (is (null model.dialog) "Enter closes a finished setup")))))

(deftest channel-setup-sheet-keeps-a-field-on-esc-and-closes-anywhere-else ()
  (multiple-value-bind (call calls) (setup-fake-organism)
    (with-frame-model (model 100 35 :session-id "channel-setup-esc")
      (nle::open-channel-setup model "discord" :call call)
      (press model :escape)
      (is (null model.dialog) "Esc on the token closes it: what was saved stays")
      (is (notany (lambda (made) (search "secret" (or (third made) ""))) (funcall calls)) "nothing was written"))
    (with-frame-model (model 100 35 :session-id "channel-setup-irc")
      (nle::open-channel-setup model "irc" :call call)
      (is (sheet-row model "No channel irc here; pick one."))
      (is (sheet-row model "Which channel?"))
      (is (sheet-row model "Discord")))))
