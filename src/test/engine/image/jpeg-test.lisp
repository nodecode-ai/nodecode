;;;; jpeg-test.lisp --- JPEG read here, pixel for pixel as libjpeg reads it.
;;;;
;;;; SPDX-License-Identifier: MIT
;;;;
;;;; What is proved here is JPEG-DECODE's contract: each form a JPEG takes --
;;;; baseline at 4:2:0, 4:4:4, 4:2:2, 4:4:0 and 4:1:1, progressive in colour
;;;; and in gray, progressive with restart markers, Adobe CMYK and YCCK, a
;;;; Motion-JPEG frame that carries no Huffman tables, a file cut short --
;;;; decodes to exactly the pixels libjpeg-turbo gives under PIL (each
;;;; fixture written by PIL or ImageMagick and read back by PIL, CMYK as PIL
;;;; turns it into RGB, the pixels kept as their SHA-256); an
;;;; arithmetic-coded JPEG, bytes that open no JPEG and a frame past
;;;; *IMAGE-MAX-PIXELS* are refused as JPEG-MALFORMED, and through
;;;; JPEG-PIXELS as IMAGE-UNFIT; and FIT-IMAGE shrinks a progressive JPEG
;;;; past 2000 px a side with no transcoder on the box.

(in-package #:nodecode.test)

(defparameter *jpeg-fixtures*
  '(    ("baseline-420" 11 7 3 "8ff83cd5a7ef3921696cdff647b39e54bee930ec1746ff93abec5bc526273f42"
     "")
    ("baseline-444" 11 7 3 "5b7a26322fe148c5966bd9d9a105a20230f2f46b17ea2d4220ca6c8c97be6f23"
     "")
    ("baseline-422" 11 7 3 "63dc28186ed1c4650df5905f7c6ac42b71dc730b67e5098045488e439239230e"
     "")
    ("sampled-440" 11 7 3 "00a26668adfb71472033f729d9d12302f0db2b761a7695731c2a182fba5cb4ee"
     "")
    ("sampled-411" 19 5 3 "1af5dcb9557b23cd6b9eeb5af337500e2c4c80f72751f183bec24f7a5bcf1b2b"
     "")
    ("progressive" 13 9 3 "e2e323c54a3d59cdfe7c09c63aca2986ec77347dd842df047501f69c5de2dd20"
     "")
    ("progressive-gray" 9 5 1 "ae4d3a91e6117fc2de554f67dfdfb5daddf917c645fe0fa3336dfb069e2a1a52"
     "")
    ("restarts" 24 16 3 "a48464c8ea6e0fa48de4eedbcc4695af830158155bd553e88923a0fe9517a190"
     "")
    ("cmyk" 6 4 3 "ab2379db43caa42dffdd2969798dff7043d2f79ef89bdd5e5fae471fe4214f89"
     "")
    ("ycck" 6 4 3 "724944b65bd8c3f901eaf881a09a0b7d2eb85632be003be4a5ad920d18cd6239"
     "")
    ("no-huffman-tables" 8 8 3 "2cee80b1c1154fe6f9833e7d6e27b061d400d215844b2973628c1c8cbb41ae3f"
     "")
    ("cut-short" 24 16 3 "7834538f6394bab555abb032bc753d0a826f53b5b789fbe63da7a8ffd4ba3b52"
     "")
    ("wide-progressive" 2400 16 3 "89195b33a860d5294dd20231cd484dbaf26af2a671d7358ba28c96559327d354"
     ""))
  "Each fixture's name, width, height, channels, the SHA-256 of the pixels
PIL decodes it to, and the file as base64.")

(defparameter *arithmetic-jpeg*
  "/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAAMCAgICAgMCAgIDAwMDBAYEBAQEBAgGBgUGCQgKCgkICQkKDA8MCgsOCwkJDRENDg8QEBEQCgwSExIQEw8QEBD/2wBDAQMDAwQDBAgEBAgQCwkLEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBD/yQARCAAIABADAREAAhEBAxEB/8wACgAQEAUBEBEF/9oADAMBAAIRAxEAPwD/AM/wDqQM1Aj/2Q=="
  "A 16 x 8 JPEG ImageMagick wrote with arithmetic coding, as base64: a form
this does not read.")

(defun jpeg-fixture (name)
  (cl-base64:base64-string-to-usb8-array (sixth (assoc name *jpeg-fixtures* :test #'string=))))

(deftest jpeg-decodes-every-form-to-libjpegs-pixels ()
  (loop for (name width height channels digest) in *jpeg-fixtures*
        do (multiple-value-bind (pixels w h c) (nle::jpeg-decode (jpeg-fixture name))
             (is (and (eql w width) (eql h height) (eql c channels))
                 (format nil "~a is ~dx~d of ~d channels, not ~dx~d of ~d" name width height channels w h c))
             (is (string= digest (subseq (nlk::sha256-text pixels) 7))
                 (format nil "~a decodes to the pixels libjpeg gives" name)))))

(deftest jpeg-pixels-hands-fit-image-its-pixels ()
  (is-present (pixels (nle::jpeg-pixels (jpeg-fixture "progressive-gray"))) "the PIXELS of a progressive gray JPEG"
    (is (nle::pixels-p pixels) "a PIXELS")
    (is-shape pixels (nle::pixels-width 9) (nle::pixels-height 5) (nle::pixels-channels 1 "gray"))))

(deftest jpeg-refuses-what-it-cannot-read ()
  (let ((baseline (jpeg-fixture "baseline-420")))
    (signals-error nle::jpeg-malformed (nle::jpeg-decode (subseq baseline 0 30)))
    (signals-error nle::jpeg-malformed (nle::jpeg-decode (octets 1 2 3 4)))
    ;; An arithmetic-coded JPEG is refused by name.
    (let ((report (refusal-text nle::jpeg-malformed
                    (nle::jpeg-decode (cl-base64:base64-string-to-usb8-array *arithmetic-jpeg*)))))
      (is (search "arithmetic-coded" report) report))
    (signals-error nle::image-unfit (nle::jpeg-pixels (subseq baseline 0 30)))
    (let ((nle::*image-max-pixels* 50))
      ;; A frame past the ceiling is refused from its header.
      (let ((report (refusal-text nle::jpeg-malformed (nle::jpeg-decode baseline))))
        (is (search "past the 50 pixels" report) report)))))

(deftest fit-image-shrinks-a-progressive-jpeg-with-no-transcoder ()
  (let ((nlt:*png-transcoders* '()))
    (multiple-value-bind (octets media-type width height) (nle::fit-image (jpeg-fixture "wide-progressive"))
      (is (equal (list 2000 13) (list width height)) "2400 x 16 shrunk to 2000 x 13")
      (is (member media-type '("image/png" "image/jpeg") :test #'equal) "re-encoded as PNG or JPEG")
      (is (equal (list 2000 13) (multiple-value-list (nlt:image-dimensions octets))) "the bytes sent are that size"))))
