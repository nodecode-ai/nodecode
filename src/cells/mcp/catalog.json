{
  "about": "Well-known MCP servers the web page offers to add, each in a shape this client speaks: a command over stdio with the environment it needs, or a URL over streamable HTTP with the headers it needs; none needs OAuth. Every recipe was read from its project's own documentation at the commit or version in `source' (2026-09-28), and the no-key URLs answered an anonymous initialize that day. `env' and `headers' name what the operator supplies: `ask' is the question, `prefix' goes before the answer, `optional' may be left empty.",
  "servers": [
    {
      "name": "playwright",
      "what": "Drives a real browser: opens pages, clicks, types, reads what is on screen",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "needs": "Node.js",
      "homepage": "https://github.com/microsoft/playwright-mcp",
      "source": "microsoft/playwright-mcp README.md @ f183dad4a529; npm @playwright/mcp 0.0.83"
    },
    {
      "name": "chrome-devtools",
      "what": "Controls and inspects a live Chrome through its DevTools",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"],
      "needs": "Node.js and Chrome",
      "homepage": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
      "source": "ChromeDevTools/chrome-devtools-mcp README.md @ 47c5b3753d9b; npm chrome-devtools-mcp 1.10.1"
    },
    {
      "name": "github",
