;;;; detect-test.lisp --- versions judged per release line; each check kind on a fixture.
;;;;
;;;; SPDX-License-Identifier: MIT

(in-package #:nodecode.test)

(defun sp-judge (version check-json)
  (values (nodecode-cyber-security::judge (nodecode-cyber-security::parse-version version)
                                            (sp-check check-json))))

(deftest cyber-security-a-version-is-judged-on-its-own-release-line ()
  (let ((php "{\"fixed\":[\"8.5.12\",\"8.4.27\",\"8.3.36\",\"8.2.35\"]}")
        (ovh "{\"min\":\"0.11.0\",\"fixed\":[\"0.16.0\"]}")
        (litellm "{\"bad\":[\"1.107.0\"]}")
        (plex "{\"fixed\":[\"1.43.3.10861\"]}"))
    (is (eq :vulnerable (sp-judge "8.3.10" php)) "below its line's fix")
    (is (eq :ok (sp-judge "8.3.36" php)) "at its line's fix")
    (is (eq :ok (sp-judge "8.4.30" php)) "above its line's fix")
    (is (eq :vulnerable (sp-judge "8.1.2" php)) "an end-of-life line older than every fix")
    (is (eq :vulnerable (sp-judge "7.4.33" php)))
    (is (eq :ok (sp-judge "8.6.0" php)) "a line newer than every fix")
    (is (eq :ok (sp-judge "0.10.0" ovh)) "before the affected range")
    (is (eq :vulnerable (sp-judge "0.13.0" ovh)))
    (is (eq :ok (sp-judge "0.16.0" ovh)))
    (is (eq :vulnerable (sp-judge "1.107.0" litellm)) "the bad build")
    (is (eq :ok (sp-judge "1.106.2" litellm)))
    (is (eq :vulnerable (sp-judge "1.43.2.10000" plex)) "four-part versions")
    (is (eq :ok (sp-judge "1.43.3.10861" plex)))
    (is (equal '(24 1 0) (nodecode-cyber-security::parse-version "v24.1.0")) "node -v's leading v")
    (let ((node "{\"line\":1,\"fixed\":[\"22.23.4\",\"24.22.1\",\"26.12.1\"]}"))
      (is (eq :vulnerable (sp-judge "26.3.1" node)) "Node's line is its major: 26.3.1 < 26.12.1")
      (is (eq :ok (sp-judge "24.23.0" node)) "a later minor of a fixed major passes")
      (is (eq :vulnerable (sp-judge "20.19.0" node)) "an end-of-life major")
      (is (search "26.3.1 < 26.12.1" (nth-value 1 (nodecode-cyber-security::judge '(26 3 1) (sp-check node))))))))

(deftest cyber-security-a-command-check-reads-its-output (with-stubbed-security)
  (let ((php (sp-check "{\"kind\":\"version\",\"command\":[\"php\",\"-r\",\"echo PHP_VERSION;\"],\"fixed\":[\"8.3.36\"],\"backport\":[\"sh\",\"-c\",\"zgrep CVE\"]}"))
        (tls (sp-check "{\"kind\":\"command\",\"needs\":\"host\",\"match\":\"(?i)emsign|emudhra\",\"command\":[\"sh\",\"-c\",\"openssl s_client -connect '{host}:443'\"]}")))
    (is (eq :absent (getf (nodecode-cyber-security::run-check php) :status)) "no php here")
    (setf *sp-outputs* '(("php" "8.3.6" 0)))
    (is (eq :vulnerable (getf (nodecode-cyber-security::run-check php) :status)) "8.3.6 by number")
    (setf *sp-outputs* '(("php" "8.3.6" 0) ("sh:zgrep" "/usr/share/doc/php8.3-common/changelog.Debian.gz" 0)))
    (let ((r (nodecode-cyber-security::run-check php)))
      (is (eq :ok (getf r :status)) "a distro backport is the fix")
      (is (search "distro build" (getf r :why))))
    (is (eq :skipped (getf (nodecode-cyber-security::run-check tls) :status)) "no host, no certificate check")
    (setf *sp-outputs* '(("sh:openssl" "issuer=C = IN, O = eMudhra Technologies Limited, CN = emSign ECC CA - G3" 0)))
    (is (eq :vulnerable (getf (nodecode-cyber-security::run-check tls :host "example.com") :status)))
    (setf *sp-outputs* '(("sh:openssl" "issuer=C = US, O = Let's Encrypt, CN = E7" 0)))
    (is (eq :ok (getf (nodecode-cyber-security::run-check tls :host "example.com") :status)))))

(deftest cyber-security-project-checks-read-the-site-folder (with-stubbed-security)
  (let ((dir (sp-scratch-dir "site")))
    (sp-write dir "package-lock.json"
              "{\"packages\":{\"node_modules/@strapi/strapi\":{\"version\":\"4.7.1\"}}}")
    (sp-write dir "composer.lock"
              "{\"packages\":[{\"name\":\"drupal/core\",\"version\":\"11.4.9\"}]}")
    (sp-write dir "wp-content/plugins/seo-by-rank-math-pro/rank-math-pro.php"
              (format nil "<?php~%/**~% * Plugin Name: Rank Math SEO PRO~% * Version: 3.0.123~% */~%"))
    (flet ((status (json) (getf (nodecode-cyber-security::run-check (sp-check json) :dir (namestring dir)) :status)))
      (is (eq :vulnerable (status "{\"kind\":\"npm\",\"package\":\"@strapi/strapi\",\"fixed\":[\"4.8.0\"]}")))
      (is (eq :absent (status "{\"kind\":\"npm\",\"package\":\"@apexacc/cli\",\"bad\":[\"*\"]}")))
      (is (eq :vulnerable (status "{\"kind\":\"composer\",\"packages\":[\"drupal/core\"],\"fixed\":[\"11.4.10\",\"10.6.19\"]}")))
      (is (eq :vulnerable (status "{\"kind\":\"wp-plugin\",\"slugs\":[\"seo-by-rank-math-pro\"],\"bad\":[\"3.0.123\"]}")))
      (is (eq :absent (status "{\"kind\":\"wp-plugin\",\"slugs\":[\"updraftplus\"],\"fixed\":[\"1.26.13\"]}"))))
    (is (eq :skipped (getf (nodecode-cyber-security::run-check
                            (sp-check "{\"kind\":\"npm\",\"package\":\"x\",\"fixed\":[\"1.0\"]}"))
                           :status)))
    (uiop:delete-directory-tree dir :validate t)))
