// channels.telegram — the section ~/.nodecode/config.jsonc needs for this
// adapter. Copy it in (a present section is enabled; "enabled": false
// vetoes it), or say "set up telegram" to the agent, which writes it
// through (config-set ...) and checks the token with (nck:probe "telegram").
//
// Secrets are never inline: token_env names an environment variable,
// token_file a file holding the token. Exactly one of the two.
{
  "channels": {
    "telegram": {
      "token_env": "TELEGRAM_BOT_TOKEN",
      // At least one of allowed_chats / allowed_users must be non-empty:
      // channel messages run with full host authority, so a lane never
      // starts open to the world. Ids are strings; a group's chat id is
      // negative, a private chat's id is the user's id; the probe lists
      // every chat that has written to the bot.
      "allowed_chats": ["<chat id>"],
      "allowed_users": ["<user id>"],
      // Whose word is standing policy in the chat.
      "owner": ["<user id>"],
      // true: a private chat from someone no list names is answered with a
      // pairing code; /channels pair CODE lets them in. A private chat
      // allowed_chats does not name is refused before it gets that far.
      "pairing": true,
      // true: in groups, answer when @mentioned or replied to.
      "require_mention": true,
      // true: each ask carries the eye on the message itself from admission
      // through the working turn, then a thumbs up when its answer lands,
      // a thumbs down when it fails.
      "reactions": false,
      // true (default): the model's words show in the chat as it writes
      // them, in a message edited as it grows. The answer still posts as a
      // fresh message that notifies its asker, and the streamed copy is
      // deleted.
      "stream": true,
      // An answer can come as a voice message too, below its words: "on"
      // answers an ask said in a voice message with one, "tts" answers every
      // ask with one, "off" (default) never does. Spoken by the speech
      // section's voice; needs ffmpeg.
      "voice_replies": "off",
      // Minutes an ask's turn may run. Past them its tool calls are refused
      // and it answers with what is done and what is left; the chat gets a
      // report instead of a turn that runs on. 0, the default, caps nothing:
      // the turn sees its own clock on every tool result.
      "turn_budget_minutes": 0,
      // The most history the chat keeps, in estimated tokens (a token per
      // four characters; the provider counts about a quarter more).
      // Every ask opens on the chat's record, so past this the chat evicts
      // its older half and the next ask opens on the rest; what went stays
      // in the log, where recall reads it. 0 keeps everything.
      "room_tokens": 40000,
      // Agents a chat's asks may run as: the folder they work in, a persona
      // in place of soul_file, standing instructions, a model, and skills
      // the model reads first.
      "agents": {
        // "coder": {"folder": "~/src/app", "prompt": "...", "model": "..."}
      },
      // Which asks run as which agent, by "channel" (a chat id), "thread"
      // (a forum topic) or "user" ids, written as strings. Every key a route
      // names must match; the most specific wins, user first, then thread,
      // then chat. "agent": "default" is none.
      "routes": [
        // {"agent": "coder", "channel": "<chat id>"}
      ]
    }
  }
}
