+/* A copy-on-write view takes no read-write protection: its writable pages
+ * are copy-on-write, and the first write makes the page private. */
+static DWORD view_protection(DWORD prot)
+{
+    return prot == PAGE_READWRITE ? PAGE_WRITECOPY
+        : prot == PAGE_EXECUTE_READWRITE ? PAGE_EXECUTE_WRITECOPY
+        : prot;
+}
