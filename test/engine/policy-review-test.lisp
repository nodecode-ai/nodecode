;;;; policy-review-test.lisp --- an edit to the agent's own policy takes the road.
;;;;
;;;; SPDX-License-Identifier: MIT
;;;;
;;;; A real git store under a per-run temp directory, an adopted ref seeded
;;;; with AGENTS.md; the store's, replay's, record's and charter's functions
;;;; are stand-ins bound through NLE::*POLICY-SEAMS*, each doing the least
;;;; its contract says, so these tests read the road and nothing else.

(in-package #:nodecode.test)

(defvar *pr-replay* '(:turns 3 :flips 0 :noise 0 :looser 0 :stricter 0 :items ())
  "What the stand-in replay answers.")
(defvar *pr-pins* '())
(defvar *pr-dropped* '())
(defvar *pr-scheduled* '())

(defun pr-git (store &rest args)
  (multiple-value-bind (out err status)
      (nlk:run-bounded (list* "git" "-C" (namestring store) args) :seconds 30)
    (declare (ignore err))
    (values (string-right-trim '(#\Newline) (or out "")) status)))

(defun pr-text (store)
  (lambda (name &key ref session-id)
    (let ((ref (or ref (and session-id (cdr (assoc session-id *pr-pins* :test #'equal)))
                   "refs/heads/adopted")))
      (multiple-value-bind (out status) (pr-git store "show" (format nil "~a:~a" ref name))
        (and (eql status 0) out)))))

(defun pr-adopt (store)
  (lambda (files message)
    (let ((sha (nle::store-commit (nle::adopted-head) files message)))
      (pr-git store "update-ref" "refs/heads/adopted" sha)
      sha)))

(defmacro with-policy-store ((store &key (self t)) &body body)
  "Run BODY over a fresh store whose adopted ref holds AGENTS.md."
  `(let* ((,store (format nil "/tmp/nl-policy-review-~a-~d/" (sb-posix:getpid) (random 1000000000)))
          (*pr-replay* *pr-replay*) (*pr-pins* '()) (*pr-dropped* '()) (*pr-scheduled* '())
          (nle::*policy-seams*
            (list :store (pathname ,store)
                  :self-p (lambda () ,self)
                  :ensure (lambda () nil)
                  :text (pr-text ,store)
                  :adopt (pr-adopt ,store)
                  :pin (lambda (session commit)
                         (setf *pr-pins* (remove session *pr-pins* :key #'car :test #'equal))
                         (when commit (push (cons session commit) *pr-pins*)))
                  :replay (lambda (old new &key since until)
                            (declare (ignore since until))
                            (list* :old old :new new *pr-replay*))
                  :charter-refusal (lambda (paths)
                                     (and (member "CHARTER.md" paths :test #'string=)
                                          "CHARTER.md is the operator's"))
                  :dropped-p (lambda (store files)
                               (declare (ignore store))
                               (cdr (assoc files *pr-dropped* :test #'equal)))
                  :record-drop (lambda (store files &key reason id)
                                 (declare (ignore store reason))
                                 (push (cons files id) *pr-dropped*) id)
                  :record-push (lambda (store) (declare (ignore store)) :pushed)
                  :schedule (lambda (when prompt &key name timeout-minutes)
                              (declare (ignore timeout-minutes))
                              (push (list when prompt name) *pr-scheduled*)
                              "job j1 added: once; next fire later; session cron-j1"))))
     (ensure-directories-exist ,store)
     (unwind-protect
          (progn
            (pr-git ,store "init" "-q")
            (pr-git ,store "config" "user.name" "test")
            (pr-git ,store "config" "user.email" "test@localhost")
            (let ((empty (pr-git ,store "hash-object" "-t" "tree" "-w" "/dev/null")))
              (pr-git ,store "update-ref" "refs/heads/adopted"
                      (pr-git ,store "commit-tree" empty "-m" "empty")))
            (funcall (pr-adopt ,store) '(("AGENTS.md" . "Ask before deleting anything.")) "seed")
            ,@body)
       (uiop:delete-directory-tree (pathname ,store) :validate t :if-does-not-exist :ignore))))

(defun pr-adopted (store name) (funcall (pr-text store) name :ref "refs/heads/adopted"))

(defconstant +pr-day+ (* 25 3600))

(deftest policy-stricter-edit-binds-now-and-is-reviewed-under-the-old-text ()
  (with-policy-store (store)
    (let* ((p (nle::policy-propose '(("AGENTS.md" . "Ask before deleting or pushing anything."))
                                   :direction :stricter :reason "ask more" :session-id "s-author")))
      (is (eq :stricter (getf p :path)))
      (is (equal "Ask before deleting or pushing anything." (pr-adopted store "AGENTS.md"))
          "a stricter edit binds at once")
      (is (= 1 (length *pr-scheduled*)) "its review is scheduled")
      (is (equal (getf p :base) (cdr (assoc "cron-j1" *pr-pins* :test #'equal)))
          "the review job's session reads the policy from before the edit")
      (is (search "policy-decide" (second (first *pr-scheduled*))) "the job is told how to end"))))

(deftest policy-looser-edit-waits-in-shadow-until-another-session-adopts-it ()
  (with-policy-store (store)
    (let* ((now (get-universal-time))
           (p (nle::policy-propose '(("AGENTS.md" . "Delete scratch files without asking."))
                                   :direction :looser :session-id "s-author" :now now))
           (id (getf p :id)))
      (is (eq :shadow (getf p :path)))
      (is (equal "Ask before deleting anything." (pr-adopted store "AGENTS.md")) "shadow binds nothing")
      (signals-error nle::policy-review-error
        (nle::policy-decide id :adopt "fine" :session-id "cron-j1" :now (+ now 3600)))
      (signals-error nle::policy-review-error
        (nle::policy-decide id :adopt "fine" :session-id "cron-j1" :now (+ now +pr-day+)))
      (signals-error nle::policy-review-error
        (nle::policy-review-evidence id :session-id "s-author" :now (+ now +pr-day+)))
      (let ((evidence (nle::policy-review-evidence id :session-id "cron-j1" :now (+ now +pr-day+))))
        (is (equal '(("AGENTS.md" . "Ask before deleting anything.")) (getf (getf evidence :replay) :old))
            "the replay gets the old text")
        (is (equal '(("AGENTS.md" . "Delete scratch files without asking.")) (getf (getf evidence :replay) :new))
            "and the new"))
      (signals-error nle::policy-review-error
        (nle::policy-decide id :adopt "fine" :session-id "s-author" :now (+ now +pr-day+)))
      (let ((done (nle::policy-decide id :adopt "no flips in 3 asks" :session-id "cron-j1" :now (+ now +pr-day+))))
        (is (eq :adopted (getf done :state)))
        (is (equal "Delete scratch files without asking." (pr-adopted store "AGENTS.md")) "adopted, it binds")
        (is (null (assoc "cron-j1" *pr-pins* :test #'equal)) "the reviewer's pin is released")))))

(deftest policy-dropped-change-stays-dropped ()
  (with-policy-store (store)
    (let* ((now (get-universal-time))
           (edit '(("AGENTS.md" . "Push without asking.")))
           (id (getf (nle::policy-propose edit :session-id "s-author" :now now) :id)))
      (nle::policy-review-evidence id :session-id "cron-j1" :now (+ now +pr-day+))
      (is (eq :dropped (getf (nle::policy-decide id :drop "lets it push unasked" :session-id "cron-j1"
                                                 :now (+ now +pr-day+))
                             :state)))
      (is (equal "Ask before deleting anything." (pr-adopted store "AGENTS.md")))
      (signals-error nle::policy-review-error (nle::policy-propose edit :session-id "s-author"))
      (signals-error nle::policy-review-error (nle::policy-propose edit :direction :stricter :session-id "s-author")))))

(deftest policy-stricter-label-on-a-loosening-is-reverted ()
  (with-policy-store (store)
    (let* ((now (get-universal-time))
           (id (getf (nle::policy-propose '(("AGENTS.md" . "Ask before deleting things you did not make."))
                                          :direction :stricter :session-id "s-author" :now now)
                     :id))
           (*pr-replay* '(:turns 5 :flips 2 :noise 0 :looser 1 :stricter 1 :items ())))
      (is (equal "Ask before deleting things you did not make." (pr-adopted store "AGENTS.md")))
      (nle::policy-review-evidence id :session-id "cron-j1" :now (+ now +pr-day+))
      (let ((done (nle::policy-decide id :adopt "looks stricter" :session-id "cron-j1" :now (+ now +pr-day+))))
        (is (eq :dropped (getf done :state)) "a looser flip overrides the verdict")
        (is (search "looser flip" (getf done :why))))
      (is (equal "Ask before deleting anything." (pr-adopted store "AGENTS.md")) "reverted"))))

(deftest policy-system-prompt-edit-is-always-shadow ()
  (with-policy-store (store)
    (let* ((now (get-universal-time))
           (p (nle::policy-propose (nle::prompt-files "You are terse.") :direction :stricter
                                   :session-id "s-author" :now now)))
      (is (eq :shadow (getf p :path)) "declared stricter, still shadow")
      (is (eq :shadow (nle::policy-sort "SYSTEM.md" :stricter)))
      (is (eq :stricter (nle::policy-sort "SOUL.md" :stricter)))
      (is (equal nle::*system-prompt* (nle::policy-system-prompt)) "unadopted, the shipped prompt rides")
      (nle::policy-review-evidence (getf p :id) :session-id "cron-j1" :now (+ now +pr-day+))
      (nle::policy-decide (getf p :id) :adopt "no flips" :session-id "cron-j1" :now (+ now +pr-day+))
      (is (equal "You are terse." (nle::policy-system-prompt)) "adopted, it is the system message")
      (is (null (nle::policy-prompt-drift)) "written against this release's prompt")
      (let ((nle::*system-prompt* (concatenate 'string nle::*system-prompt* " Shipped line.")))
        (is (getf (nle::policy-prompt-drift) :now) "a release that ships another prompt is seen")))))

(deftest policy-unreviewed-proposals-lapse ()
  (with-policy-store (store)
    (let* ((now (get-universal-time))
           (shadow (nle::policy-propose '(("SOUL.md" . "Loud.")) :session-id "s-author" :now now))
           (strict (nle::policy-propose '(("AGENTS.md" . "Ask before anything.")) :direction :stricter
                                        :session-id "s-author" :now now))
           (lapsed (nle::policy-review-sweep :now (+ now (* 100 3600)))))
      (is (= 2 (length lapsed)))
      (is (null (pr-adopted store "SOUL.md")) "a lapsed shadow edit never bound")
      (is (equal "Ask before deleting anything." (pr-adopted store "AGENTS.md")) "a lapsed stricter edit is reverted")
      (is (eq :lapsed (getf (nle::policy-proposal (getf shadow :id)) :state)))
      (is (eq :lapsed (getf (nle::policy-proposal (getf strict :id)) :state))))))

(deftest policy-proposals-refused-at-the-door ()
  (with-policy-store (store)
    (signals-error nle::policy-review-error (nle::policy-propose '(("CHARTER.md" . "anything"))))
    (signals-error nle::policy-review-error (nle::policy-propose '(("AGENTS.md" . "Ask before deleting anything."))))
    (signals-error nle::policy-review-error (nle::policy-propose '(("AGENTS.md" . "x")) :direction :sideways)))
  (with-policy-store (store :self nil)
    (signals-error nle::policy-review-error (nle::policy-propose '(("AGENTS.md" . "x"))))))
