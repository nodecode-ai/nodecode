;;;; trust-test.lisp --- what a folder may hand a session beyond words.
;;;;
;;;; SPDX-License-Identifier: MIT
;;;;
;;;; engine/trust.lisp: the walk finds a folder's skills, cells and MCP
;;;; servers, a home's own cells left out; a decision is the folder's own,
;;;; never a parent's; a trusted folder's skills ride `project-skills', the
;;;; nearest one winning a name and the operator's own winning over both; the
;;;; ask is put once per session and acts on its answer; /trust reports and
;;;; decides.

(in-package #:nodecode.test)

(defun skill-file-text (name description)
  (format nil "---~%name: ~a~%description: ~a~%---~%~%Steps for ~a.~%" name description name))

(defmacro with-trust-workspace ((dir) &body body)
  "A workspace: root/ keeps skill `alpha'; root/proj/ keeps skill `beta' under
.claude/skills/, cell `gamma' and MCP server `stripe'; root/proj/deep/ is
where sessions stand; root/home/.nodecode/ is a home whose cells are its
own. Decisions go to a trust.json of its own."
  `(with-temp-workspace (,dir "proj/deep/x" "home/.nodecode/config.jsonc" "home/.nodecode/cells/mine/mine.asd"
                              "proj/.nodecode/cells/gamma/gamma.asd")
     (write-temp-file (merge-pathnames ".agents/skills/alpha/SKILL.md" ,dir) (skill-file-text "alpha" "Root things"))
     (write-temp-file (merge-pathnames "proj/.claude/skills/beta/SKILL.md" ,dir) (skill-file-text "beta" "Project things"))
     (write-temp-file (merge-pathnames "proj/.mcp.json" ,dir) "{\"mcpServers\": {\"stripe\": {\"command\": \"npx\"}}}")
     (let ((nle::*trust-file* (merge-pathnames "trust.json" ,dir))
           (nle::*session-trust* (make-hash-table :test #'equal :synchronized t))
           (nle::*trust-asked* (make-hash-table :test #'equal :synchronized t)))
       ,@body)))

(defmacro with-stubbed-function ((name lambda) &body body &aux (old (gensym "OLD")))
  `(let ((,old (fdefinition ',name)))
     (setf (fdefinition ',name) ,lambda)
     (unwind-protect (progn ,@body)
       (setf (fdefinition ',name) ,old))))

(deftest trust-walk-finds-skills-cells-and-mcp-servers ()
  (with-trust-workspace (dir)
    (let* ((found (nle::project-resources (merge-pathnames "proj/deep/" dir)))
           (proj (assoc (truename (merge-pathnames "proj/" dir)) found :test #'equal :key #'truename))
           (root (assoc (truename dir) found :test #'equal :key #'truename)))
      (is (= 2 (length found)) "two folders carry something: the project and the root above it")
      (is (equal (truename (merge-pathnames "proj/" dir)) (truename (car (first found)))) "the nearest folder first")
      (is (equal '((:skill "beta") (:cell "gamma") (:mcp "stripe"))
                 (mapcar (lambda (item) (list (first item) (second item))) (cdr proj))) "the project's skill under .claude/skills, its cell and its MCP server")
      (is (equal "Project things" (third (second proj))) "a skill carries its description")
      (is (equal '((:skill "alpha")) (mapcar (lambda (item) (list (first item) (second item))) (cdr root))) "the root's skill under .agents/skills")
      (is (null (find "mine" (mapcan (lambda (entry) (copy-list (cdr entry)))
                                         (nle::project-resources (merge-pathnames "home/" dir)))
                        :key #'second :test #'equal)) "a home's own .nodecode/cells are the operator's, never a project's")
      (is (equal '("skills alpha") (list (nle::resource-summary (cdr root)))) "a folder's summary line")
      (is (equal "skills beta · cells gamma · MCP stripe" (nle::resource-summary (cdr proj))) "and every kind it carries"))))

(deftest trust-decisions-are-each-folders-own ()
  (with-trust-workspace (dir)
    (let ((proj (merge-pathnames "proj/" dir)))
      (is (null (nle::folder-decision proj)) "nothing is decided at first")
      (nle::save-trust-decisions (list dir) :trust)
      (is (eq :trust (nle::folder-decision dir)) "a saved decision reads back")
      (is (null (nle::folder-decision proj)) "and vouches for no folder under it")
      (is (search "\"trust\"" (nlk:read-text nle::*trust-file*)) "trust.json holds it as a word")
      (nle::save-trust-decisions (list proj) :deny)
      (is (eq :deny (nle::folder-decision proj)) "a denial reads back")
      (is (eq :trust (nle::folder-decision dir)) "beside the other, kept")
      (nle::save-trust-decisions (list proj) nil)
      (is (null (nle::folder-decision proj)) "forgetting clears it")
      (nle::trust-session "s-one" (list proj))
      (is (eq :session (nle::folder-decision proj "s-one")) "session trust holds for its session")
      (is (null (nle::folder-decision proj "s-two")) "and no other")
      (write-temp-file nle::*trust-file* "not json")
      (is (null (nle::folder-decision dir)) "a broken file decides nothing"))))

(deftest trusted-folders-hand-their-skills-to-the-session ()
  (with-trust-workspace (dir)
    (let ((cwd (merge-pathnames "proj/deep/" dir)))
      (with-stubbed-function (nle::knowledge-entry-named (lambda (name session-id)
                                                          (declare (ignore session-id))
                                                          (equal name "alpha-mine")))
        (is (null (nle::project-skills-section "s-1" cwd)) "no skill rides before a folder is trusted")
        (nle::save-trust-decisions (list (merge-pathnames "proj/" dir)) :trust)
        (is-present (text (cdr (nle::project-skills-section "s-1" cwd))) "a trusted folder's skill rides"
          (is (search "beta: Project things" text) "by name and description")
          (is (search "SKILL.md" text) "with the file to read")
          (is (null (search "alpha" text)) "an untrusted folder's skill does not"))
        (nle::trust-session "s-1" (list dir))
        (is (search "alpha: Root things" (cdr (nle::project-skills-section "s-1" cwd))) "session trust hands its folder's skills to that session")
        (is (null (search "alpha" (cdr (nle::project-skills-section "s-2" cwd)))) "and to no other")
        (write-temp-file (merge-pathnames "proj/.agents/skills/alpha/SKILL.md" dir)
                         (skill-file-text "alpha" "Nearer things"))
        (let ((text (cdr (nle::project-skills-section "s-1" cwd))))
          (is (search "Nearer things" text) "the nearest folder wins a name two share")
          (is (null (search "Root things" text)) "once"))
        (write-temp-file (merge-pathnames "proj/.agents/skills/mine/SKILL.md" dir)
                         (skill-file-text "alpha-mine" "Shadow"))
        (is (null (search "Shadow" (cdr (nle::project-skills-section "s-1" cwd)))) "a skill of the operator's own by that name wins over the folder's")))))

(deftest folder-trust-is-asked-once-and-acted-on ()
  (with-trust-workspace (dir)
    (let ((cwd (merge-pathnames "proj/deep/" dir))
          (asked '())
          (answer nil))
      (with-stubbed-function (nle:ask-operator (lambda (title &key choices detail seconds session-id)
                                                 (declare (ignore seconds))
                                                 (push (list title detail choices session-id) asked)
                                                 answer))
        (is (null (nle::ask-folder-trust "s-1" cwd)) "nobody answering decides nothing")
        (is (= 1 (length asked)) "the person watching was asked")
        (destructuring-bind (title detail choices session-id) (first asked)
          (is (search "2 folders" title) "naming how many folders")
          (is (search "skills beta" detail) "and what each carries")
          (is (null (search "gamma" detail)) "only what trust turns on: not the cell")
          (is (equal nle::+trust-choices+ choices) "offering the three answers")
          (is (equal "s-1" session-id) "for its session"))
        (is (null (nle::folder-decision dir)) "and nothing is saved")
        (nle::ask-folder-trust "s-1" cwd)
        (is (= 1 (length asked)) "a session is asked once")
        (setf answer "This session only")
        (is (eq :session (nle::ask-folder-trust "s-2" cwd)) "the next session asks again")
        (is (eq :session (nle::folder-decision dir "s-2")) "and holds its session's answer")
        (is (null (nle::folder-decision dir)) "which saves nothing")
        (setf answer "Trust this folder")
        (is (eq :trust (nle::ask-folder-trust "s-3" cwd)) "trusting")
        (is (and (eq :trust (nle::folder-decision dir))
                 (eq :trust (nle::folder-decision (merge-pathnames "proj/" dir)))) "saves every folder the ask named")
        (setf asked '())
        (nle::ask-folder-trust "s-4" cwd)
        (is (null asked) "and a decided folder is never asked about again")))))

(deftest harness-sections-carry-trusted-skills-and-ask-only-in-a-turn ()
  (with-trust-workspace (dir)
    (with-temp-store ()
      (nlk:create-session :id "trust-sections" :cwd (namestring (merge-pathnames "proj/deep/" dir)))
      (with-stubbed-function (nle:ask-operator (lambda (&rest arguments)
                                                 (error "asked outside a turn: ~s" arguments)))
        (flet ((skills () (cdr (assoc "project-skills" (nle::read-harness-sections "trust-sections")
                                      :test #'string=))))
          (is (null (skills)) "no skills before trust, and no ask outside a turn")
          (nle::save-trust-decisions (list (merge-pathnames "proj/" dir)) :trust)
          (is (search "beta: Project things" (skills)) "a trusted folder's skills ride the session's sections"))))))

(deftest slash-trust-reports-and-decides ()
  (with-trust-workspace (dir)
    (with-temp-store ()
      (nlk:create-session :id "trust-slash" :cwd (namestring (merge-pathnames "proj/deep/" dir)))
      (let ((report (nle::headless-trust "" "trust-slash")))
        (is (search "not decided" report) "bare /trust names each folder's standing")
        (is (search "skills beta · cells gamma · MCP stripe" report) "and what it carries"))
      (is (search "Trusted" (nle::headless-trust "yes" "trust-slash")) "/trust yes trusts")
      (is (eq :trust (nle::folder-decision (merge-pathnames "proj/" dir))) "every folder that carries anything")
      (is (search "trusted" (nle::headless-trust "" "trust-slash")) "and the report says so")
      (nle::headless-trust "no" "trust-slash")
      (is (eq :deny (nle::folder-decision dir)) "/trust no denies")
      (nle::headless-trust "forget" "trust-slash")
      (is (null (nle::folder-decision dir)) "/trust forget clears")
      (nle::headless-trust "session" "trust-slash")
      (is (eq :session (nle::folder-decision dir "trust-slash")) "/trust session trusts for the session")
      (is (search "yes, session, no or forget" (nle::headless-trust "maybe" "trust-slash")) "anything else says the words"))))
