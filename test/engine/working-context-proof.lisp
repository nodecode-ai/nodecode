;;;; working-context-proof.lisp --- synchronous, private-store request proofs.
;;;; SPDX-License-Identifier: MIT
(defpackage #:nodecode.working-context-proof (:use #:cl) (:export #:run))
(in-package #:nodecode.working-context-proof)

(defvar *checks* 0)
(defun check (value description)
  (incf *checks*)
  (unless value (error "Working-context proof failed: ~a" description))
  (format t "pass ~a~%" description))
(defun refuses (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))

(defun with-database (thunk &key (path ":memory:"))
  "A private in-memory connection on THIS thread; no open-store, workers or config mutation."
  (let* ((db (sqlite:connect path))
         (nlk::*store* (nlk::make-store :handle db :path #p"/tmp/working-context-proof-memory.db"))
         (nlk::*store-lock* (bt2:make-recursive-lock :name "working-context-proof-store"))
         (nlk::*visible-turn-sets* (make-hash-table :test #'equal))
         (nlk::*turn-cancellation-signals* (make-hash-table :test #'equal))
         (nlk::*deferred-turn-facts* (make-hash-table :test #'equal))
         (nle::*session-registry* (make-hash-table :test #'equal))
         (nle::*hydration-cache* (make-hash-table :test #'equal))
         (nle::*hydration-order* nil)
         (nlk::*after-commit* :none)
         (nle::*live-turn* nil)
         (nle::*current-durable-turn* nil)
         (nle::*executing-tool-call-id* nil)
         (nle::*snippet-touched* nil)
         (nle::*watch-running* nil)
         (nlk:*scribe-session-id* nil))
    (nlk:with-cleanup ((when (nlk::store-handle nlk::*store*)
                         (sqlite:disconnect (nlk::store-handle nlk::*store*))))
      (nlk::apply-schema db)
      (funcall thunk))))
(defun enter (id input &optional (source "gateway") &aux (command (nlk::make-durable-id "proof")))
  (setf nle::*current-durable-turn*
        (nlk:admit-turn id command input
                        :invocation (nlk:default-invocation "turn.start" command :source source))))
(defun finish ()
  (nlk:complete-turn nle::*current-durable-turn* nil)
  (setf nle::*current-durable-turn* nil))
(defun answer (text &key thinking signature call (args "{}") result)
  "The model's TEXT in the turn in flight, THINKING and SIGNATURE when given;
a CALL of eval on ARGS is answered RESULT."
  (let ((msg (nle::message "assistant" text :tool-calls
                           (and call (vector (nle::chat-tool-call-object call "eval" args))))))
    (when thinking (setf (gethash "reasoning_content" msg) thinking))
    (when signature
      (setf (gethash "reasoning_blocks" msg)
            (vector (nle::json-object "thinking" (or thinking "") "signature" signature))))
    (nlk:record-assistant-message nle::*current-durable-turn* msg)
    (when call
      (nlk:record-tool-call nle::*current-durable-turn* call "eval" args)
      (nlk:record-tool-result nle::*current-durable-turn* call "eval" result))))

(defun view (session &aux (turns (nle::history-turns-for-session (nle:intern-session session))))
  (nle::compile-turn-context
   (nle::make-context-request
    :session-id session
    :provider-config (nle::make-effective-provider-config
                      :provider "working-context-proof" :lane "working-context-proof" :endpoint "http://127.0.0.1:1"
                      :api-key "fixture-only" :model "working-context-proof"
                      :context-tokens 100000 :context-tokens-operator-p t)
    :base-system-prompt "PROOF BASE" :history-turns turns
    :history-boundary (nle::session-floor-boundary session turns)
    :history-floors (nlk:retained-history-floors session))))
(defun text (id) (context-text (view id)))
(defun context-text (context)
  (format nil "~{~a~%~}" (map 'list #'nle::message-content (nle::request-messages context))))
(defun pin ()
  (nlk:record-turn-context-prompt nle::*current-durable-turn* :pin t
                                 :base "PROOF BASE" :sections #() :tools #() :floor 0))

(defvar *requests* nil)
(defvar *reject-next* nil)
(defun proof-stream (context &key &allow-other-keys)
  (push context *requests*)
  (when *reject-next*
    (setf *reject-next* nil)
    (error 'nle::provider-error :status 413 :detail "context overflow fixture"))
  (values (nle::message "assistant" "proof reply") nil "stop" "{}"))

(defun sync (id)
  "A model-request boundary, then (context): the file as the model next reads it."
  (nle::sync-context-workspace (nle:intern-session id))
  (nle::export-context-file id))
(defun file-text (id)
  (uiop:read-file-string (nle::context-file id) :external-format :utf-8))
(defun edit-file (id function)
  "Write ID's context.txt as FUNCTION returns it from the text it holds."
  (nlk:write-file-atomically (nle::context-file id) (funcall function (file-text id))))
(defun replace-body (id body)
  "Keep the first line, and BODY in place of every block."
  (edit-file id (lambda (old) (format nil "~a~%~a" (subseq old 0 (position #\Newline old)) body))))
(defun occurrences (needle text)
  (length (ppcre:all-matches-as-strings (ppcre:quote-meta-chars needle) text)))
(defun request (id &key overflow)
  (let ((nle::*provider-lanes*
          (list (nle::make-provider-lane :name "working-context-proof"
                  :stream-symbol 'proof-stream :default-endpoint "http://127.0.0.1:1")))
        (nle::*shared-config-path* nil)
        (*requests* nil)
        (*reject-next* overflow)
        (nlk::*collect-delay* 3600))
    (nle::call-provider (view id))
    (reverse *requests*)))

(defun wire (id)
  "ID's next request messages, each as the JSON the provider is sent."
  (map 'list #'nlk:encode-json-object (nle::compiled-turn-context-messages (view id))))
(defun shared-prefix (a b)
  (loop for x in a for y in b while (equal x y) count 1))
(defun raw-id (id needle)
  "The id of ID's folded message whose text holds NEEDLE."
  (loop for turn in (nle::history-turns-for-session (nle:intern-session id) :raw t)
          thereis (loop for msg in (nle::history-turn-messages turn)
                        when (search needle (nle::message-content msg)) return (nle::message-id msg))))
(defun nonce (id) (subseq (file-text id) 10 16))
(defun header (id msg-id kind &optional name)
  (format nil "[[m:~a ~a ~a~@[ ~a~]]]" (nonce id) msg-id kind name))
(defun without-block (text marker &aux (start (search marker text))
                                       (next (search "[[m:" text :start2 (1+ start))))
  "TEXT without the block whose header line starts with MARKER."
  (concatenate 'string (subseq text 0 start) (if next (subseq text next) "")))
(defun receipt (id)
  (uiop:read-file-string (merge-pathnames "context.receipt.txt" (nle::context-file id))))
(defmacro defproof (name (id input &optional answer) &body body
                    &aux (doc (and (stringp (first body)) (pop body))))
  "A proof over a fresh session ID whose turn opens on INPUT, ANSWER the
model's reply when given; whatever turn BODY leaves open is finished after it."
  `(defun ,name ()
     ,@(and doc (list doc))
     (nlk:create-session :id ,id :cwd "/tmp/")
     (enter ,id ,input)
     ,@(and answer `((answer ,answer)))
     ,@body
     (finish)))

(defproof edits-proof ("editable" "OLD QUESTION" "ORIGINAL ALPHA; DELETE ME")
  (let ((old-turn (nlk:durable-turn-turn-id nle::*current-durable-turn*)))
    (finish)
    (enter "editable" "PROTECTED INPUT")
    (nlk:record-turn-context-prompt nle::*current-durable-turn* :text "PROTECTED HARNESS")
    (pin)
    (nlk:record-tool-call nle::*current-durable-turn* "removed-image" "look" "{}")
    (nlk:record-tool-result nle::*current-durable-turn* "removed-image" "look" "old image receipt")
    (sync "editable")
    (let ((before (text "editable"))
          (body (file-text "editable")))
      (check (eql 0 (search "[[context " body)) "the first line names the export")
      (check (search (format nil "[[m:~a " (nonce "editable")) body) "each message is a headed block")
      (check (search "ORIGINAL ALPHA" body) "working copy contains historical prose")
      (check (search (format nil "→ {}~%old image receipt") body) "a tool block holds its call, then its result")
      (check (not (search "PROTECTED INPUT" body)) "active request is outside editable body")
      (check (not (search "PROTECTED HARNESS" body)) "harness instructions are outside editable body")
      (sync "editable")
      (check (equal before (text "editable")) "an untouched file leaves native provider messages unchanged")
      (check (null (nle::working-context-fact "editable" "context.edited")) "an untouched file records no edit"))
    ;; Text added at the end is a note; everything the file showed stays native.
    (let ((before (wire "editable")))
      (edit-file "editable" (lambda (old) (format nil "~aAPPENDED CHECKPOINT~%" old)))
      (sync "editable")
      (let ((after (wire "editable")))
        (check (search "kept · 0 edited · 0 removed · 1 note;" (receipt "editable"))
               (format nil "an appended note is accepted with its counts: ~a" (receipt "editable")))
        (check (= (length before) (shared-prefix before after)) "every message before an appended note is byte-identical")
        (let ((note (nth (length before) after)))
          (check (search "[context note]\\nAPPENDED CHECKPOINT" note) "the appended text is a labelled note, right after them")
          (check (search "\"role\":\"assistant\"" note) "a note is the model's own message"))
        (check (= (length after) (+ 2 (length before))) "an appended note adds itself and the receipt line, nothing else")
        (check (search (format nil "~a~%APPENDED CHECKPOINT" (header "editable" "n1" "note")) (file-text "editable"))
               "the rewritten file shows the note as its own block")))
    (replace-body "editable" (format nil "SECOND moved first~%FIRST moved second~%REPLACEMENT 雪~%~a" (make-string 3000 :initial-element #\x)))
    ;; This round was generated after the file was written, before the edit was taken.
    (answer "after export" :thinking "PRIVATE REASONING" :signature "opaque-signature"
                           :call "native-call" :result "NATIVE RESULT")
    (sync "editable")
    (let* ((requests (request "editable")) (context (first requests))
           (wire (context-text context)))
      (check (= 1 (length requests)) "edit reaches actual provider attempt")
      (check (not (search "key=\"task\"" wire)) "ordinary provider attempt has no retired task harness")
      (check (search "REPLACEMENT 雪" wire) "in-place replacement and Unicode reach request")
      (check (not (search "DELETE ME" wire)) "deleted text does not reach request")
      (check (not (search "OLD QUESTION" wire)) "a deleted earlier ask does not reach request")
      (check (not (search "APPENDED CHECKPOINT" wire)) "a deleted note does not reach request")
      (check (< (search "SECOND moved" wire) (search "FIRST moved" wire)) "arbitrary reordering reaches request")
      (check (search (make-string 3000 :initial-element #\x) wire) "growth is allowed, not only compaction")
      (check (= 1 (occurrences "PROTECTED INPUT" wire)) "active input is preserved exactly once")
      (check (search "PROTECTED HARNESS" wire) "authoritative harness delta survives")
      (check (= 1 (occurrences "NATIVE RESULT" wire)) "a round after the export follows the edit exactly once")
      (check (notany (lambda (msg) (gethash "reasoning_blocks" msg))
                    (nle::compiled-turn-context-messages context)) "reasoning made before the edit is not replayed")
      (check (= 1 (count "tool" (nle::compiled-turn-context-messages context)
                        :key (lambda (msg) (gethash "role" msg)) :test #'equal)) "native tool role remains native")
      (let* ((with-images (nle::messages-with-visible-images
                           (coerce (nle::compiled-turn-context-messages context) 'list)
                           '((nil ("image/png" . "INPUTPIC"))
                             ("removed-image" ("image/png" . "OLDPIC"))
                             ("native-call" ("image/png" . "TAILPIC")))))
             (json (nlk:encode-json-object (coerce with-images 'vector))))
        (check (and (search "INPUTPIC" json) (search "TAILPIC" json)
                    (not (search "OLDPIC" json))) "input and retained-tool images survive; removed anchors cannot resurrect images"))
      (nle:hydrate-session (nle:intern-session "editable") :budget 100000)
      (check (not (search "DELETE ME" (text "editable"))) "hydration cannot resurrect removed history")
      (nle::clear-hydration-cache)
      (check (equal wire (context-text (view "editable"))) "cold projection uses the same edited view")
      (check (search "ORIGINAL ALPHA" (format nil "~s" (nlk:recall-log :session-id "editable" :match "ORIGINAL ALPHA")))
             "lossless recall still returns originals"))
    (answer "fresh round" :signature "new-signature")
    (check (find "new-signature" (nle::compiled-turn-context-messages (view "editable"))
                 :key (lambda (msg) (let ((blocks (gethash "reasoning_blocks" msg)))
                                      (and blocks (gethash "signature" (aref blocks 0)))))
                 :test #'equal)
           "post-edit native reasoning remains intact")
    (check (refuses (lambda () (nlk:record-event "editable" "context.edited" '(:items #()))))
           "generic event writes cannot bypass the edit owner")
    ;; Header corruption refuses, preserves bytes, and supplies a model-visible receipt.
    (nlk:write-file-atomically (nle::context-file "editable") "bad header")
    (sync "editable")
    (check (search "context edit rejected" (text "editable")) "invalid edit has an explicit request-visible receipt")
    (check (equal "bad header" (uiop:read-file-string (merge-pathnames "context.rejected.txt" (nle::context-file "editable")))) "rejected bytes remain inspectable")
    (check (eql 0 (search "[[context " (file-text "editable"))) "a refusal writes the file afresh")
    (replace-body "editable" "")
    (sync "editable")
    (check (not (search "REPLACEMENT" (text "editable"))) "an empty editable body is a valid deletion")
    (check (= 1 (occurrences "PROTECTED INPUT" (text "editable"))) "empty edits cannot delete the active input")
    (nle::sync-context-workspace (nle:intern-session "editable"))
    (replace-body "editable" "LATE WRITER")
    (let ((pending (file-text "editable")))
      (nle::export-context-file "editable")
      (check (equal pending (file-text "editable")) "(context) does not overwrite an edit not yet taken")
      (check (not (search "LATE WRITER" (text "editable"))) "late edits wait for the next request boundary"))
    (sync "editable")
    (check (search "LATE WRITER" (text "editable")) "next boundary accepts the late edit")
    ;; A removed message's header written back returns the original, native, where it stood.
    (let ((alpha (raw-id "editable" "ORIGINAL ALPHA")))
      (edit-file "editable" (lambda (old) (format nil "~a~a~%" old (header "editable" alpha "assistant"))))
      (sync "editable")
      (let* ((messages (nle::compiled-turn-context-messages (view "editable")))
             (restored (find-if (lambda (msg) (search "ORIGINAL ALPHA" (nle::message-content msg))) messages)))
        (check (search "1 restored" (receipt "editable")) "a written-back header is counted as restored")
        (check (and restored (equal "assistant" (gethash "role" restored))
                    (not (search "[context note]" (nle::message-content restored))))
               "a restored message returns native, not as a note")
        (check (< (position restored messages)
                  (position-if (lambda (msg) (search "PROTECTED INPUT" (nle::message-content msg))) messages))
               "a restored message returns where it stood")))
    (let* ((record (nlk:decode-json (uiop:read-file-string (nle::context-record-file "editable"))))
           (first-line (subseq (file-text "editable") 0 (position #\Newline (file-text "editable")))))
      (nle::accept-context-edit nle::*current-durable-turn* record (format nil "~a~%CAS winner" first-line))
      (check (refuses (lambda () (nle::accept-context-edit nle::*current-durable-turn* record
                                                           (format nil "~a~%CAS loser" first-line))))
             "two edits of one export: the second is refused")
      (check (search "CAS winner" (text "editable")) "the edit taken first is the sole authority"))
    (let ((anchor (nlk:durable-turn-turn-id nle::*current-durable-turn*)))
      (finish)
      (replace-body "editable" "PARENT PENDING, NOT ACCEPTED")
      (nlk:create-session :id "child" :parent "editable" :anchor-turn-id anchor)
      (enter "child" "CHILD REQUEST")
      (sync "child")
      (check (search "CAS winner" (text "child")) "fork inherits accepted edit at its anchor")
      (check (not (search "PARENT PENDING" (text "child"))) "fork does not inherit a pending file")
      (replace-body "child" "CHILD NOTES")
      (sync "child")
      (check (search "CHILD NOTES" (text "child")) "fork can edit independently")
      (check (search "CAS winner" (text "editable")) "child edits do not leak upstream")
      (finish)
      (enter "editable" "PARENT FUTURE INPUT")
      (sync "editable")
      (replace-body "editable" "PARENT FUTURE NOTES")
      (sync "editable")
      (check (and (search "CHILD NOTES" (text "child"))
                  (not (search "PARENT FUTURE NOTES" (text "child"))))
             "accepted parent edits after the fork anchor do not leak downstream")
      (finish))
    (nlk:move-session-head "editable" old-turn)
    (enter "editable" "BRANCHED REQUEST")
    (sync "editable")
    (check (search "ORIGINAL ALPHA" (text "editable")) "rewind intentionally projects the earlier branch")
    (check (not (search "PARENT PENDING" (text "editable"))) "stale branch edit is refused")))

(defproof surgical-proof ("surgical" "FIRST ASK")
  "One deleted block costs from that block on: what stands before it is byte-identical."
  (answer "FIRST ANSWER" :thinking "EARLY THINKING")
  (finish)
  (enter "surgical" "SECOND ASK")
  (pin)
  (loop for (call text thinking) in '(("big" "BIG DUMP" "THINKING ABOUT BIG") ("small" "SMALL RESULT" "THINKING ABOUT SMALL"))
        do (answer (format nil "reading ~a" call) :thinking thinking
                   :call call :args "{\"form\":\"(read)\"}"
                   :result (format nil "~a ~a" text (make-string 4000 :initial-element #\d))))
  (sync "surgical")
  (let ((before (wire "surgical"))
        (big (raw-id "surgical" "BIG DUMP")))
    (edit-file "surgical" (lambda (old) (without-block old (header "surgical" big "tool" "eval"))))
    (sync "surgical")
    (let* ((after (wire "surgical"))
           (messages (nle::compiled-turn-context-messages (view "surgical")))
           (carrier (position-if (lambda (json) (search "reading big" json)) before)))
      (check (search "1 removed" (receipt "surgical")) "a deleted tool block is counted as removed")
      (check (notany (lambda (json) (search "BIG DUMP" json)) after) "a deleted tool block leaves the request, call and result")
      (check (some (lambda (json) (search "SMALL RESULT" json)) after) "the blocks beside it stay")
      (check (= carrier (shared-prefix before after)) "every message before the first change is byte-identical")
      (check (find "EARLY THINKING" messages :key (lambda (msg) (gethash "reasoning_content" msg)) :test #'equal)
             "reasoning before the first change is replayed as it was")
      (check (notany (lambda (msg) (member (gethash "reasoning_content" msg) '("THINKING ABOUT BIG" "THINKING ABOUT SMALL") :test #'equal))
                     messages)
             "reasoning at or past the first change is not replayed")
      (check (= 1 (count "tool" messages :key (lambda (msg) (gethash "role" msg)) :test #'equal))
             "the call and its result leave together"))))

(defproof by-seq-proof ("by-seq" "FIRST ASK")
  "An edit named by seq: no export read, no file written by hand, the same acceptance a file edit gets."
  (pin)
  (loop for (call text) in '(("one" "RESULT ONE") ("two" "RESULT TWO") ("three" "RESULT THREE"))
        do (answer (format nil "calling ~a" call) :call call :result text))
  (let ((nlk:*scribe-session-id* "by-seq"))
    (sync "by-seq")
    (let* ((before (wire "by-seq"))
           (two (parse-integer (raw-id "by-seq" "RESULT TWO")))
           (three (parse-integer (raw-id "by-seq" "RESULT THREE"))))
      (check (search (format nil "RESULT TWO~%[seq ~d]" two) (text "by-seq")) "a tool result ends with its seq line")
      (check (search (format nil "→ {}~%RESULT TWO~%[[m:") (file-text "by-seq")) "the file reads the result without the seq line")
      (let ((staged (nle::context :note "NOTE ONLY")))
        (check (search "0 blocks dropped, 6 kept, your note at the end" staged) staged)
        (sync "by-seq")
        (let ((after (wire "by-seq")))
          (check (= (length before) (shared-prefix before after)) "a note by the verb leaves every message byte-identical")
          (check (search "[context note]\\nNOTE ONLY" (nth (length before) after)) "and stands right after them")))
      (check (search "1 block dropped" (nle::context :drop (cons two two))) "a one-seq span names one block")
      (sync "by-seq")
      (let ((wire (text "by-seq")))
        (check (not (search "RESULT TWO" wire)) "a dropped seq leaves the request")
        (check (and (search "RESULT ONE" wire) (search "RESULT THREE" wire)) "its neighbours stay")
        (check (search "NOTE ONLY" wire) "a note between stays")
        (check (search "1 removed" (receipt "by-seq")) "the receipt counts it removed"))
      (check (search "dropped" (nle::context :drop (list (cons 0 two))))
             "a span is staged over the export")
      (check (search "your note at the end" (nle::context :note "COMPOSED"))
             "a second verb in the round edits the pending file")
      (sync "by-seq")
      (let ((wire (text "by-seq")))
        (check (not (search "RESULT ONE" wire)) "the span's blocks left")
        (check (search "COMPOSED" wire) "and the later note arrived with them"))
      (nle::context :drop t :keep (list three) :note "KEPT THREE")
      (sync "by-seq")
      (let ((wire (text "by-seq")))
        (check (not (search "COMPOSED" wire)) "drop t takes every block, notes included")
        (check (search "RESULT THREE" wire) "but a kept seq stays")
        (check (search "KEPT THREE" wire) "the new note stands at the end")
        (check (= 1 (occurrences "FIRST ASK" wire)) "the active ask is outside the edit"))
      (let ((pending (progn (nle::context :note "PENDING") (file-text "by-seq"))))
        (check (refuses (lambda () (nle::context :drop '(:everything)))) "a malformed drop is refused")
        (check (refuses (lambda () (nle::context :keep "three"))) "and a malformed keep")
        (check (equal pending (file-text "by-seq")) "with the file untouched"))
      (sync "by-seq")
      (nlk:write-file-atomically (nle::context-file "by-seq") "BY HAND, FIRST LINE LOST")
      (nle::context :note "AFTER HAND EDIT")
      (check (eql 0 (search "[[context " (file-text "by-seq"))) "the verb restores the first line a hand edit lost")
      (sync "by-seq")
      (check (and (search "BY HAND, FIRST LINE LOST" (text "by-seq")) (search "AFTER HAND EDIT" (text "by-seq")))
             "and the hand edit is taken with the verb's note"))))

(defproof relief-proof ("relief" "LONG TASK")
  "A note opens no round: within-turn relief still plans over an edited live turn."
  (pin)
  (dotimes (i 4)
    (answer (format nil "round ~d" i) :call (format nil "c~d" i)
            :result (format nil "RESULT ~d ~a" i (make-string 2000 :initial-element #\r))))
  (sync "relief")
  (let ((marker (header "relief" (raw-id "relief" "round 2") "assistant")))
    (edit-file "relief" (lambda (old &aux (at (search marker old)))
                          (format nil "~a[[note]]~%MIDDLE NOTE~%~a" (subseq old 0 at) (subseq old at)))))
  (sync "relief")
  (let ((live (car (last (nle::history-turns-for-session (nle:intern-session "relief"))))))
    (check (search "MIDDLE NOTE" (text "relief")) "a note written between rounds reaches the request")
    (check (= (length (nth-value 1 (nle::history-turn-round-split live)))
              (length (nle::history-turn-round-starts live)))
           "rounds still align with the facts that opened them")
    (check (nle::live-relief-plan live 2000 1.0d0) "within-turn relief still plans over an edited live turn")))

(defproof warning-proof ("warned" "LONG TASK")
  "Past the eviction line the model is told once and the request keeps all it held; the next one evicts; under the line the warning re-arms; past the whole window nothing waits."
  (pin)
  (dotimes (i 6)
    (answer (format nil "round ~d" i) :call (format nil "w~d" i)
            :result (format nil "RESULT ~d ~a" i (make-string 3000 :initial-element #\w))))
  (let* ((nle::*live-turn* (nle::%make-live-turn :session-id "warned" :turn-id "t"))
         (session (nle:intern-session "warned"))
         (evictions (lambda () (length (nlk:events :kind "turn.context.evicted" :session-id "warned")))))
    (flet ((hydrate (budget) (nle:hydrate-session session :tools #() :system-prompt "" :budget budget))
           (estimate ()
             ;; the policy's own estimate: every window of one token is past the line
             (nth-value 2 (nle::choose-history-boundary
                           (nle::history-turns-for-session session) 0
                           :budget 1 :tools #() :system-prompt ""
                           :calibration (nle::context-estimate-ratio nle::*provider* nle::*model*))))
           (warned () (nle::live-turn-context-warned nle::*live-turn*)))
      (hydrate 100000000)
      (check (not (warned)) "under the line nothing is said")
      (let ((budget (floor (estimate) 0.92)))
        (hydrate budget)
        (check (search "past the 85% line" (text "warned")) "past the line the request carries the warning")
        (check (zerop (funcall evictions)) "and evicts nothing")
        (check (search (format nil "RESULT 0 ~a" (make-string 3000 :initial-element #\w)) (text "warned"))
               "every round it held is still whole")
        (hydrate budget)
        (check (plusp (funcall evictions)) "the next request past the line evicts")
        (check (= 1 (occurrences "past the 85% line" (text "warned"))) "one warning, not two"))
      (hydrate 100000000)
      (check (not (warned)) "under the line again re-arms it")
      (hydrate (floor (estimate) 2))
      (check (not (warned)) "a window past whole is evicted at once, with no round to warn in"))))

(defproof overflow-proof ("overflow" "OLD TURN" "RAW MUST NOT RESURRECT")
  (finish)
  (enter "overflow" "NEVER DROP REQUEST")
  (pin)
  (sync "overflow")
  ;; The note rides the old turn: written ahead of its ask, it leaves with it.
  (let ((ask (header "overflow" (raw-id "overflow" "OLD TURN") "user")))
    (replace-body "overflow" (format nil "[[note]]~%EVICTABLE NOTE~%~a~%OLD TURN" ask)))
  (sync "overflow")
  (let* ((requests (request "overflow" :overflow t))
         (first (context-text (first requests)))
         (second (context-text (second requests))))
    (check (= 2 (length requests)) "real overflow recovery makes two provider attempts")
    (check (every (lambda (wire) (not (search "key=\"task\"" wire))) (list first second)) "initial and overflow-retry requests have no retired task harness")
    (check (search "EVICTABLE NOTE" first) "initial attempt sends edited view")
    (check (not (search (format nil "[context note]~%EVICTABLE NOTE") second)) "recovery evicts a note with the turn it rides")
    (check (search (format nil "[your own notes in the evicted turns, oldest first]~%EVICTABLE NOTE") second)
           "and the stub carries the note it wrote")
    (check (every (lambda (s) (and (search "NEVER DROP REQUEST" s)
                                  (not (search "RAW MUST NOT RESURRECT" s)))) (list first second))
           "overflow preserves input without reconstructing removed text")
    (nle::clear-hydration-cache)
    (check (not (search (format nil "[context note]~%EVICTABLE NOTE") (text "overflow"))) "replay preserves edited-view eviction")
    (check (= 1 (occurrences "EVICTABLE NOTE" (text "overflow"))) "and the stub's copy, once")
    (check (search "already evicted" (nle::evict-decline-text "overflow"))
           "eviction status describes the edited projection, not displaced history")))

(defproof size-and-row-proof ("size" "SIZE ASK" "SIZE ANSWER")
  "The file says how full the context is; the operator's transcript says what an edit did."
  (let ((nle::*live-turn* (nle::%make-live-turn :session-id "size" :turn-id "t"
                                                :context-tokens 12345 :context-window 100000)))
    (sync "size")
    (check (search "context 12.3k of 100k ·" (subseq (file-text "size") 0 (position #\Newline (file-text "size"))))
           "the first line says how much of the window the context fills"))
  (replace-body "size" "SIZE NOTE")
  (sync "size")
  (let* ((payload (nlk:event-payload (nle::working-context-fact "size" "context.edited")))
         (line (nle::context-edit-line payload))
         (state (nle::apply-gateway-event
                 nil (nlk:json-object "type" "context.edited" "payload" payload
                                      "metadata" (nlk:json-object "turn_id" "t")))))
    (check (uiop:string-suffix-p line " tokens · 1 removed · 1 note · by the model")
           "an edit reads as one operator line: what it removed and added, and who")
    (check (not (search "0 edited" line)) "and leaves out the counts that are zero")
    (let ((row (find line (nle::transcript-rows state) :key #'nle::transcript-row-text :test #'equal)))
      (check row "a context.edited fact folds into one transcript row")
      (check (equal "Context" (nle::row-notice-label row)) "under its Context label"))))

(defproof receipt-failure-proof ("receipt" "RECEIPT INPUT" "RECEIPT ANSWER")
  (sync "receipt")
  (replace-body "receipt" "COMMITTED DESPITE RECEIPT IO")
  (let ((directory (uiop:ensure-directory-pathname
                    (merge-pathnames "context.receipt.txt" (nle::context-file "receipt")))))
    (ensure-directories-exist directory)
    (check (refuses (lambda () (sync "receipt"))) "receipt I/O failure remains an explicit failure")
    (check (search "COMMITTED DESPITE RECEIPT IO" (text "receipt")) "receipt I/O failure does not relabel a committed edit as rejected")))

(defun replay-proof (db-path)
  (with-database
   (lambda ()
     (nlk:create-session :id "reopen" :cwd "/tmp/")
     (enter "reopen" "REOPEN INPUT")
     (answer "REOPEN ANSWER")
     (sync "reopen")
     (replace-body "reopen" "DURABLE NOTE")
     (sync "reopen")
     (finish)) :path db-path)
  (with-database
   (lambda () (check (search "DURABLE NOTE" (text "reopen")) "close/reopen rebuilds the accepted edit from SQLite"))
   :path db-path))

(defun run ()
  "Private database, private home, synchronous inert provider; safe in a serving image."
  (let* ((*checks* 0)
         (root (merge-pathnames (format nil "~a/" (nlk::make-durable-id "working-context-proof")) #p"/tmp/"))
         (nlk::*home* root))
    (ensure-directories-exist root)
    (nlk:with-cleanup ((uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))
      (with-database (lambda ()
                       (edits-proof) (surgical-proof) (by-seq-proof) (relief-proof) (warning-proof) (overflow-proof)
                       (size-and-row-proof) (receipt-failure-proof)))
      (replay-proof (namestring (merge-pathnames "replay.db" root)))
      (list :passed *checks*))))
