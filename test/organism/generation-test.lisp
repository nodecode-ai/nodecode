;;;; generation-test.lisp --- the self sealed (generation.lisp).
;;;;
;;;; SPDX-License-Identifier: MIT
;;;;
;;;; Hermetic: the folder is warm-test's fixture tree, the home is a scratch of
;;;; the test's own (the manifests land there), and the trial child is a shell
;;;; fixture that writes the report the probe form names and answers a score
;;;; -- no image is dumped, and no child loads a folder.

(in-package #:nodecode.test)

(defparameter +green-report+ "{\"verdict\":\"green\",\"overrides\":0,\"failures\":[]}"
  "What the battery reports of a folder whose overrides take every call.")

(defparameter +red-report+
  "{\"verdict\":\"red\",\"overrides\":1,\"failures\":[{\"name\":\"RUN\",\"shipped\":\"(prompt &key session)\",\"override\":\"(acts)\"}]}"
  "What it reports of bp35's folder: RUN redefined over the turn runner.")

(defmacro with-prover-fixture ((var &key (score 1) (report '+green-report+)) &body body)
  "Run BODY with VAR naming a shell fixture that plays the trial child: it
writes REPORT at the path the probe form names, and answers SCORE."
  `(with-temp-file (,var :type "sh" :contents (format nil "#!/bin/sh
case \"$1\" in
  trial) form=$(cat); report=$(printf '%s' \"$form\" | sed -n 's/.*\"\\([^\"]*\\)\".*/\\1/p'); printf '%s' '~a' > \"$report\"; echo 'nodecode-trial-score ~d' ;;
esac
exit 0~%" ,report ,score))
     (with-saved-globals ((nlk::*organism-command* (list "/bin/sh" ,var)))
       (nlk:with-cleanup ((nlk:note-standing "generation" nil :warning))
         ,@body))))

(deftest a-folder-that-proves-is-sealed-as-the-next-generation (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (is (null (nlk:manifests)) "a fresh home has no generation")
    (is (search "no generation sealed" (nlk:generations)))
    (multiple-value-bind (verdict number) (nlk:prove-self key)
      (is (eq :sealed verdict) "the folder proves")
      (is (eql 1 number) "and is generation 1"))
    (is-present (manifest (first (nlk:manifests))) "the manifest"
      (is (= 1 (nlk::manifest-number manifest)))
      (is (equal key (nlk:json-value manifest :string "key")) "the key it was proved under")
      (is (equal nlk::*binary-version* (nlk:json-value manifest :string "binary" "version")))
      (is-present (row (first (nlk::manifest-rows manifest))) "one row, the fixture layer"
        (is-shape row (:name "nl-warm") (:kind "layer")
          (:origin "digest" "a plain folder is its content"))
        (is (uiop:string-prefix-p "sha256:" (getf row :revision)))))
    (is (eq :current (nlk:prove-self key)) "the same folder seals nothing more")
    (is (= 1 (length (nlk:manifests))))
    ;; a keep: the folder moves, and the key it moves to proves as generation 2
    (write-temp-file (merge-pathnames "nl-warm/fresh.lisp" root)
                     (evolved-source "(defun cells-probe-fresh () :fresh)"))
    (let ((moved (nlk::folder-key)))
      (is (not (equal key moved)))
      (is (equal '(:sealed 2) (multiple-value-list (nlk:prove-self moved))))
      (is (equal '(2 1) (mapcar #'nlk::manifest-number (nlk:manifests))) "newest first"))
    (is-carrying (text (nlk:generations))
      ("generation 2  current" "the folder stands at 2") ("generation 1" "and 1 is listed")
      ("nl-warm layer digest" "the row") ("changed since 1" "what moved")
      (:absent "unsealed"))))

(deftest a-red-verdict-refuses-the-key-and-seals-nothing (with-warm-fixture (key root cache))
  (with-prover-fixture (prover :score 0 :report +red-report+)
    (multiple-value-bind (verdict lines) (nlk:prove-self key)
      (is (eq :red verdict))
      (is (equal '("RUN takes (acts), and its callers call (prompt &key session)") lines) "in words"))
    (is (null (nlk:manifests)) "nothing sealed")
    (is (nlk:refused-key-p key) "the marker names the key")
    (is-carrying (text (board-line "generation"))
      ("RUN" "the board names the override") ("not sealed"))
    (is (eq :red (nlk:prove-self key)) "the marker answers for the key again")
    (is-carrying (text (nlk:generations)) ("unsealed" "the list says so") ("RUN"))))

(deftest a-trial-child-that-answers-nothing-is-a-red-verdict (with-warm-fixture (key root cache))
  ;; A folder that kills its loader proves nothing: the child's end, not a
  ;; report, is the verdict.
  (let ((nlk::*organism-command* '("/bin/true")))
    (nlk:with-cleanup ((nlk:note-standing "generation" nil :warning))
      (multiple-value-bind (verdict lines) (nlk:prove-self key)
        (is (eq :red verdict))
        (is (search "exited 0 without a score" (first lines)))
        (is (null (nlk:manifests)))))))

(deftest the-seal-records-the-fact-on-the-boot-session (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (with-floor-store (sid "generation")
      (let ((nlk::*generation-session-id* sid))
        (is (eq :sealed (nlk:prove-self key)))
        (is (= 1 (count-session-events sid "organism.generation_sealed")) "one fact, on the boot session")
        (is (eq :current (nlk:prove-self key)))
        (is (= 1 (count-session-events sid "organism.generation_sealed")) "and no fact for a folder already sealed")))))

(deftest the-boot-line-says-the-generation-the-folder-stands-at (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (with-saved-globals ((nlk::*layer-revision* nil))
      (flet ((layer-line ()
               (load-cell-fixture root)
               (find "cell nl-warm: layer" (nlk::lines (nlk:cells-folder-text))
                     :test (lambda (prefix line) (uiop:string-prefix-p prefix line)))))
        (is-carrying (line (layer-line)) (", unsealed" "nothing sealed yet") (:absent "generation"))
        (is (eq :sealed (nlk:prove-self key)))
        (is-carrying (line (layer-line)) (", generation 1" "the layer's line names it") (:absent "unsealed"))))))

;;; --- the restore ------------------------------------------------------------
;;; Every row back to a manifest: the layer by a commit forward whose tree is
;;; the generation's, a hub clone at its pin, a plain folder refused by name.

(defun seal-fixture (key)
  "Seal the fixture's folder under KEY through the prover fixture's child. => the number."
  (multiple-value-bind (verdict number) (nlk:prove-self key)
    (unless (eq :sealed verdict) (error "the fixture did not seal: ~a" verdict))
    number))

(deftest a-restore-moves-the-layer-forward-to-the-generations-tree (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (let ((layer (merge-pathnames "nl-warm/" root)))
      (is (nlk:git-commit-all layer "A") "the fixture layer under git")
      (let ((a (nlk::git-head-sha layer)))
        (is (= 1 (seal-fixture (nlk::folder-key))))
        (is (equal "own" (getf (first (nlk::manifest-rows (first (nlk:manifests)))) :origin)) "a repository is its HEAD")
        (write-temp-file (merge-pathnames "fresh.lisp" layer) (evolved-source "(defun cells-probe-fresh () :fresh)"))
        (is (nlk:git-commit-all layer "B"))
        (let ((b (nlk::git-head-sha layer)))
          (is (= 2 (seal-fixture (nlk::folder-key))))
          (is-carrying (text (nlk:generations)) ("generation 2  current") ("+1 keep since 1" "the delta"))
          (multiple-value-bind (lines release) (nlk:restore-generation 1 :session-id "s-test")
            (is (null release) "no release row to follow")
            (is (search "nl-warm at" (first lines))))
          (let ((c (nlk::git-head-sha layer)))
            (is (not (member c (list a b) :test #'equal)) "one commit forward")
            (is (equal (nlk::git-in-layer layer "rev-parse" (format nil "~a^{tree}" a))
                       (nlk::git-in-layer layer "rev-parse" "HEAD^{tree}")) "whose tree is generation 1's")
            (is (search "B" (nlk::git-in-layer layer "log" "--oneline")) "history kept")
            (is (search "restored generation 1 -- session s-test" (nlk::git-in-layer layer "log" "-1" "--format=%s")))
            (is (null (probe-file (merge-pathnames "fresh.lisp" layer))) "the file B added is gone"))
          (is (probe-file (nlk::restoring-path)) "the marker for the next boot")
          (is-carrying (text (nlk:generations)) ("generation 1  current" "the folder stands at 1 again") (:absent "unsealed")))))))

(deftest the-changes-between-two-generations-name-the-keeps (with-warm-fixture (key root cache))
  ;; What a generation changed: a repository's commits between the two
  ;; revisions by their subjects, oldest first -- read the other way, the
  ;; same keeps undone.
  (with-prover-fixture (prover)
    (let ((layer (merge-pathnames "nl-warm/" root)))
      (is (nlk:git-commit-all layer "A") "the fixture layer under git")
      (is (= 1 (seal-fixture (nlk::folder-key))))
      (write-temp-file (merge-pathnames "fresh.lisp" layer) (evolved-source "(defun cells-probe-fresh () :fresh)"))
      (is (nlk:git-commit-all layer "cells-probe-fresh — session s-test"))
      (is (= 2 (seal-fixture (nlk::folder-key))))
      (destructuring-bind (two one) (nlk:manifests)
        (let ((changes (nlk::generation-changes one two)))
          (is (= 1 (length changes)) "one folder moved")
          (let ((change (first changes)))
            (is (eq :moved (getf change :change)))
            (is (equal "nl-warm" (getf (getf change :row) :name)))
            (is (equal '("cells-probe-fresh — session s-test")
                       (mapcar (lambda (keep) (getf keep :subject)) (getf change :keeps))))
            (is (notany (lambda (keep) (getf keep :undone)) (getf change :keeps)))))
        (let ((back (first (nlk::generation-changes two one))))
          (is (every (lambda (keep) (getf keep :undone)) (getf back :keeps)) "going back undoes the keep"))
        (is (equal '(:added) (mapcar (lambda (change) (getf change :change))
                                     (nlk::generation-changes nil one))))))))

(deftest a-restore-refuses-by-name-before-anything-moves (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (is (= 1 (seal-fixture key)))
    (let ((probe (merge-pathnames "nl-warm/probe.lisp" root)))
      (write-temp-file probe (evolved-source "(defun cells-probe-warm () :warmer)"))
      (is-carrying (text (refusal-text error (nlk:restore-generation 1)))
        ("nl-warm" "the folder is named") ("plain folder") ("put it back by hand"))
      (is (search ":warmer" (uiop:read-file-string probe)) "and the folder is untouched")
      (is (null (probe-file (nlk::restoring-path))) "no marker")
      (is (search "no generation 7" (refusal-text error (nlk:restore-generation 7)))))))

(deftest a-restore-puts-a-hub-clone-back-at-its-pin (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (let ((hub (merge-pathnames "nl-hub/" root)) (cloned '()))
      (write-cell-folder root "nl-hub" '(("lib" . "(in-package #:nodecode.evolved)")))
      (write-temp-file (merge-pathnames ".hub" hub)
                       (format nil "https://example.test/nl-hub.git~%aaaa1111aaaa1111aaaa1111aaaa1111aaaa1111~%"))
      (is (= 1 (seal-fixture (nlk::folder-key))))
      (is-present (row (nlk::row-named "nl-hub" (nlk::manifest-rows (first (nlk:manifests)))))
        "the clone's row"
        (is (equal "hub" (getf row :origin)))
        (is (equal "aaaa1111aaaa1111aaaa1111aaaa1111aaaa1111" (getf row :revision)) "at its pin"))
      ;; the pin moves, as an update of the clone moves it
      (write-temp-file (merge-pathnames ".hub" hub)
                       (format nil "https://example.test/nl-hub.git~%bbbb2222bbbb2222bbbb2222bbbb2222bbbb2222~%"))
      (with-stubbed-fdefinition (nlk::clone-install (entry target)
                                 (push (list (nlk:offer-commit entry) (nlk:offer-git entry)) cloned)
                                 target)
        (is (search "nl-hub cloned at aaaa111" (first (nlk:restore-generation 1)))))
      (is (equal '(("aaaa1111aaaa1111aaaa1111aaaa1111aaaa1111" "https://example.test/nl-hub.git")) cloned) "once, at 1's pin")
      (is (null (probe-file hub)) "the clone at the other pin was taken out first"))))

(deftest a-restore-clones-a-lost-hub-folder-back-at-its-pin (with-warm-fixture (key root cache))
  ;; A row carries the pin -- git, commit, path -- and none of what the index
  ;; said of the .asd: the pin is the restore's authority, so a hub folder the
  ;; home has lost since is cloned back at it, whatever its .asd describes
  ;; (T-347: every such restore was refused, the row's empty description held
  ;; to the .asd's).
  (with-prover-fixture (prover)
    (with-temp-trees ((remote "restore-hub-remote"))
      (let ((description "Comes back at its pin"))
        (multiple-value-bind (git commit)
            (hub-fixture-repository remote "nl-hub-back"
                                    (lambda (folder)
                                      (write-peripheral-folder (uiop:pathname-parent-directory-pathname folder)
                                                               "nl-hub-back" :description description)))
          (is (hub-install (hub-offer "nl-hub-back" git commit :description description) root))
          (is (= 1 (seal-fixture (nlk::folder-key))))
          (is (nlk:uninstall-cell "nl-hub-back" :root root))
          (is (search "nl-hub-back installed" (format nil "~{~a~%~}" (nlk:restore-generation 1))))
          (let ((folder (merge-pathnames "nl-hub-back/" root)))
            (is (probe-file (merge-pathnames "nl-hub-back.asd" folder)) "the folder is back")
            (is (equal (list git commit) (uiop:read-file-lines (merge-pathnames ".hub" folder))) "at the generation's pin")))))))

(deftest the-boot-that-runs-a-restore-records-it-and-takes-the-marker (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (with-floor-store (sid "restored")
      (let ((nlk::*generation-session-id* sid))
        (is (= 1 (seal-fixture key)))
        (is (null (nlk:take-restoring-marker)) "nothing to take")
        (nlk:restore-generation 1)
        (is (probe-file (nlk::restoring-path)))
        (is-carrying (text (nlk:take-restoring-marker)) ("restored generation 1" "the line for the boot to say"))
        (is (= 1 (count-session-events sid "organism.generation_restored")) "the fact")
        (is (null (probe-file (nlk::restoring-path))) "the marker is gone")
        (is (null (nlk:take-restoring-marker)) "and taken once")))))

(deftest rollback-converges-then-takes-the-one-idle-exit-once (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (let ((exited '()))
      (is (= 1 (seal-fixture key)))
      (with-saved-globals ((nle::*restart-wait* nil) (nle::*idle-poll-seconds* 0.05)
                           (nle::*restart-exit* (lambda (to) (push to exited))))
        (with-stubbed-fdefinition (nlk:any-active-turn-p () nil)
          (is-carrying (text (nle:rollback 1 :restart t))
            ("generation 1") ("exits once no turn is in flight"))
          ;; a restore moves the operator's side alone and holds nothing: the
          ;; poller carries the kernel's side forward over it
          (is (null (nle::held-release)) "no hold")
          (bt2:join-thread nle::*restart-wait*)
          (is (equal '("generation 1") exited) "once")
          (is (search "the next launch runs it" (nle:rollback 1 :restart nil)) "the command line's form, no exit")
          (is (equal '("generation 1") exited)))))))

;;; --- roster read cost: shared facts, exact path history -----------------------

(deftest generation-list-shares-history-without-dropping-path-keeps ()
  (let ((root #P"/tmp/generation-history-fixture/")
        (path-reads 0) (keep-reads 0) (subject "kept alpha") (keep-path "alpha/"))
    (flet ((manifest (number revision)
             (nlk:json-object "number" number "binary" (nlk:json-object "version" "1")
                              "rows" (map 'vector #'nlk::row-json
                                          (loop for name in '("alpha" "beta")
                                                collect (list :name name :kind "cell" :origin "own"
                                                              :revision revision))))))
      (let ((manifests (list (manifest 3 "c") (manifest 2 "b") (manifest 1 "a"))))
        (with-stubbed-fdefinition (nlk::folder-repository (row)
                                    (values root (format nil "~a/" (getf row :name))))
          (with-stubbed-fdefinition (nlk::git-in-layer (directory &rest args)
                                      (is (equal root directory))
                                      (cond ((member "--name-only" args :test #'equal)
                                             (incf path-reads)
                                             (values (format nil "alpha/a space.lisp~c" #\Null) 0))
                                            (t (incf keep-reads)
                                               (is (equal keep-path (car (last args))) "untouched beta needs no per-path log")
                                               (values (format nil "c123456~c~a" #\Tab subject) 0))))
            (let ((deltas (nlk::generation-deltas manifests)))
              (is (equal '((("alpha" ((:sha "c123456" :subject "kept alpha"))) ("beta" nil))
                           (("alpha" ((:sha "c123456" :subject "kept alpha"))) ("beta" nil)) nil)
                         (mapcar (lambda (changes)
                                   (mapcar (lambda (change)
                                             (list (getf (getf change :row) :name) (getf change :keeps))) changes))
                                 deltas)) "all moved rows and exact keep subjects survive")
              (is (= 2 path-reads) "one touched-path read per root range, not one per cell")
              (is (= 2 keep-reads) "only the touched cell takes the exact capped Git query"))
            (setf subject "fresh history")
            (is (equal "fresh history"
                       (getf (first (getf (first (first (nlk::generation-deltas manifests))) :keeps)) :subject)) "the memo is per roster read, not persistent")
            (setf keep-path "alpha*/")
            (is (equal '((:sha "c123456" :subject "fresh history"))
                       (nlk::folder-keeps root keep-path "a" "b" (make-hash-table :test #'equal))) "Git still interprets nonliteral pathspecs")))))))

(deftest generation-self-read-shares-repository-facts-but-not-folder-digests ()
  (with-cell-fixture (root)
    (write-layer-folder root "alpha" '(("probe" . "(defun alpha-probe () :alpha)")))
    (write-layer-folder root "beta" '(("probe" . "(defun beta-probe () :beta)")))
    (is (nlk:git-commit-all root "base"))
    (let ((heads 0) (trees 0) (statuses 0))
      (with-stubbed-fdefinitions ((nlk::git-head-sha (directory)
                                    (incf heads) (make-string 40 :initial-element #\a))
                                  (nlk::git-tree-hash (directory)
                                    (incf trees) (make-string 40 :initial-element #\b))
                                  (nlk::git-dirty-p (directory) (incf statuses) t))
        (let ((rows (nlk:self-rows root)))
          (is (= 2 (length rows)))
          (is (equal '(1 1 1) (list heads trees statuses)))
          (is (every (lambda (row) (and (equal (make-string 40 :initial-element #\a) (getf row :revision))
                                       (equal (make-string 40 :initial-element #\b) (getf row :tree))
                                       (stringp (getf row :dirty)))) rows))
          (is (not (equal (getf (first rows) :dirty) (getf (second rows) :dirty))) "each folder still owns its digest"))
        (nlk:self-rows root)
        (is (equal '(2 2 2) (list heads trees statuses)) "a later read gets fresh repository facts")))))

(deftest generation-history-prefilter-preserves-caps-undo-and-merge-paths (with-warm-fixture (key root cache))
  (let* ((layer (merge-pathnames "nl-warm/" root))
         (pathspec "alpha space/")
         (file (merge-pathnames "alpha space/模型 file.lisp" layer)))
    (write-temp-file file "base")
    (is (nlk:git-commit-all layer "base"))
    (let ((base (nlk::git-head-sha layer))
          (branch (nlk::git-in-layer layer "symbolic-ref" "--short" "HEAD")))
      (loop for i from 1 to 3 do
        (write-temp-file file (format nil "alpha ~d" i))
        (is (nlk:git-commit-all layer (format nil "alpha ~d" i))))
      (write-temp-file (merge-pathnames "alpha-neighbor/probe.lisp" layer) "neighbor")
      (is (nlk:git-commit-all layer "neighbor"))
      (let ((end (nlk::git-head-sha layer)) (history (make-hash-table :test #'equal)))
        (let ((nlk::+changes-keep-cap+ 2))
          (is (equal '("alpha 2" "alpha 3")
                     (mapcar (lambda (keep) (getf keep :subject))
                             (nlk::folder-keeps layer pathspec base end history))))
          (let ((back (nlk::folder-keeps layer pathspec end base history)))
            (is (equal '("alpha 3" "alpha 2") (mapcar (lambda (keep) (getf keep :subject)) back)))
            (is (every (lambda (keep) (and (getf keep :undone) (getf keep :sha))) back))))
        (is (null (nlk::folder-keeps layer "untouched/" base end history)))
        (is (= 1 (hash-table-count history)) "one symmetric range, even across undo and another path"))
      (is (eql 0 (nth-value 1 (nlk::git-in-layer layer "switch" "-c" "side" base))))
      (write-temp-file (merge-pathnames "alpha space/side file.lisp" layer) "side")
      (is (nlk:git-commit-all layer "alpha side"))
      (is (eql 0 (nth-value 1 (nlk::git-in-layer layer "switch" branch))))
      (is (eql 0 (nth-value 1 (nlk::git-in-layer layer "merge" "--no-ff" "side" "-m" "merge side"))))
      (let* ((merged (nlk::git-head-sha layer))
             (exact (nlk::folder-keeps layer pathspec base merged))
             (filtered (nlk::folder-keeps layer pathspec base merged (make-hash-table :test #'equal))))
        (is (find "alpha side" exact :key (lambda (keep) (getf keep :subject)) :test #'equal))
        (is (every (lambda (keep) (and (getf keep :sha) (getf keep :subject))) exact))
        (is (equal exact filtered) "the optimization retains Git's exact merge/path simplification")))))

(deftest generation-list-route-reads-current-and-deltas-only-once ()
  (let* ((manifest (nlk:json-object "number" 1 "sealed_at" "2026-10-12T00:00:00Z"
                                   "binary" (nlk:json-object "version" "1") "rows" #()))
         (identities 0) (deltas 0)
         (nle::*gateway-operator-token* "generation-fixture")
         (headers (nlk:json-object "authorization" "Bearer generation-fixture")))
    (with-stubbed-fdefinitions ((nlk:manifests () (list manifest))
                                (nlk:self-rows (&optional root) '())
                                (nlk:self-identity (&optional rows) (incf identities) :fixture)
                                (nlk:sealed-generation (&optional identity manifests) manifest)
                                (nlk::generation-deltas (manifests) (incf deltas) (list nil)))
      (let* ((response (nle::handle-gateway-generations-http (list :request-method :get :headers headers)))
             (body (nlk:decode-json (babel:octets-to-string (third response) :encoding :utf-8))))
        (is (= 200 (first response)))
        (is (equal '(1 1) (list identities deltas)) "the folder and the deltas are read once")
        (is (eql 1 (nlk:json-value body :integer "now")))
        (is (zerop (length (nlk:json-array body "edits"))))
        (is-present (change (aref (nlk:json-array body "changes") 0)) "one change, the first seal"
          (is (equal "first" (nlk:json-value change :string "kind")))
          (is (equal "First generation" (nlk:json-value change :string "title"))))))))

;;; --- the restore, read ahead ---------------------------------------------------

(defun steps-row (name origin revision &rest more)
  (list* :name name :kind "cell" :origin origin :revision revision more))

(deftest a-restore-steps-each-folder-and-leaves-a-checkout-where-it-stands ()
  ;; A folder whose repository holds more than it -- a dev box's shipped cells
  ;; in its nodecode checkout -- stays where it stands whatever the generation
  ;; had; uncommitted edits in a repository of its own hold the restore and
  ;; say where it moves after; what nothing can put back refuses by name.
  (let ((steps (nlk:restore-steps
                4
                (list (steps-row "layer" "own" "a1" :tree "t1")
                      (steps-row "shipped" "release" "0.1")
                      (steps-row "kit" "own" "c1" :tree "ct1")
                      (steps-row "gone" "own" "g1")
                      (steps-row "plain" "digest" "d1"))
                (list (steps-row "layer" "own" "a2" :tree "t2" :dirty "sha256:x")
                      (steps-row "shipped" "own" "c2" :tree "ct2" :checkout "/src/nodecode/")
                      (steps-row "kit" "own" "c2" :tree "ct2" :checkout "/src/nodecode/" :dirty "sha256:y")
                      (steps-row "plain" "digest" "d2")
                      (steps-row "new" "own" "n1" :tree "nt")))))
    (is (equal '((:edits "layer" "a1") (:stays "shipped" "/src/nodecode/") (:stays "kit" "/src/nodecode/"))
               (subseq steps 0 3)) "a checkout's dirt holds nothing")
    (is (equal '("layer") (nlk:step-edits steps)))
    (is-carrying (text (format nil "~{~a~%~}" (nlk:step-refusals steps)))
      ("gone is gone, and generation 4 had it as an own folder at g1" "an own folder")
      ("plain is a plain folder" "content nothing versions"))
    (is (equal '(:uninstall "new") (car (last steps))))
    (let ((nlk::*binary-version* "0.0.1+bbbbbbbbb"))
      (is-carrying (text (format nil "~{~a~%~}" (nlk:plan-lines steps 4 :version "0.0.1+aaaaaaaaa")))
        ("layer to a1, once its uncommitted edits are kept or discarded" "where the layer moves after")
        ("nodecode stays at bbbbbbb; generation 4 ran aaaaaaa" "the binary follows no checkout")
        ("shipped and kit stay where the checkout at /src/nodecode has them" "one line a checkout")
        ("new stays: it is yours" "what the installer did not put there stays")))
    (is (equal '((:keep "kit" nil))
               (nlk:restore-steps 4 (list (steps-row "kit" "own" "c1" :tree "ct1"))
                                  (list (steps-row "kit" "own" "c9" :tree "ct1" :checkout "/src/")))) "a checkout already at the tree is kept")))

(deftest a-restore-keeps-a-shipped-folder-on-the-release-the-binary-runs ()
  ;; The binary and its shipped folders are the kernel's side: going back to a
  ;; generation that ran another release moves none of it, and says the
  ;; binary stays.
  (let ((steps (nlk:restore-steps 4 (list (steps-row "shipped" "release" "0.1"))
                                  (list (steps-row "shipped" "release" "0.2")))))
    (is (equal '((:keep "shipped" nil)) steps))
    (let ((nlk::*binary-version* "0.0.1+bbbbbbbbb"))
      (is (equal '("nodecode stays at bbbbbbb; generation 4 ran aaaaaaa")
                 (nlk:plan-lines steps 4 :version "0.0.1+aaaaaaaaa"))))))

(deftest a-restore-leaves-a-checkout-and-its-head-where-they-stand (with-warm-fixture (key root cache))
  ;; The folder sits in a repository that holds more than it, as a dev box's
  ;; shipped cells sit in its nodecode checkout: going back never runs
  ;; read-tree there, nor commits, and says so.
  (with-prover-fixture (prover)
    (is (nlk:git-commit-all root "base") "the cells root is a checkout")
    (is (= 1 (seal-fixture (nlk::folder-key))))
    (is (getf (first (nlk:self-rows)) :checkout) "the row knows its checkout")
    (write-temp-file (merge-pathnames "nl-warm/fresh.lisp" root) (evolved-source "(defun cells-probe-fresh () :fresh)"))
    (is (nlk:git-commit-all root "fresh"))
    (is (= 2 (seal-fixture (nlk::folder-key))))
    (let ((head (nlk::git-head-sha root)))
      (is-carrying (text (format nil "~{~a~%~}" (nlk:restore-generation 1)))
        ("nl-warm stays where the checkout at" "said") ("never moves a checkout"))
      (is (equal head (nlk::git-head-sha root)) "no commit in the checkout")
      (is (probe-file (merge-pathnames "nl-warm/fresh.lisp" root)) "and its files as they were"))))

;;; --- uncommitted edits: kept, or set aside --------------------------------------

(deftest uncommitted-edits-hold-the-restore-until-kept-and-the-keep-seals (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (let ((layer (merge-pathnames "nl-warm/" root)))
      (is (nlk:git-commit-all layer "A"))
      (is (= 1 (seal-fixture (nlk::folder-key))))
      (write-temp-file (merge-pathnames "fresh.lisp" layer) (evolved-source "(defun cells-probe-fresh () :fresh)"))
      (write-temp-file (merge-pathnames ".ledger/seen.json" layer) "{}")
      (is (equal '("nl-warm") (mapcar (lambda (row) (getf row :name)) (nlk:edits-rows (nlk:self-rows)))))
      (is (equal '("?? fresh.lisp") (nlk:edit-paths layer)) "a dot-directory is no edit")
      (is (search "nl-warm has uncommitted edits; keep or discard them first"
                  (refusal-text error (nlk:restore-generation 1))))
      (multiple-value-bind (sha verdict number) (nlk:keep-edits "nl-warm")
        (is (= 7 (length sha)) "one commit")
        (is (equal '(:sealed 2) (list verdict number)) "proved, and sealed as the next generation"))
      (is (equal nlk::+kept-edits-subject+ (nlk::git-in-layer layer "log" "-1" "--format=%s")))
      (is (null (nlk:edit-paths layer)) "nothing uncommitted is left")
      (is (zerop (length (nlk::git-in-layer layer "ls-files" ".ledger"))) "the ledger never went in")
      (is (search "nl-warm at" (first (nlk:restore-generation 1))) "the restore goes"))))

(deftest discarded-edits-go-into-the-stash-and-the-ledger-stays (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (let ((layer (merge-pathnames "nl-warm/" root)))
      (is (nlk:git-commit-all layer "A"))
      (write-temp-file (merge-pathnames "fresh.lisp" layer) "(fresh)")
      (write-temp-file (merge-pathnames ".ledger/seen.json" layer) "{}")
      (is (eql 1 (nlk:discard-edits "nl-warm")) "one path set aside")
      (is (null (probe-file (merge-pathnames "fresh.lisp" layer))) "the folder is back at its commit")
      (is (probe-file (merge-pathnames ".ledger/seen.json" layer)) "the ledger stays")
      (is (search "discarded from /generations" (nlk::git-in-layer layer "stash" "list")) "git stash pop finds them")
      (is (eql 0 (nlk:discard-edits "nl-warm")) "nothing left to discard"))))

(deftest a-checkouts-edits-are-not-the-sheets-to-keep (with-warm-fixture (key root cache))
  (is (nlk:git-commit-all root "base"))
  (write-temp-file (merge-pathnames "nl-warm/fresh.lisp" root) "(fresh)")
  (is (null (nlk:edits-rows (nlk:self-rows))) "a checkout's dirt holds no restore")
  (is (search "part of the checkout" (refusal-text error (nlk:keep-edits "nl-warm"))))
  (is (search "part of the checkout" (refusal-text error (nlk:discard-edits "nl-warm"))))
  (is (probe-file (merge-pathnames "nl-warm/fresh.lisp" root)) "and nothing moved"))

;;; --- the history ------------------------------------------------------------------

(defun history-manifest (number at &key (version "0.0.1+aaaaaaa") (rows 2))
  (nlk:json-object "format" 1 "number" number "sealed_at" at
                   "binary" (nlk:json-object "version" version)
                   "rows" (coerce (loop repeat rows collect (nlk::row-json (steps-row "x" "own" "r"))) 'vector)))

(defun layer-move (keeps &key (before "r1") (after "r2"))
  (list :change :moved :row (list :name "nl" :kind "layer" :origin "own" :revision after)
        :before (list :name "nl" :kind "layer" :origin "own" :revision before)
        :keeps (mapcar (lambda (subject) (list :sha "abc1234" :subject subject)) keeps)))

(deftest the-history-folds-each-act-into-one-change-in-words ()
  ;; One session's keeps within the hour are one change; a restore's commit
  ;; reads as going back; nodecode moving alone is marked as such; the first
  ;; seal is said by what it held.
  (let* ((manifests (list (history-manifest 7 "2026-10-12T15:00:00Z" :version "0.0.1+bbbbbbb")
                          (history-manifest 6 "2026-10-12T14:00:00Z")
                          (history-manifest 5 "2026-10-12T13:00:00Z")
                          (history-manifest 4 "2026-10-12T12:00:00Z")
                          (history-manifest 3 "2026-10-12T10:10:00Z")
                          (history-manifest 2 "2026-10-12T10:00:00Z")
                          (history-manifest 1 "2026-10-12T09:00:00Z" :rows 9)))
         (builtin-move (list :change :moved :row (list :name "nb-a" :kind "cell" :origin "own" :revision "c2")
                             :before (list :name "nb-a" :kind "cell" :origin "own" :revision "c1")))
         (deltas (list (list (list :change :binary :from "0.0.1+aaaaaaa" :to "0.0.1+bbbbbbb") builtin-move)
                       (list (list :change :moved :row (list :name "nl" :kind "layer" :origin "own" :revision "r3" :dirty "x")
                                   :before (list :name "nl" :kind "layer" :origin "own" :revision "r3")))
                       (list (list :change :added :row (list :name "lsp" :kind "cell" :origin "hub" :revision "h1")))
                       (list (layer-move '("restored generation 2 -- session s-GATEWAY")))
                       (list (layer-move '("b — session s-1" "forgot c — session s-1")))
                       (list (layer-move '("a — session s-1")))
                       nil))
         (history (nlk:generation-history manifests :deltas deltas :builtin '("nb-a")
                                                    :title-of (lambda (id) (if (equal id "s-1") "Fix the bug" "")))))
    (is (equal '(("nodecode" 7 7) ("edits" 6 6) ("install" 5 5) ("restore" 4 4) ("agent" 2 3) ("first" 1 1))
               (mapcar (lambda (change) (list (getf change :kind) (getf change :from) (getf change :to))) history)) "newest first, one session's keeps within the hour folded")
    (destructuring-bind (nodecode edits install restore agent first) history
      (is (equal "nodecode aaaaaaa → bbbbbbb" (getf nodecode :title)))
      (is (getf nodecode :nodecode) "nodecode alone moved")
      (is (equal "1 built-in cells" (getf nodecode :where)))
      (is (equal "Uncommitted edits in nl" (getf edits :title)))
      (is (equal "Installed lsp" (getf install :title)))
      (is (equal "a hub install" (getf install :where)))
      (is (equal "Went back to generation 2" (getf restore :title)))
      (is (equal "Kept a, b · forgot c" (getf agent :title)))
      (is (equal "“Fix the bug”" (getf agent :where)) "where the keeps were made")
      (is (equal '("a" "b" "forgot c") (getf agent :keeps)))
      (is (null (getf agent :nodecode)))
      (is (equal "First generation" (getf first :title)))
      (is (equal "9 folders · nodecode aaaaaaa" (getf first :where))))
    (let ((kept (first (nlk:generation-history (subseq manifests 4)
                                               :deltas (list (list (layer-move (list nlk::+kept-edits-subject+)))
                                                             nil nil)
                                               :title-of (constantly "")))))
      (is (equal "Kept the uncommitted edits" (getf kept :title)) "the edits a keep from the sheet committed")
      (is (equal "from /generations" (getf kept :where))))))

(deftest the-sealed-count-reads-the-manifests-again-only-when-the-directory-moves ()
  ;; The home screen says the count every frame: one stat of the directory,
  ;; and the manifests decoded again only once it moved. A count read in the
  ;; second the directory last moved is never kept, since a seal later in that
  ;; second leaves the stat as it was.
  (labels ((seal (number)
             (nlk::write-file-atomically
              (nlk::manifest-path number)
              (nlk::pretty-json (nlk:json-object "format" nlk::+manifest-format+ "number" number "rows" #()))))
           (stamp (seconds)
             (sb-posix:utimes (sb-ext:native-namestring (nlk:generations-directory)) seconds seconds)))
    (let ((reads 0)
          (past (- (sb-ext:get-time-of-day) 60))
          (ahead (+ (sb-ext:get-time-of-day) 60)))
      (with-stubbed-fdefinition (nlk:manifests () (incf reads) (funcall original))
        (is (zerop (nlk:manifest-count)) "no directory, nothing sealed")
        (seal 1)
        (seal 2)
        (stamp past)
        (is (= 2 (nlk:manifest-count)))
        (is (= 2 (nlk:manifest-count)))
        (is (= 2 reads) "a directory that has not moved is not read again")
        (seal 3)
        (stamp past)
        (is (= 2 (nlk:manifest-count)) "the stat the count was read at")
        (stamp (1+ past))
        (is (= 3 (nlk:manifest-count)) "the directory moved: read again")
        (stamp ahead)
        (is (= 3 (nlk:manifest-count)))
        (seal 4)
        (stamp ahead)
        (is (= 4 (nlk:manifest-count)) "a stat not yet in the past is never kept")
        (is (= 5 reads))))))

;;; --- the bytes a seal keeps, and a generation laid beside the folder ----------
;;; What no repository can put back is kept whole, so a generation can be laid
;;; somewhere else exactly while the folder it was read from stays put.

(defun file-mode (path)
  (logand #o777 (sb-posix:stat-mode (sb-posix:stat (namestring path)))))

(deftest a-kept-folder-is-laid-back-whole (with-warm-fixture (key root cache))
  (let ((folder (merge-pathnames "nl-warm/" root)))
    (write-temp-file (merge-pathnames "deep/inner.lisp" folder) "(in-package #:nodecode.evolved)")
    (write-temp-file (merge-pathnames "run.sh" folder) "#!/bin/sh")
    (sb-posix:chmod (namestring (merge-pathnames "run.sh" folder)) #o755)
    (let ((digest (nlk::tree-digest folder :keep t)))
      (is (equal (nlk::tree-digest folder) digest) "keeping a folder takes the digest the plain read takes")
      (with-temp-trees ((elsewhere "laid"))
        (let ((target (merge-pathnames "copy/" elsewhere)))
          (nlk::lay-tree digest target)
          (is (equal digest (nlk::tree-digest target)) "the folder laid digests the same")
          (is (probe-file (merge-pathnames "deep/inner.lisp" target)) "a subfolder comes back")
          (is (= #o755 (file-mode (merge-pathnames "run.sh" target))) "and a file's mode")
          (is (signals-error error (nlk::lay-tree digest target)) "never over a folder that stands")
          (is (signals-error error (nlk::lay-tree (nlk::tree-digest elsewhere) (merge-pathnames "none/" elsewhere))) "a digest nothing was kept under refuses"))))))

(deftest the-seal-keeps-the-bytes-no-commit-puts-back (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (let ((layer (merge-pathnames "nl-warm/" root)))
      (flet ((newest-row () (first (nlk::manifest-rows (first (nlk:manifests))))))
        (is (= 1 (seal-fixture key)))
        (is-present (row (newest-row)) "a plain folder's row"
          (is (equal (getf row :revision) (getf row :bytes)) "nothing versions it, so its bytes are kept"))
        (is (nlk:git-commit-all layer "A"))
        (is (= 2 (seal-fixture (nlk::folder-key))))
        (is-present (row (newest-row)) "a repository at its commit"
          (is (equal "own" (getf row :origin)))
          (is (null (getf row :bytes)) "its commit puts it back: no bytes"))
        (write-temp-file (merge-pathnames "edit.lisp" layer) (evolved-source "(defun cells-probe-edit () :edit)"))
        (is (= 3 (seal-fixture (nlk::folder-key))))
        (is-present (row (newest-row)) "a repository with uncommitted edits"
          (is (getf row :dirty))
          (is (equal (getf row :dirty) (getf row :bytes)) "its edits are kept whole, under the digest it carries"))
        (is (equal '() (nlk::manifest-rows (first (nlk:manifests)) "memory")) "no knowledge folder, no memory row")
        (write-temp-file (merge-pathnames "nl-memory/nl-memory.asd" root)
                         "(defsystem \"nl-memory\" :class nodecode.kernel:layer :properties ((:knowledge . t)) :components nil)")
        (write-temp-file (merge-pathnames "nl-memory/kept.lisp" root) "(in-package :nodecode.evolved)")
        (is (eq :current (nlk:prove-self (nlk::folder-key))) "a knowledge folder is no identity: nothing seals")
        (write-temp-file (merge-pathnames "edit.lisp" layer) (evolved-source "(defun cells-probe-edit () :again)"))
        (is (= 4 (seal-fixture (nlk::folder-key))))
        (is-present (memory (first (nlk::manifest-rows (first (nlk:manifests)) "memory"))) "the memory beside the rows"
          (is (equal "nl-memory" (getf memory :name)))
          (is (equal (getf memory :revision) (getf memory :bytes)) "kept, as a plain folder is"))))))

(defun drop-kept-bytes (number)
  "Rewrite generation NUMBER's manifest as a seal before kept bytes wrote it."
  (let* ((path (nlk::manifest-path number))
         (manifest (nlk::json-object-file path)))
    (loop for row across (gethash "rows" manifest) do (remhash "bytes" row))
    (nlk::write-file-atomically path (nlk::pretty-json manifest))))

(deftest a-generation-is-laid-beside-the-folder-it-stands-in (with-warm-fixture (key root cache))
  (with-prover-fixture (prover)
    (let ((layer (merge-pathnames "nl-warm/" root)))
      (is (nlk:git-commit-all layer "A"))
      (is (= 1 (seal-fixture (nlk::folder-key))))
      (write-temp-file (merge-pathnames "fresh.lisp" layer) (evolved-source "(defun cells-probe-fresh () :fresh)"))
      (is (nlk:git-commit-all layer "B"))
      (write-cell-folder root "nl-plain" '(("lib" . "(in-package #:nodecode.evolved)")))
      (is (= 2 (seal-fixture (nlk::folder-key))))
      (with-temp-trees ((side "side"))
        (multiple-value-bind (target notes) (nlk:build-generation 1 (merge-pathnames "g1/" side))
          (is (probe-file (merge-pathnames "nl-warm/probe.lisp" target)) "the layer at generation 1's commit")
          (is (null (probe-file (merge-pathnames "nl-warm/fresh.lisp" target))) "without the keep after it")
          (is (null (probe-file (merge-pathnames "nl-plain/" target))) "and without a folder it never had")
          (is (null notes) "every row laid as generation 1 had it"))
        (is (probe-file (merge-pathnames "fresh.lisp" layer)) "the folder it was built beside has not moved")
        (is (equal "B" (nlk::git-output layer "log" "-1" "--format=%s")) "nor its repository")
        (write-temp-file (merge-pathnames "nl-plain/late.lisp" root) "(in-package #:nodecode.evolved)")
        (multiple-value-bind (target notes) (nlk:build-generation 2 (merge-pathnames "g2/" side))
          (is (probe-file (merge-pathnames "nl-warm/fresh.lisp" target)) "the layer at 2's commit")
          (is (probe-file (merge-pathnames "nl-plain/lib.lisp" target)) "a plain folder from its kept bytes")
          (is (null (probe-file (merge-pathnames "nl-plain/late.lisp" target))) "as 2 had it, not as it stands")
          (is (null notes)))
        (drop-kept-bytes 2)
        (multiple-value-bind (target notes) (nlk:build-generation 2 (merge-pathnames "g2-old/" side))
          (is (probe-file (merge-pathnames "nl-plain/late.lisp" target)) "no bytes kept: the folder as it stands")
          (is-carrying (text (format nil "~{~a~%~}" notes))
            ("nl-plain as it stands today" "and the line says so") ("kept only its digest")))
        (is (signals-error error (nlk:build-generation 1 (merge-pathnames "g1/" side))) "never over a folder that stands")))))

(deftest a-trial-runs-under-a-throwaway-home ()
  (with-temp-trees ((home "throwaway"))
    (with-temp-file (child :type "sh" :contents (format nil "#!/bin/sh
cat > /dev/null
if [ -n \"$NODECODE_HOME\" ] && [ -d \"$NODECODE_HOME\" ]; then printf '%s|%s|%s\\n' \"$NODECODE_HOME\" \"$HOME\" \"$XDG_CACHE_HOME\" > \"$NODECODE_HOME/seen\"; fi
echo 'nodecode-trial-score 7'~%"))
      (let ((nlk::*organism-command* (list "/bin/sh" child))
            (root (string-right-trim "/" (namestring home))))
        (is (equal '(7 "scored") (multiple-value-list (nlk:trial "(+ 3 4)" :home home))) "the child's number")
        (is (equal (format nil "~a/|~a|~a/cache~%" root root root) (uiop:read-file-string (merge-pathnames "seen" home))) "its home, HOME and cache all the throwaway's")
        (is (search "\"off\"" (uiop:read-file-string (merge-pathnames "config.jsonc" home))) "a home with no config runs with updates off"))
      (let ((nlk::*organism-command* nil))
        (with-stubbed-fdefinition (nlk::organism-binary-p () nil)
          (is (equal '(nil "no organism binary to spawn: a developer image runs no trial") (multiple-value-list (nlk:trial "1"))) "no binary, no trial, and why"))))))
