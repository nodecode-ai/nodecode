;;;; profile-delete-test.lisp --- the roster's destructive gesture.
;;;; SPDX-License-Identifier: MIT

(in-package #:nodecode.test)

(deftest profiles-delete-hotkeys-confirm-and-refresh ()
  (with-frame-model (model 120 32 :session-id "profile-delete")
    (dolist (chord '((:delete) (#\x :ctrl t)))
      (nlk:profile-create "erasable" :clone :blank)
      (nlk:profile-use "erasable")
      (nle::open-profiles-picker model :seat "erasable")
      (let ((roster (nle::chat-model-dialog model)))
        (is (nle::picker-dialog-on-delete roster) "the roster advertises the shared destructive gesture")
        (is (search "ctrl+x" (nle::picker-dialog-hint roster)) "the footer makes the chord discoverable")
        (apply #'nle::picker-dialog-key model chord)
        (let ((confirm (nle::chat-model-dialog model)))
          (is (not (eq roster confirm)) "the hotkey opens confirmation, not deletion")
          (is (equal "Delete profile" (nle::picker-dialog-title confirm)))
          (is (equal :cancel (nle::picker-highlighted-value confirm)) "Enter alone defaults to safety")
          (is-carrying (warning (nle::picker-dialog-subtitle confirm))
            ("whole home" "the destructive scope is explicit")
            ("store" "history is included")
            ("secrets" "credentials are included")))
        (is (nlk:find-profile "erasable") "the home survives until explicit confirmation")
        (dialog-keys model :down :enter)
        (is (null (nlk:find-profile "erasable")) "the confirmed home is gone")
        (is (null (probe-file nlk:*active-profile-path*)) "the canonical owner clears its sticky default")
        (is (eq roster (nle::chat-model-dialog model)) "the roster returns")
        (is (null (find "erasable" (nle::picker-dialog-rows roster) :key #'nle::picker-row-value :test #'equal)) "the deleted row is gone")
        (is (search "deleted erasable" (nle::status-said model)) "success is recorded")
        (is (some (lambda (row) (search "deleted erasable" row)) (nle::dialog-panel-rows model 120 nil)) "success paints inside the still-open roster")))))

(deftest profiles-delete-cancel-keeps-search-and-seat ()
  (nlk:profile-create "keep-me" :clone :blank)
  (with-frame-model (model 120 32 :session-id "profile-delete-cancel")
    (nle::open-profiles-picker model)
    (let ((roster (nle::chat-model-dialog model)))
      (nle::picker-search-mutate roster "keep-me")
      (dolist (cancel '(:escape :enter))
        (dialog-keys model :delete cancel)
        (is (eq roster (nle::chat-model-dialog model)) "cancel returns to the same roster")
        (is (equal "keep-me" (nle::picker-dialog-search roster)) "the query is retained")
        (is (equal "keep-me" (nle::picker-highlighted-value roster)) "the selected row is retained")
        (is (nlk:find-profile "keep-me") "cancel leaves the whole home intact")))))

(deftest profiles-delete-refuses-protected-homes ()
  (nlk:profile-create "protected" :clone :blank)
  (with-frame-model (model 120 32 :session-id "profile-delete-protected")
    (flet ((refused (seat said why &rest chord)
             (nle::open-profiles-picker model :seat seat)
             (let ((roster (nle::chat-model-dialog model)))
               (apply #'nle::picker-dialog-key model (or chord '(:delete)))
               (is (eq roster (nle::chat-model-dialog model)) why)
               (is (search said (nle::status-said model))))))
      (refused "default" "default profile" "default is refused before any confirmation")
      (is (some (lambda (row) (search "default profile" row)) (nle::dialog-panel-rows model 120 nil)) "the refusal paints inside the still-open roster")
      (let ((nlk:*home* (nlk:profile-home "protected")))
        (refused "protected" "own profile" "the current home is refused before confirmation"))
      (with-stubbed-fdefinition (nlk::store-death-verdict (path)
                                 (if (equal path (nlk::home-store-path (nlk:profile-home "protected")))
                                     (values :live (sb-posix:getpid) 12345)
                                     :absent))
        (refused "protected" "served by pid" "a serving home is refused before confirmation"
                 #\x :ctrl t)))
    (is (nlk:find-profile "protected") "all refusals preserve the home")))

(deftest profiles-delete-rechecks-the-owner-at-confirmation ()
  (nlk:profile-create "raced" :clone :blank)
  (with-frame-model (model 120 32 :session-id "profile-delete-race")
    (nle::open-profiles-picker model :seat "raced")
    (let ((roster (nle::chat-model-dialog model)))
      (nle::picker-dialog-key model :delete)
      (with-stubbed-fdefinition (nlk::store-death-verdict (path)
                                 (if (equal path (nlk::home-store-path (nlk:profile-home "raced")))
                                     (values :live (sb-posix:getpid) 12345)
                                     :absent))
        (dialog-keys model :down :enter))
      (is (eq roster (nle::chat-model-dialog model)) "a late refusal restores the roster")
      (is (search "served by pid" (nle::status-said model)) "the canonical refusal is visible")
      (is (nlk:find-profile "raced") "a newly serving home is not removed"))))

(deftest profiles-delete-ignores-actions-and-empty-search ()
  (with-frame-model (model 120 32 :session-id "profile-delete-no-row")
    (nle::open-profiles-picker model :seat nle::+new-profile-action+)
    (let ((roster (nle::chat-model-dialog model)))
      (nle::picker-dialog-key model :delete)
      (is (eq roster (nle::chat-model-dialog model)) "New profile is not a deletable home")
      (nle::picker-search-mutate roster "zzzzzz-no-profile")
      (nle::picker-dialog-key model #\x :ctrl t)
      (is (eq roster (nle::chat-model-dialog model)) "an empty filter has no deletion target")
      (is (equal "zzzzzz-no-profile" (nle::picker-dialog-search roster)) "Ctrl+X is never search input"))))
