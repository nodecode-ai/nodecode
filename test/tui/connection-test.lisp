;;;; connection-test.lisp --- the footer's model name, green or red: the terms a host answers for,
;;;; the verdict a measured connection reads, one check a model pick, and the box /privacy opens.
;;;; SPDX-License-Identifier: MIT
(in-package #:nodecode.test)

(defparameter +connection-tls+
  '(:tls "TLSv1.3" :group "X25519MLKEM768" :issuer "Google Trust Services" :cloudflare nil :proxy nil)
  "What a direct TLS 1.3 handshake with a post-quantum key exchange measures.")

(defmacro with-connection-scratch ((&key (delays ''())) &body body)
  "BODY with an empty check table, kept measurements in a scratch file, and DELAYS between tries."
  (let ((dir (gensym "DIR")))
    `(let* ((,dir (uiop:ensure-directory-pathname
                   (merge-pathnames (format nil "nc-conn-~36r/" (random (expt 36 8))) (uiop:temporary-directory))))
            (nle::*connection-checks* (make-hash-table :test #'equal))
            (nle::*connection-memory* :unread)
            (nle::*connection-memory-path* (merge-pathnames "connection-checks.sexp" ,dir))
            (nle::*connection-retry-delays* ,delays))
       (unwind-protect (progn ,@body)
         (uiop:delete-directory-tree ,dir :validate t :if-does-not-exist :ignore)))))

(defun connection-verdict-at (provider host &rest facts)
  (nle::connection-verdict provider (list* :host host (append facts +connection-tls+))))

(deftest connection-terms-are-matched-on-the-host ()
  (flet ((name (host) (getf (nle::provider-terms host) :name)))
    (is (equal "NODECODE" (name "api.nodecode.ai")))
    (is (equal "Anthropic" (name "api.anthropic.com")))
    (is (equal "OpenAI" (name "eu.api.openai.com")) "a region under the host")
    (is (equal "Google Vertex" (name "europe-west4-aiplatform.googleapis.com")) "a glob's label")
    (is (equal "AWS Bedrock" (name "bedrock-runtime.eu-central-1.amazonaws.com")))
    (is (null (name "s3.eu-central-1.amazonaws.com")) "the same cloud, another service")
    (is (null (name "api.anthropic.com.example.net")) "a suffix only on a dot")
    (is (null (name "reseller.example")) "a host on no row is unknown")))

(deftest connection-reads-private-only-for-nodecodes-own-endpoint ()
  (let ((own (connection-verdict-at "nodecode" "api.nodecode.ai")))
    (is (eq :private (getf own :level)))
    (is (equal "Private" (getf own :label)))
    (is (eq :success (nle::connection-level-tone (getf own :level))) "green")
    (is (equal '((:ok "TLS 1.3 · PQC, not intercepted")
                 (:ok "Readable by NODECODE · DE → NL · EU")
                 (:ok "Not kept, linked to country and billing only")
                 (nil "nodecode.ai/privacy · 2026-10"))
               (getf own :rows)) "four lines, every one ours to promise"))
  (let ((fronted (connection-verdict-at "nodecode" "api.nodecode.ai" :cloudflare t)))
    (is (eq :not-private (getf fronted :level)) "Cloudflare in front reads the prompt too")
    (is (equal '(:no "Readable by Cloudflare, NODECODE · DE → NL · EU") (second (getf fronted :rows))))))

(deftest connection-groups-a-providers-terms-a-line-a-problem ()
  ;; Asked 2026-10-27: "too verbose" -- the problems grouped, a line each, no row for what is fine.
  (let ((api (connection-verdict-at "anthropic" "api.anthropic.com" :cloudflare t)))
    (is (eq :not-private (getf api :level)))
    (is (equal "Not private" (getf api :label)))
    (is (eq :danger (nle::connection-level-tone (getf api :level))) "red")
    (is (equal '((:ok "TLS 1.3 · PQC, not intercepted")
                 (:no "Readable by Cloudflare, Anthropic · US")
                 (:no "Kept 30 days, linked to your account (ZDR: enterprise only)")
                 (nil "privacy.anthropic.com · 2026-10"))
               (getf api :rows)) "terms that say no training get no training line"))
  (let ((rows (getf (connection-verdict-at "deepseek" "api.deepseek.com") :rows)))
    (is (member '(:no "Kept with no time limit, linked to your account (no ZDR)") rows :test #'equal))
    (is (member '(:claim "Training on your prompts: unknown") rows :test #'equal) "unknown training is a ?"))
  ;; A subscription reaching the same host signs a plan's terms, not the API's.
  (let ((plan (connection-verdict-at "claude-code" "api.anthropic.com")))
    (is (eq :not-private (getf plan :level)))
    (is (equal '((:ok "TLS 1.3 · PQC, not intercepted")
                 (:no "Readable by Anthropic · US")
                 (:claim "Your Anthropic plan's terms are not on our list: storage and training unknown"))
               (getf plan :rows)) "no API terms quoted for a plan")))

(deftest connection-off-the-list-is-not-private ()
  (let ((resold (connection-verdict-at "openai" "reseller.example")))
    (is (eq :unknown (getf resold :level)) "a provider's name on a host that is not its own")
    (is (equal "Not private" (getf resold :label)))
    (is (equal '((:ok "TLS 1.3 · PQC, not intercepted")
                 (:no "Readable by reseller.example")
                 (:no "Not on our list: storage, training and route unknown"))
               (getf resold :rows))))
  (let ((local (nle::connection-verdict "ollama" '(:host "127.0.0.1" :local t))))
    (is (eq :local (getf local :level)))
    (is (eq :success (nle::connection-level-tone :local)))
    (is (equal '((:ok "Stays on your machine or network")) (getf local :rows))))
  (let ((plain (nle::connection-verdict "x" '(:host "models.example" :plain t))))
    (is (equal "Not encrypted" (getf plain :label)))
    (is (eq :danger (nle::connection-level-tone (getf plain :level))))
    (is (equal '(:no "Not encrypted: anyone on the way can read it") (first (getf plain :rows)))))
  (let ((offline (nle::connection-verdict "anthropic" '(:host "api.anthropic.com" :error "offline"))))
    (is (eq :unchecked (getf offline :level)))
    (is (null (nle::connection-level-tone (getf offline :level))) "no colour for what was not measured")))

(deftest connection-is-measured-once-a-model-pick (with-temp-store ())
  (with-connection-scratch ()
    (let ((model (make-frame-model 110 40))
          (pick (list "nodecode" "nodecode/cyber-v1"))
          (probes '()))
      (with-stubbed-fdefinitions ((nle::footer-identity (model) (declare (ignore model))
                                    (values (first pick) (second pick) :configured))
                                  (nle::connection-endpoint (provider model) (declare (ignore model))
                                    (if (equal provider "nodecode") "https://api.nodecode.ai/v1/chat/completions"
                                        "https://api.anthropic.com/v1/messages"))
                                  (nle::connection-probe (url &key timeout) (declare (ignore timeout))
                                    (push url probes)
                                    (list* :host (quri:uri-host (quri:uri url)) +connection-tls+)))
        (nle::check-connection model)
        (nle::check-connection model)
        (is (= 1 (length probes)) "a second look at the same pick measures nothing")
        (is (eq :success (nle::connection-identity-tone model)) "the name is green: NODECODE's own")
        (setf pick (list "anthropic" "anthropic/claude-opus-5-5"))
        (nle::check-connection model)
        (is (= 2 (length probes)) "another model is measured once more")
        (is (eq :danger (nle::connection-identity-tone model)) "red for everyone else")
        (nle::execute-slash-command model "privacy" "")
        (let* ((dialog (nle::chat-model-dialog model))
               (rows (nle::picker-dialog-rows dialog))
               (labels (mapcar #'nle::picker-row-label rows)))
          (is (eq :privacy (nle::picker-dialog-kind dialog)))
          (is (equal "anthropic/claude-opus-5-5 · Anthropic — Not private" (first labels)))
          (is (eq :danger (nle::picker-row-tone (first rows))) "the verdict line wears the name's colour")
          (is (equal '("✓" "✗" "✗" " ") (mapcar #'nle::picker-row-mark (rest rows))))
          (is (= 5 (length rows)) "five lines")
          (is (notany (lambda (label) (equal "" label)) labels) "no blank lines")
          (is (>= (nle::docked-dialog-frame-rows model) (length labels)) "the box is read whole")
          (let* ((plain (coerce (nle::frame-plain-rows model) 'list))
                 (title (position-if (lambda (row) (search "Connection" row)) plain))
                 (verdict (position-if (lambda (row) (search "Not private" row)) plain)))
            (is (and title verdict (= 2 (- verdict title))) "the verdict sits one blank under the title, no empty rows between")))))))

(deftest connection-measures-the-endpoint-the-gateway-names (with-temp-store ())
  ;; Asked 2026-10-27, a fresh shell on Claude Code read "Connection unchecked": its lane is
  ;; known where the cell runs, the gateway, never in the shell.
  (with-connection-scratch ()
    (let ((model (make-frame-model 110 40))
          (probes '()))
      (with-stubbed-fdefinitions ((nle::connection-endpoint (provider model) (declare (ignore provider model)) nil)
                                  (nle::connection-probe (url &key timeout) (declare (ignore timeout))
                                    (push url probes)
                                    (list* :host (quri:uri-host (quri:uri url)) +connection-tls+)))
        (land-model-facts model :provider "claude-code" :model "claude-opus-5-5"
                                :endpoint "https://api.anthropic.com/v1/messages")
        (is (equal '("https://api.anthropic.com/v1/messages") probes) "landing the target measures it")
        (is (eq :danger (nle::connection-identity-tone model)))
        (is (equal "Not private" (getf (gethash '("claude-code" . "claude-opus-5-5") nle::*connection-checks*) :label)))))))

(deftest connection-never-keeps-a-check-that-measured-nothing (with-temp-store ())
  (with-connection-scratch (:delays '(0 0))
    (let ((model (make-frame-model 110 40))
          (endpoint nil)
          (fail t)
          (probes 0))
      (with-stubbed-fdefinitions ((nle::footer-identity (model) (declare (ignore model))
                                    (values "deepseek" "deepseek-v4-flash" :configured))
                                  (nle::connection-endpoint (provider model) (declare (ignore provider model)) endpoint)
                                  (nle::chat-model-program (model) (declare (ignore model)) :spawned)
                                  (nle::off-loop (model thunk continuation) (funcall continuation model (funcall thunk)))
                                  (nle::render-state (model) (declare (ignore model)) nil)
                                  (nle::connection-probe (url &key timeout) (declare (ignore timeout))
                                    (incf probes)
                                    (list* :host (quri:uri-host (quri:uri url))
                                           (if fail '(:error "offline") +connection-tls+))))
        (nle::check-connection model)
        (is (zerop probes) "no endpoint yet: nothing to dial")
        (is (null (gethash '("deepseek" . "deepseek-v4-flash") nle::*connection-checks*)) "and nothing kept")
        (setf endpoint "https://api.deepseek.com/chat/completions")
        (nle::check-connection model)
        (is (= 3 probes) "a failed handshake is tried again, once a delay")
        (is (null (nle::connection-identity-tone model)) "no colour for what was not measured")
        (is (null (gethash '("deepseek" . "deepseek-v4-flash") nle::*connection-checks*)) "so the next look tries again")
        (setf fail nil)
        (nle::check-connection model)
        (is (= 4 probes))
        (is (eq :danger (nle::connection-identity-tone model)))))))

(deftest connection-remembers-a-host-for-the-next-shell (with-temp-store ())
  ;; "Optimize it": a shell after the first colours the name before its own handshake lands.
  (with-connection-scratch ()
    (let ((model (make-frame-model 110 40))
          (fail nil)
          (key '("nodecode" . "nodecode/cyber-v1")))
      (with-stubbed-fdefinitions ((nle::footer-identity (model) (declare (ignore model))
                                    (values (car key) (cdr key) :configured))
                                  (nle::connection-endpoint (provider model) (declare (ignore provider model))
                                    "https://api.nodecode.ai/v1/chat/completions")
                                  (nle::connection-probe (url &key timeout) (declare (ignore timeout))
                                    (list* :host (quri:uri-host (quri:uri url))
                                           (if fail '(:error "offline") +connection-tls+))))
        (nle::check-connection model)
        (is (probe-file nle::*connection-memory-path*) "a measurement is kept on disk")
        (is (not (search "#A" (uiop:read-file-string nle::*connection-memory-path*))) "as plain text")
        ;; The next shell: nothing in memory, and its own handshake fails.
        (setf nle::*connection-memory* :unread
              nle::*connection-checks* (make-hash-table :test #'equal)
              fail t)
        (nle::check-connection model)
        (is (eq :private (getf (gethash key nle::*connection-checks*) :level)) "the kept answer colours it at once")
        (is (eq :success (nle::connection-identity-tone model)) "and a failed re-measure leaves it standing")
        (let ((nle::*connection-memory-days* 0))
          (setf nle::*connection-checks* (make-hash-table :test #'equal))
          (nle::check-connection model)
          (is (null (gethash key nle::*connection-checks*)) "a stale one stands in for nothing"))))))

(deftest connection-has-no-knob-in-the-footer (with-temp-store ())
  ;; Asked 2026-10-27: no big dot, no words -- the model name's colour says it.
  (with-connection-scratch ()
    (let ((model (make-frame-model 110 40)))
      (with-stubbed-fdefinition (nle::footer-identity (model) (declare (ignore model))
                                  (values "nodecode" "nodecode/cyber-v1" :configured))
        (flet ((knobless-p ()
                 (notany (lambda (candidate)
                           (or (find '(:command . "privacy") candidate :key #'nle::seg-link :test #'equal)
                               (search "onnection" (nle::segs-text candidate))
                               (search "●" (nle::segs-text candidate))))
                         (nle::footer-right-candidates model))))
          (is (knobless-p) "nothing before the pick is measured")
          (setf (gethash '("nodecode" . "nodecode/cyber-v1") nle::*connection-checks*) :checking)
          (is (knobless-p) "nothing while it is measured")
          (is (null (nle::connection-identity-tone model)) "and the name keeps the footer's own colour")
          (setf (gethash '("nodecode" . "nodecode/cyber-v1") nle::*connection-checks*)
                (connection-verdict-at "nodecode" "api.nodecode.ai"))
          (is (knobless-p) "nothing once it is")
          (is (eq :success (nle::connection-identity-tone model))))))))
