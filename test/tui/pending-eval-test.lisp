;;;; pending-eval-test.lisp --- chronological live-only execution blocks.
;;;; SPDX-License-Identifier: MIT
(in-package #:nodecode.test)

(defun pending-eval-state ()
  (let ((state (bg-state (bg-item-delta 0 "eval" "{\"form\":\"(sleep 600)\"}")
                         (bg-call-fact "pending-call" "{\"form\":\"(sleep 600)\"}" :tool-name "eval")
                         (bg-backgrounding-result "pending-call" 991 "(sleep 600)" "eval"))))
    (setf (gethash "tail_rows" state)
          (append (list (nle::make-transcript-row :text "BEFORE-PENDING" :hydrated t :turn-id "turn-1"))
                  (gethash "tail_rows" state)
                  (list (nle::make-transcript-row :text "AFTER-PENDING" :hydrated t :turn-id "turn-1"))))
    state))

(deftest pending-evals-have-one-chronological-transcript-owner ()
  (dolist (mode '(:standard :developer))
    (let* ((nle::*tool-detail* mode) (nle::*expanded-tool-call* nil) (state (pending-eval-state))
           (live (first (nle::state-background-rows state)))
           (blocks (nle:project-state state :width 90))
           (owners (mapcar #'nle::display-block-row blocks)))
      ;; Standard gives the turn's words one place, under its run: the
      ;; newest, `after'.
      (is (= (if (eq mode :developer) 3 2) (length blocks)) "before, pending call, after")
      (is (<= (count live owners :test #'eq) 1) "never a second copy")
      (if (eq mode :developer)
          (when (= 3 (length blocks))
            (is (eq live (second owners)) "the pending eval owns its call's chronological position")
            (is (eq :live-only (nle::display-block-retention (second blocks))))
            (is (rows-carry-p "pending eval" (nle::display-block-plain-lines (second blocks)))))
          ;; Standard lists the call where it ran, in a run of its own.
          (is (rows-carry-p "in the background" (nle::display-block-plain-lines (first blocks))))))))

(deftest a-background-call-stays-listed-where-it-ran ()
  ;; A call handed off to the background stays where it ran, its output
  ;; streaming under it. Without this, the exec's code block under the run
  ;; would read as the call jumping away.
  (let* ((nle::*tool-detail* :standard) (nle::*expanded-tool-call* nil)
         (done "{\"stdout\":\"\",\"stderr\":\"\",\"exit_code\":0}")
         (state (bg-state (bg-call-fact "before" "{\"command\":\"true\"}")
                          (bg-result-fact "before" "run" done)
                          (bg-item-delta 0 "eval" "{\"form\":\";; Tick a minute\\n(sleep 600)\"}")
                          (bg-call-fact "pending-call" "{\"form\":\";; Tick a minute\\n(sleep 600)\"}" :tool-name "eval")
                          (bg-backgrounding-result "pending-call" 991 "(sleep 600)" "eval")
                          (bg-call-fact "after" "{\"command\":\"true\"}")
                          (bg-result-fact "after" "run" done)))
         (live (first (nle::state-background-rows state))))
    (setf (nle::bg-band-row-output-tail live) (string-octets (format nil "tick 1~%tick 2~%"))
          (nle::bg-band-row-output-seen-lines live) 2)
    (flet ((shown () (nle:project-state state :width 90)))
      (let* ((blocks (shown))
             (rows (nle::display-block-plain-lines (first blocks)))
             (call (position-if (lambda (row) (search "Tick a minute" row)) rows)))
        (is (= 1 (length blocks)) "one run holds every call of the turn")
        (is (rows-carry-p "Ran 3 commands" rows) "and counts the one in the background")
        (is (and call (search "in the background" (nth call rows))) "listed on its line, saying where it runs")
        (is (search "⌎ tick 1" (nth (1+ call) rows)) "its output under it")
        (is (notany (lambda (block) (eq live (nle::display-block-row block))) blocks) "never the exec's code block"))
      (feed-events state (bg-assistant-text "The ticker runs on.")
                   (nlk::make-json-object "type" "turn.completed" "turn_id" "turn-1"
                                          "metadata" (nlk::make-json-object
                                                      "occurred_at" (nlk::iso-now) "log_position" 9 "turn_id" "turn-1")))
      (let ((rows (mapcan (lambda (block) (copy-list (nle::display-block-plain-lines block))) (shown))))
        (is (rows-carry-p "The ticker runs on." rows))
        (is (rows-carry-p "Tick a minute" rows) "the answered run folds, but lists the call still running")
        (is (rows-carry-p "⌎ tick 1" rows) "its output still streaming"))
      (feed-events state (bg-exit-fact "pending-exit" 991 "pending-call" "(sleep 600)"
                                       "backgrounded" t "output_b64" ""))
      (let ((rows (mapcan (lambda (block) (copy-list (nle::display-block-plain-lines block))) (shown))))
        (is (not (rows-carry-p "Tick a minute" rows)) "its exec ended, it folds with the rest")))))

(deftest a-foreground-eval-is-a-call-like-any-other ()
  ;; An eval the band holds only while it runs in the foreground is a call
  ;; like any other: it counts, and the title says one is running.
  (let* ((nle::*tool-detail* :standard) (nle::*expanded-tool-call* nil)
         (state (bg-state (bg-call-fact "before" "{\"command\":\"true\"}")
                          (bg-result-fact "before" "run" "{\"stdout\":\"\",\"stderr\":\"\",\"exit_code\":0}")
                          (bg-item-delta 0 "eval" "{\"form\":\"(sleep 3)\"}")
                          (bg-call-fact "in-flight" "{\"form\":\"(sleep 3)\"}" :tool-name "eval")))
         (blocks (nle:project-state state :width 90)))
    (is (nle::state-background-rows state) "the band holds the running eval")
    (is (= 1 (length blocks)) "and the run holds it")
    (is (rows-carry-p "Ran 2 commands…" (nle::display-block-plain-lines (first blocks))))))

(deftest pending-eval-clock-refreshes-inline-without-projecting-history ()
  ;; Developer's exec block carries the clock; Standard lists the call.
  (with-frame-model (model 100 30 :session-id "pending-clock" :tool-detail :developer)
    (setf (nle::chat-model-state model) (pending-eval-state))
    (let ((live (first (nle::state-background-rows (nle::chat-model-state model)))))
      (setf (nle::bg-row-born live) (- (get-internal-real-time) (* 2 internal-time-units-per-second)))
      (mark-turn-in-flight model :render t)
      (dolist (n '("pending eval" "2.0s")) (is (rows-carry-p n model.line-plain) n))
      (is (not (rows-carry-p "(sleep 600)" (second (nle::status-blocks model)))) "fixed status has no exec")
      (let ((status-row (frame-row-carrying model "waiting")))
        (is (< (or (frame-row-carrying model "(sleep 600)") 1000) status-row) "pending eval is above the composer status")
        (setf (nle::bg-row-born live) (- (get-internal-real-time) (* 5 internal-time-units-per-second)))
        (is (nle::status-chrome-moved-p model) "elapsed changes invalidate even a repeated spinner frame")
        (with-stubbed-fdefinition (nle:project-state (&rest args)
                                   (error "history must not re-project on a clock tick"))
          (nle::render-status-frame model))
        (is (rows-carry-p "5.0s" (coerce (nle::chat-model-line-plain model) 'list)))
        (is (= status-row (frame-row-carrying model "waiting")))
        (rendering model (setf (nle::chat-model-turn-in-flight model) nil))
        (is (rows-carry-p "pending eval" (coerce (nle::chat-model-line-plain model) 'list)))
        (is (nle::live-chrome-animating-p model))))))

(deftest pending-eval-subscribe-snapshots-are-all-scrollable ()
  (with-frame-model (model 90 18 :session-id "pending-snapshot")
    (setf (nle::state-background-rows (nle::chat-model-state model))
          (loop for i below 30 collect (band-row :command (format nil "snapshot-~2,'0d" i) :shell-id (+ i 100))))
    (nle::render-state model)
    (is (= 30 (count-if #'nle::bg-band-row-p (coerce (nle::chat-model-line-rows model) 'list))) "no fixed-block overflow drops pending evals")
    (is (notany (lambda (row) (search "snapshot" row)) (second (nle::status-blocks model))) "execs take no fixed composer space")
    (dolist (action '(:home :page-down :end :page-up :line-up :line-down))
      (nle::scroll-transcript model action)
      (nle::compose-frame model))
    (nle::scroll-transcript model :home)
    (is (rows-carry-p "snapshot-00" (nle::compose-frame model)))
    (nle::scroll-transcript model :end)
    (is (rows-carry-p "snapshot-29" (nle::compose-frame model)))))

(deftest pending-eval-completion-updates-the-call-in-place ()
  (let* ((state (pending-eval-state))
         (before (copy-list (nle::transcript-rows state))))
    (feed-events state (bg-exit-fact "pending-exit" 991 "pending-call" "(sleep 600)"
                                   "backgrounded" t "output_b64" ""))
    (is (equal before (nle::transcript-rows state)) "completion never relocates an existing pending call past later conversation")
    (is (null (nle::state-background-rows state)))
    (is (equal "exited" (nle::transcript-row-tool-status (second before))))
    (let ((blocks (nle:project-state state :width 90)))
      (is (= 2 (length blocks)) "the run, then the turn's newest words")
      ;; Ended, the call is a live turn's run of one, folded where it stood.
      (is (member (second before) (nle::tool-group-members (nle::display-block-row (first blocks))))))))

(deftest preparing-eval-and-later-round-keep-their-own-transcript-rows ()
  (let ((state (bg-state (bg-item-delta 0 "eval" "{\"form\":\"(sleep 600)\"}"))))
    (is (= 1 (length (tool-blocks state))) "preparing eval is already in the transcript")
    (feed-events state (bg-call-fact "first-round" "{\"form\":\"(sleep 600)\"}" :tool-name "eval")
                (bg-backgrounding-result "first-round" 981 "(sleep 600)" "eval")
                (bg-item-delta 0 "read" "{\"path\":\"another-round.txt\"}"))
    (is (equal '(("first-round" "eval") (nil "read"))
               (loop for row in (nle::transcript-rows state)
                     when (eq :tool-call (nle::transcript-row-kind row))
                       collect (list (nle::transcript-row-tool-call-id row)
                                     (nle::transcript-row-tool-name row)))) "each call keeps its own row")
    (is (rows-carry-p "Ran 2 commands" (loop for block in (tool-blocks state)
                                              append (nle::display-block-plain-lines block))) "and its run counts both")))
