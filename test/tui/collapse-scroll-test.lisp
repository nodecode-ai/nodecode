(in-package :nodecode.test)

(defun collapse-scroll-state (&key (previous 3) (calls 100) &aux state)
  "Submitted earlier turns followed by a live long Standard tool trail."
  (dotimes (i previous)
    (let ((turn (format nil "previous-~d" i)))
      (setf state (nle::ingest-message-fact state "user" (format nil "Previous submitted turn ~d" i) :turn-id turn)
            state (nle::ingest-message-fact state "assistant" (format nil "Previous answer ~d" i) :turn-id turn)
            state (nle::ingest-turn-terminal state "completed" :turn-id turn))))
  (setf state (nle::ingest-message-fact state "user" "Current submitted turn" :turn-id "collapsing"))
  (dotimes (i calls)
    (let ((id (format nil "collapse-call-~d" i)))
      (setf state (nle::ingest-tool-call-fact state id "eval" (eval-args ";; Check viewport") :turn-id "collapsing")
            state (nle::ingest-tool-result-fact state id "eval" "2" :turn-id "collapsing"))))
  (nle::ingest-message-fact state "assistant" "Final answer" :turn-id "collapsing"))

(defun collapse-scroll-terminal (model)
  "Settle the live tool trail through the real typed gateway fact consumer."
  (feed-wire model (nlk:encode-json-object
    (nlk:json-object "sequence" 1 "cursor" 1 "session_id" model.session-id "payload"
      (nlk:json-object "type" "session_stream_event" "frame"
        (fact-frame "turn.completed" "collapsing" :session-id model.session-id :seq 1
          :payload (nlk:json-object "turn-number" 4 "message-count" 2 "steered" nil))))))
  (nle:update model (nlt:make-tick-msg))
  (nle::compose-frame model))

(defun collapse-scroll-visible (model)
  "Visible content rows; the band's explicit :SPACER owns no text."
  (remove-if-not #'stringp (band-row-texts model)))

(deftest standard-collapse-keeps-short-history-reachable-by-every-scroll-gesture ()
  (dolist (gesture '(:wheel :page-up :home :scrollbar))
    (with-frame-model (model 100 90 :session-id "collapse-short" :tool-detail :standard)
      (rendering model (setf model.state (collapse-scroll-state) model.turn-in-flight t))
      (collapse-scroll-terminal model)
      (is (< (nle::band-window-count model.band) (nle::band-window-height model.band)) "collapse leaves all history shorter than the band")
      (is (rows-carry-p "Current submitted turn" (collapse-scroll-visible model)) "follow-bottom still pins the current prompt")
      (is (rows-carry-p "Previous submitted turn 0" (collapse-scroll-visible model)) "under the earlier turns: a short band never lifts the newest prompt over them")
      (is (rows-carry-p "Ran 100 commands" (collapse-scroll-visible model)))
      (ecase gesture
        (:wheel (mouse-update model #'nlt:make-mouse-wheel-msg 8 8 :direction :up))
        (:page-up (press model :page-up))
        (:home (press model :home))
        (:scrollbar (click-at model 98 4)))
      (is (rows-carry-p "Previous" (collapse-scroll-visible model)) "the scroll gesture keeps the earlier submitted turns in view")
      (is (nle::chat-model-follow-bottom model) "with nothing above them to read, the band keeps following")
      (press model :home)
      (is (rows-carry-p "Previous submitted turn 0" (collapse-scroll-visible model)))
      (press model :end)
      (is (nle::chat-model-follow-bottom model))
      (is (rows-carry-p "Current submitted turn" (collapse-scroll-visible model))))))

(deftest standard-collapse-grows-a-short-retained-tail-before-scrolling-up ()
  ;; 27 rows keep the band the 14 the held trail is measured against.
  (dolist (gesture '(:wheel :page-up :home))
    (with-frame-model (model 100 27 :session-id "collapse-partial" :tool-detail :standard)
      (setf model.state (collapse-scroll-state :previous 30 :calls 200) model.turn-in-flight t
            ;; A live turn folds its trail as it lands: the reader opened it.
            model.expanded-tool-call '(:process "collapse-call-0"))
      (nle::render-state model)
      (is (cdr (nle::chat-model-projection-start model)) "the running trail initially projects only its turn")
      (press model :page-up)
      (is (not (nle::chat-model-follow-bottom model)))
      (setf (nle::chat-model-expanded-tool-call model) nil)
      (collapse-scroll-terminal model)
      (is (cdr (nle::chat-model-projection-start model)) "the history reader retains a partial projection on settlement")
      (is (< (nle::band-window-count model.band) (nle::band-window-height model.band)) "the held tool trail collapses to less than one screen")
      (ecase gesture
        (:wheel (mouse-update model #'nlt:make-mouse-wheel-msg 8 8 :direction :up))
        (:page-up (press model :page-up))
        (:home (press model :home)))
      (is (rows-carry-p "Previous" (collapse-scroll-visible model)) "upward intent grows omitted earlier turns even when the held projection fits")
      (press model :home)
      (is (null (cdr (nle::chat-model-projection-start model))))
      (is (rows-carry-p "Previous submitted turn 0" (collapse-scroll-visible model))))))

(deftest standard-collapse-below-a-history-reader-keeps-their-place ()
  (with-frame-model (model 100 24 :session-id "collapse-held" :tool-detail :standard)
    (setf model.state (collapse-scroll-state :previous 12 :calls 100) model.turn-in-flight t)
    (nle::render-state model)
    (press model :home :page-down)
    (let ((before (collapse-scroll-visible model))
          (offset (nle::band-window-offset (nle::chat-model-band model))))
      (collapse-scroll-terminal model)
      (is (equal before (collapse-scroll-visible model)) "collapsing work below the viewport does not move the older turn being read")
      (is (= offset (nle::band-window-offset (nle::chat-model-band model))))
      (is (not (nle::chat-model-follow-bottom model))))))

(defun assistant-card-spacing-state (&optional (body "Intermediate assistant message"))
  "A completed turn whose assistant message stands between two commands."
  (let ((state (nle::ingest-message-fact nil "user" "Spacing prompt" :turn-id "assistant-spacing")))
    (setf state (nle::ingest-tool-call-fact state "spacing-first" "eval" (eval-args ";; First command") :turn-id "assistant-spacing")
          state (nle::ingest-tool-result-fact state "spacing-first" "eval" "first result" :turn-id "assistant-spacing")
          state (nle::ingest-message-fact state "assistant" body :turn-id "assistant-spacing")
          state (nle::ingest-message-fact state "assistant" "" :turn-id "assistant-spacing")
          state (nle::ingest-tool-call-fact state "spacing-second" "eval" (eval-args ";; Second command") :turn-id "assistant-spacing")
          state (nle::ingest-tool-result-fact state "spacing-second" "eval" "second result" :turn-id "assistant-spacing")
          state (nle::ingest-message-fact state "assistant" "Final assistant message" :turn-id "assistant-spacing"))
    (nle::ingest-turn-terminal state "completed" :turn-id "assistant-spacing")))

;;; The model's words never fold into the run:
;;; they stand under it as their own blocks, open or shut -- the turn's
;;; newest in the one place its words have.
(deftest standard-assistant-words-stand-under-the-run-as-their-own-blocks (dolist (width '(32 100)))
  (dolist (body (list "Intermediate assistant message"
                     (format nil "Intermediate assistant message with a longer wrapped line.~%~%**Second paragraph.**")))
    (let* ((nle::*tool-detail* :standard)
           (state (assistant-card-spacing-state body))
           (group (nle::display-block-row (second (nle:project-state state :width width)))))
      (is (nle::tool-group-p group))
      (is (equal '(:tool-call :tool-call) (mapcar #'nle::transcript-row-kind (nle::tool-group-members group))) "the run holds only its calls")
      (dolist (open (list nil (nle::tool-group-key group)))
        (let* ((nle::*expanded-tool-call* open)
               (blocks (nle:project-state state :width width))
               (rows (mapcar #'nle::display-block-row blocks))
               (words (find "Final assistant message" rows :key (lambda (row) (and (nle::transcript-row-p row) (nle::transcript-row-text row))) :test #'equal)))
          (is words "the newest words stand in the projection")
          (is (not (find body rows :key (lambda (row) (and (nle::transcript-row-p row) (nle::transcript-row-text row))) :test #'equal)) "the words before them give up their place")
          (is (< (position group rows) (position words rows)) "under the run")
          (is (equal (nle::display-block-plain-lines (nle::row-display-block words :width width))
                     (nle::display-block-plain-lines (find words blocks :key #'nle::display-block-row))) "in their own padded block")
          (is (notany (lambda (block &aux (row (nle::display-block-row block)))
                        (and (nle::transcript-row-p row) (equal "" (nle::transcript-row-text row))
                             (nle::display-block-lines block)))
                      blocks) "an empty assistant message draws nothing"))))))

(deftest standard-assistant-words-stay-across-a-disclosure-click ()
  (with-frame-model (model 100 40 :session-id "assistant-spacing-click" :tool-detail :standard
                     :state (assistant-card-spacing-state))
    (dolist (step '(:shut :open :shut))
      (when (eq step :open) (click-at model 12 (frame-row-carrying model "Ran 2 commands")))
      (nle::compose-frame model)
      (let* ((rows (nle::frame-plain-rows model))
             (index (row-index-of "Final assistant message" rows :required t))
             (end (+ 2 (nle::transcript-text-width (nle::chat-model-term-width model)))))
        (is (zerop (length (string-trim '(#\Space) (subseq (aref rows (1- index)) 2 end)))) "the words have a top canvas gap")
        (is (zerop (length (string-trim '(#\Space) (subseq (aref rows (1+ index)) 2 end)))) "and a bottom one"))
      (when (eq step :open) (click-at model 12 (frame-row-carrying model "Ran 2 commands"))))))

(deftest standard-process-summary-has-one-gap-in-both-disclosure-states ()
  (let* ((nle::*tool-detail* :standard) (nle::*color-profile* :none)
         (call (tool-row "eval" (eval-args ";; Immediate tool") :tool-call-id "gap-call" :text "2"))
         (answer (nle::make-transcript-row :kind :text :role "assistant" :text "Inside assistant"))
         (after (nle::make-transcript-row :kind :text :role "assistant" :text "Following assistant"))
         (group (nle::make-tool-group '(:process "gap-call"))))
    (setf (nle::tool-group-members group) (list call answer))
    (dolist (width '(40 100))
      (dolist (open '(nil t))
        (let* ((nle::*expanded-tool-call* (when open (nle::tool-group-key group)))
               (block (nle::tool-group-display-block group width)))
          (dolist (next (list call after))
            (multiple-value-bind (painted plains refs)
                (nle::transcript-line-table (list block (nle::row-display-block next :width width)))
              (is (= (length painted) (length plains) (length refs)))
              (let* ((title (row-index-of "Ran 1 command" plains :required t))
                     (first (row-index-of (if open "Immediate tool" (if (eq next call) "Immediate tool" "Following assistant")) plains :required t)))
                (is (= 2 (- first title)) "Ran and its immediate visible body have exactly one blank row")
                (is (zerop (length (string-trim '(#\Space) (nth (1+ title) plains))))))
              (when open
                ;; Opened, a run lists its calls a line each, and words are no line of it.
                (let* ((listed (row-index-of "Immediate tool" plains :required t))
                       (following (if (eq next call)
                                      (position-if (lambda (line) (search "Immediate tool" line)) plains :start (1+ listed))
                                      (row-index-of "Following assistant" plains :required t))))
                  (is (not (rows-carry-p "Inside assistant" plains)))
                  (is (= 2 (- following listed)) "the listed call and the following block share one canvas pad, never two"))))))))))
