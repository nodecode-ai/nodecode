;;;; footer-pending-test.lisp --- the model slot before the shell knows its target.
;;;;
;;;; SPDX-License-Identifier: MIT
;;;;
;;;; Claims:
;;;;   1. A gateway shell that has not yet learned its target never names
;;;;      one: the slot reads `setting up…' and the process globals
;;;;      (*PROVIDER*/*MODEL* — the lane this image was built or seeded with)
;;;;      are never painted in its place.
;;;;
;;;;   2. The read that answers it publishes where it lands (the fetch thread)
;;;;      so the LAUNCH frame can carry the identity, and the launch frame
;;;;      settles for it, bounded (SETTLE-BEFORE-FIRST-FRAME).
;;;;
;;;; Loads after ui-test: reuses MAKE-FRAME-MODEL and the row helpers.

(in-package #:nodecode.test)

(deftest footer-omits-the-permanent-help-hint ()
  (with-frame-model (model 100 30 :session-id "footer-no-help")
    (land-model-facts model :provider "acme" :model "acme/m1" :effort "high")
    (dolist (width '(40 80 160))
      (let ((row (nle::footer-frame-row model width nil)))
        (is (= width (nle::text-display-width row)) "the footer keeps its width")
        (is (search "acme m1 (high) · ← sessions" row) "identity and gesture remain")
        (is (not (search "? help" row)) "the permanent help hint is gone")))))

(deftest a-model-id-that-starts-with-its-provider-says-it-once ()
  ;; `deepseek deepseek-flash' in the footer and `deepseek/deepseek-flash' on
  ;; the turn bar named the provider twice: the id already carries it. A
  ;; provider the id does not start with still leads.
  (is-each (nle::status-identity-label)
    ("deepseek" "deepseek-flash" "deepseek-flash" "the id already names its provider")
    ("DeepSeek" "deepseek-v4-flash" "deepseek-v4-flash" "whatever the case")
    ("a6api" "gpt-6.1-sol" "a6api/gpt-6.1-sol" "a provider the id does not name still leads")
    ("deep" "deepseek-flash" "deep/deepseek-flash" "a provider that only begins the id's first word is not in it"))
  (with-frame-model (model 100 30 :session-id "footer-once")
    (land-model-facts model :provider "deepseek" :model "deepseek-flash" :effort "high")
    (let ((row (nle::footer-frame-row model 100 nil)))
      (is (search "deepseek-flash (high) · ← sessions" row) "the footer says it once")
      (is (not (search "deepseek deepseek" row))))
    (land-model-facts model :provider "relay" :model "deepseek-v4-flash")
    (is (search "relay deepseek-v4-flash" (nle::footer-frame-row model 100 nil)) "a provider that adds something stays")))

(deftest footer-names-no-model-before-the-facts-land ()
  (with-frame-model (model 100 30 :session-id "footer-pending")
    (with-saved-globals ((nle::*provider* "openai-completions")
                         (nle::*model* "deepseek-v4-flash-free"))
      (is (eq :unresolved model.model-facts) "the facts start unresolved")
      (let ((rows (nle::compose-frame model)))
        (is (rows-carry-p "setting up…" rows) "the slot says the shell is still setting up")
        (is (not (rows-carry-p "openai-completions" rows)) "the build-time lane is never painted")
        (is (not (rows-carry-p "deepseek-v4-flash-free" rows))))
      ;; The facts land: the slot names the target the next turn would bind.
      (land-model-facts model :provider "deepseek" :model "deepseek-flash")
      (let ((rows (nle::compose-frame model)))
        (is (rows-carry-p "deepseek-flash" rows) "the landed facts name the target")
        (is (not (rows-carry-p "deepseek deepseek" rows)) "an id that starts with its provider says it once")
        (is (not (rows-carry-p "setting up…" rows)) "and the placeholder is gone")))))

(deftest a-read-that-never-landed-is-no-answer ()
  ;; The control surface refusing, timing out, or answering for a session
  ;; that does not exist yet is not evidence about the target: the cache keeps
  ;; what it held rather than installing the empty value, which would render
  ;; as a shell with no model at all (the fetch runs BESIDE the session
  ;; ensure, so its first attempt can arrive before the session exists).
  (with-frame-model (model 100 30 :session-id "footer-refused")
    (nle::install-gateway-model-facts model nil model.facts-epoch)
    (is (eq :unresolved model.model-facts) "pending stays pending")
    (is (rows-carry-p "setting up…" (nle::compose-frame model)) "and the slot still says so")))

(deftest launch-frame-carries-the-identity-it-settled-for ()
  ;; The launch frame is the one the operator reads before they can do
  ;; anything: a read already in flight is waited for, briefly, so that frame
  ;; carries the identity instead of a placeholder the next paint replaces.
  (with-frame-model (model 100 30 :http-port 4321 :session-id "footer-settle")
    (with-saved-globals ((nle::*first-frame-facts-settle-ms* 500))
      ;; The facts land into the cache a beat later, as the fetch thread lands them.
      (nlk:spawn "test-facts-publisher"
        (sleep 0.02)
        (nle::publish-gateway-model-facts model (list :provider "deepseek" :model "deepseek-flash")
                                          model.facts-epoch))
      (let ((start (get-internal-real-time)))
        (is (nlt:settle-before-first-frame model) "the settle saw the answer land")
        (is (< (nle::since-ms start) 400.0)
            (format nil "back on the answer, not the deadline: ~,1fms" (nle::since-ms start))))
      (is (rows-carry-p "deepseek-flash" (nle::compose-frame model)) "carried the identity"))))

(deftest launch-frame-settles-no-longer-than-its-deadline ()
  ;; A gateway that never answers costs the launch frame the deadline and
  ;; nothing more, and a shell with no endpoint yet — an owner still booting
  ;; its gateway — does not wait at all.
  (with-frame-model (model 100 30 :http-port 4321 :session-id "footer-deadline")
    (with-saved-globals ((nle::*first-frame-facts-settle-ms* 30))
      (let ((start (get-internal-real-time)))
        (is (not (nlt:settle-before-first-frame model)) "nobody answered")
        (let ((elapsed (nle::since-ms start)))
          (is (<= 25.0 elapsed 400.0)
              (format nil "held the frame for the deadline: ~,1fms" elapsed))))
      (setf model.http-port nil)
      (let ((start (get-internal-real-time)))
        (is (not (nlt:settle-before-first-frame model)) "no endpoint, nothing to await")
        (is (< (nle::since-ms start) 100.0)
            (format nil "and no wait at all: ~,1fms" (nle::since-ms start)))))))

(deftest a-session-switch-refetches-the-destination-facts ()
  ;; The facts a shell holds belong to the session it is on -- the pin, the
  ;; effort -- so a switch blanks them; and nothing else refetches for a
  ;; switch (MODEL_CHANGED fires only when a target moves, a
  ;; subscribe is no fresh connection), so the switch reads again itself,
  ;; scoped to where it lands. Without that read the footer and the turn
  ;; bar would say `setting up…' for the rest of the shell's stay.
  (with-frame-model (model 100 30 :session-id "s-1")
    (let ((program (nlt:make-program model)))
      (setf model.program program)
      (land-model-facts model :provider "deepseek" :model "of-s-1")
      (is (rows-carry-p "deepseek of-s-1" (nle::compose-frame model)) "named before the switch")
      (with-stubbed-fdefinitions ((nle::send-subscribe (ws session-ids) nil)
                                  (nle::fetch-gateway-model-facts (model)
                                    ;; The read is scoped to the session the
                                    ;; shell is on when it goes out.
                                    (list :provider "deepseek"
                                          :model (format nil "of-~a" model.session-id))))
        (nle::switch-gateway-session model "s-2")
        ;; The read lands on its own thread (PUBLISH-GATEWAY-MODEL-FACTS): wait
        ;; for it, bounded.
        (await (:tries 200 :rest 0.01) (not (eq :unresolved model.model-facts)))
        (is (equal "of-s-2" (getf (nle::gateway-model-facts model) :model)) "the destination's facts landed")
        (is (rows-carry-p "deepseek of-s-2" (nle::compose-frame model)) "and the slot names them")
        (is (not (rows-carry-p "setting up…" (nle::compose-frame model))))))))

;;; Footer actions read the clipped painted row, not guessed text positions.
(defun footer-test-cell (model needle)
  "The first cell of NEEDLE in the composed footer, as 1-based mouse X,Y."
  (nle::compose-frame model)
  (let* ((row (- (nle::frame-height model) 2))
         (plain (aref (nle::frame-plain-rows model) row))
         (at (search needle plain)))
    (assert at () "Footer lacks ~s: ~s" needle plain)
    (values (1+ (nle::text-display-width (subseq plain 0 at))) (1+ row))))

(deftest footer-actions-dispatch-the-visible-identities ()
  (with-frame-model (model 220 30 :session-id "footer-actions" :http-port 4321 :http-token "fixture-token")
    (land-model-facts model :provider "acme" :model "acme/模型" :effort "high")
    (setf (gethash "running-one" (nle::session-activity-table model)) t)
    (nle::editor-insert (nle::chat-model-editor model) "keep my draft")
    (let ((calls nil) (opened nil)
          (nle::*workspace-footer-label* "~/工作 space")
          (nle::*workspace-directory* "/tmp/工作 space"))
      (with-stubbed-fdefinition (nlk:profile-label () "default")
        (with-stubbed-fdefinition (nle::execute-slash-command (shell name args)
                                   (push (list name args) calls)
                                   (values nil nil))
          (dolist (pair '(("acme 模型" "models") ("(high)" "think")
                          ("← sessions · 1 running" "sessions") ("default" "profiles")))
            (nlk:bind (((x y) (footer-test-cell model (first pair))) (count (length calls)))
              (mouse-update model #'nlt:make-mouse-click-msg x y :button :left)
              (is (= count (length calls)) "a press arms, it does not open")
              (mouse-update model #'nlt:make-mouse-release-msg x y :button :left)
              (is (equal (list (second pair) "") (first calls)) "the visible identity reaches its canonical slash op")))
          (with-stubbed-fdefinition (nle::open-target (uri) (setf opened uri) t)
            (multiple-value-bind (x y) (footer-test-cell model "~/工作 space")
              (click-at model x y)))
          (is (equal (nle::file-uri "/tmp/工作 space") opened) "the cwd uses the shared native file opener")
          (multiple-value-bind (x y) (footer-test-cell model "Gateway")
            (is (equal "http://127.0.0.1:4321/web/#t=fixture-token"
                       (nle::frame-target-at-position model x y))))
          (is (= 4 (length calls)) "the gateway link is not a slash command")
          (is (equal "keep my draft" (composer-value model)) "footer actions never submit or replace the draft"))))))

(deftest footer-drag-and-outside-release-do-not-dispatch ()
  (with-frame-model (model 220 30 :session-id "footer-cancel")
    (land-model-facts model :provider "p" :model "m" :effort "high")
    (let ((calls 0))
      (with-stubbed-fdefinition (nle::execute-slash-command (shell name args)
                                 (incf calls) (values nil nil))
        (multiple-value-bind (x y) (footer-test-cell model "p m")
          (drag-to model x y 1 y)
          (is (zerop calls) "release outside cancels the action")
          (drag-to model x y (+ x 2) y :moves t)
          (is (zerop calls) "dragging footer text copies, never opens")
          (click-at model x y)
          (is (= 1 calls) "a following plain click still opens")
          (drag-to model x y x y :button :right)
          (is (= 1 calls) "right clicks never activate footer actions"))))))

(deftest footer-actions-remain-reachable-below-a-docked-dialog ()
  (with-frame-model (model 220 30 :session-id "footer-panel")
    (land-model-facts model :provider "p" :model "m")
    (nle::open-picker-dialog model "An open panel" (list (nle::make-picker-row :label "one")) #'identity)
    (let ((called nil))
      (with-stubbed-fdefinition (nlk:profile-label () "default")
        (with-stubbed-fdefinition (nle::execute-slash-command (shell name args)
                                   (setf called name) (values nil nil))
          (multiple-value-bind (x y) (footer-test-cell model "default") (click-at model x y))
          (is (equal "profiles" called) "a visible footer is not covered by the docked panel's hitbox"))))))

(deftest footer-hitboxes-match-the-clipped-painted-segments ()
  (let ((nle::*workspace-footer-label* "~/模型"))
    (with-frame-model (model 220 30 :session-id "footer-widths" :http-port 4321)
      (land-model-facts model :provider "acme" :model "acme/模型" :effort "high")
      (dolist (nle::*color-profile* '(:none :truecolor :ansi256 :ansi))
        (dolist (width '(8 16 35 80 220))
          (nle:update model (nlt:make-window-size-msg :width width :height 30))
          (nle::compose-frame model)
          (let ((plain (aref (nle::frame-plain-rows model) 28)))
            (is (= width (nle::text-display-width plain)) "color and Unicode never alter the row width")
            (is (null (nle::frame-target-at-position model 1 29)) "left padding is never clickable")
            (is (null (nle::frame-target-at-position model width 29)) "right padding or the clipping marker is never clickable")
            (loop for column from 0 below width
                  for glyph = (char plain (nle::plain-column-index plain column))
                  when (find glyph "·…")
                    do (is (null (nle::frame-target-at-position model (1+ column) 29)) "separators and ellipses carry no ghost action"))))))))

(deftest footer-gateway-status-is-color-not-a-text-suffix ()
  (with-frame-model (model 220 30 :session-id "footer-color" :http-port 4321 :http-token "fixture-token")
    (land-model-facts model :provider "p" :model "m")
    (dolist (profile '(:none :truecolor :ansi256 :ansi))
      (let ((nle::*color-profile* profile) (nle::*palette* (nle::default-palette)))
        (dolist (pair '((:connected :success) (:connecting :tool) (:reconnecting :tool) (:failed :danger)))
          (setf model.sync-lifecycle (first pair))
          (let* ((bg (nle::canvas-fill-bg))
                 (row (nle::footer-frame-row model 220 bg))
                 (plain (nle::plain-frame-row row))
                 (endpoint (nle::seg-render (nle::make-seg :text "Gateway" :tone (second pair)
                                               :link "http://127.0.0.1:4321/web/#t=fixture-token") bg)))
            (is (search endpoint row) "the endpoint itself paints the lifecycle tone")
            (is-carrying plain "Gateway"
              (:absent " • " "the lifecycle suffix is removed in every state")
              (:absent "connected") (:absent "connecting") (:absent "failed"))
            (is (= 220 (nle::text-display-width plain)))))))))

(deftest footer-cwd-open-refusal-is-visible (let ((nle::*workspace-footer-label* "~/workspace")))
  (with-frame-model (model 220 30 :session-id "footer-refusal")
    (land-model-facts model :provider "p" :model "m")
    (with-stubbed-fdefinition (nle::open-target (uri) :no-opener)
      (multiple-value-bind (x y) (footer-test-cell model "~/workspace") (click-at model x y)))
    (is (search "Nothing here opens files" (or (nle::status-said model) "")) "a headless shell explains the unavailable native opener")))

(deftest footer-placeholders-and-short-windows-have-no-phantom-actions ()
  (with-frame-model (model 220 30 :session-id "footer-no-phantom")
    (nle::compose-frame model)
    (multiple-value-bind (x y) (footer-test-cell model "setting up…")
      (is (null (nle::frame-target-at-position model x y)) "an unresolved target is never made up"))
    (nle:update model (nlt:make-window-size-msg :width 220 :height 10))
    (nle::compose-frame model)
    (loop for y from 1 to 10 do
      (loop for x from 1 to 220 do
        (is (null (nle::frame-target-at-position model x y)) "a shed footer cannot retain old hitboxes")))))

(deftest footer-links-hover-with-the-disclosure-accent ()
  (with-frame-model (model 220 30 :session-id "footer-hover" :http-port 4321)
    (land-model-facts model :provider "acme" :model "acme/模型" :effort "high")
    (let ((nle::*workspace-footer-label* "~/工作 space")
          (nle::*workspace-directory* "/tmp/工作 space"))
      (with-stubbed-fdefinition (nlk:profile-label () "default")
        (dolist (nle::*color-profile* '(:truecolor :ansi256 :ansi :none))
          (let ((nle::*palette* (nle::default-palette)))
            (dolist (pair (list (list "acme 模型" (cons :command "models"))
                               (list " (high)" (cons :command "think"))
                               (list (nle::footer-gesture-hint model) (cons :command "sessions"))
                               (list "default" (cons :command "profiles"))
                               (list "~/工作 space" (nle::file-uri "/tmp/工作 space"))))
              (destructuring-bind (text target) pair
                (multiple-value-bind (x y) (footer-test-cell model text)
                  (mouse-update model #'nlt:make-mouse-motion-msg x y)
                  (is (equal target (nle::chat-model-hover-target model)) "painted cells retain their action target")
                  (let* ((bg (nle::canvas-fill-bg))
                         (row (nle::footer-frame-row model 220 bg))
                         (expected (nle::seg-render
                                    (nle::make-seg :text text :tone :disclosure-hover :link target) bg)))
                    (is (search expected row) "hover uses the Eval disclosure accent with no underline")
                    (is (= 220 (nle::text-display-width (nle::plain-frame-row row))))))
                (setf (nle::chat-model-hover-target model) nil)
                (let* ((bg (nle::canvas-fill-bg))
                       (row (nle::footer-frame-row model 220 bg))
                       (expected (nle::seg-render (nle::make-seg :text text :tone :muted :link target) bg)))
                  (is (search expected row) "unhovered links return to muted paint"))))))))))

(deftest footer-gateway-links-to-the-web-sessions ()
  (with-frame-model (model 220 30 :session-id "gateway-sessions" :http-port 38935)
    (land-model-facts model :provider "p" :model "m")
    (nle::editor-insert (nle::chat-model-editor model) "keep my draft")
    (let ((opened nil) (calls 0))
      (with-stubbed-fdefinition (nle::open-target (uri) (push uri opened) t)
        (dolist (port '(38935 4321))
          (setf model.http-port port model.http-token (format nil "fixture-~d" port))
          (let ((target (format nil "http://127.0.0.1:~d/web/#t=fixture-~d" port port)))
            (dolist (nle::*color-profile* '(:none :truecolor :ansi256 :ansi))
              (multiple-value-bind (x y) (footer-test-cell model "Gateway")
                (let ((plain (aref (nle::frame-plain-rows model) 28)))
                  (is (not (search "127.0.0.1" plain)) "the localhost address is hidden")
                  (is (not (search "fixture-" plain)) "the operator token is never visible text")
                  (is (not (search (write-to-string port) plain)) "the port is hidden too")
                  (dotimes (offset 7)
                    (is (equal target (nle::frame-target-at-position model (+ x offset) y)) "every painted Gateway cell links to this shell's current port")))
                (mouse-update model #'nlt:make-mouse-motion-msg x y)
                (is (equal target (nle::chat-model-hover-target model)))
                (let* ((bg (nle::canvas-fill-bg))
                       (row (nle::footer-frame-row model 220 bg)))
                  (is (search (nle::seg-render (nle::make-seg :text "Gateway" :tone :disclosure-hover :link target) bg) row) "the Sessions link shows the shared hover accent"))
                (mouse-update model #'nlt:make-mouse-click-msg x y :button :left)
                (is (= calls (length opened)) "press only arms")
                (mouse-update model #'nlt:make-mouse-release-msg x y :button :left)
                (incf calls)
                (is (equal target (first opened)) "release opens the page on Sessions through the native URL opener")
                (setf (nle::chat-model-hover-target model) nil)))
            (let ((nle::*workspace-footer-label* (make-string 100 :initial-element #\x)))
              (nle:update model (nlt:make-window-size-msg :width 60 :height 30))
              (multiple-value-bind (x y) (footer-test-cell model "Gateway")
                (is (equal target (nle::frame-target-at-position model x y)) "the endpoint-only candidate keeps the same link"))
              (nle:update model (nlt:make-window-size-msg :width 220 :height 30)))))
        (is (equal "keep my draft" (composer-value model)) "the link never submits the draft")
        (setf model.http-port nil)
        (is (notany (lambda (segments) (search "Gateway" (nle::segs-text segments)))
                    (nle::footer-right-candidates model)) "no endpoint means no fabricated link")
        (setf model.http-port 38935
              (nle::chat-model-setup-walk model) t)
        (is (notany (lambda (segments) (search "Gateway" (nle::segs-text segments)))
                    (nle::footer-right-candidates model)) "setup still hides the gateway")))))

(deftest footer-all-command-options-toggle-their-own-picker ()
  (with-frame-model (model 220 30 :session-id "footer-toggle")
    (land-model-facts model :provider "p" :model "m" :effort "high")
    (nle::editor-insert (nle::chat-model-editor model) "keep my draft")
    (let ((applied 0) (cancelled 0))
      (with-stubbed-fdefinitions
          ((nle::models-catalog-picker-rows () (picker-rows '("p/m" :value ("p" "m"))))
           (nle::start-provider-models-refresh (shell) nil)
           (nle::target-snapshot (shell)
             (values "p" "m" '("low" "high") '(:effort "high")))
           (nle::apply-effort (shell effort) (incf applied))
           (nlk:profile-label () "default")
           (nle::profile-picker-rows () (picker-rows '("default" :value "default")))
           (nle::gateway-model-http-call (shell method path &optional payload)
             (is (equal "/api/gateway/sessions" path))
             #())
           (nle::sessions-preview-arm (&rest args)))
        (flet ((click (text)
                 (multiple-value-bind (x y) (footer-test-cell model text) (click-at model x y))))
          ;; /sessions has no title: its tab chips say which list is open.
          (dolist (pair '(("p m" :model-providers "Models") ("(high)" :think "Reasoning effort")
                          ("← sessions" :sessions "") ("default" :profiles "Profiles")))
            (click (first pair))
            (let ((dialog (nle::chat-model-dialog model)))
              (is (nle::picker-dialog-p dialog) "the canonical slash op opens the picker")
              (is (eq (second pair) (nle::picker-dialog-kind dialog)) "each picker declares its identity")
              (is (search (third pair) (nle::picker-dialog-title dialog)) "the correct panel opens")
              (let ((on-cancel (nle::picker-dialog-on-cancel dialog)))
                (setf (nle::picker-dialog-search dialog) "query"
                      (nle::picker-dialog-on-cancel dialog)
                      (lambda (shell)
                        (incf cancelled)
                        (when on-cancel (funcall on-cancel shell)))))
              (multiple-value-bind (x y) (footer-test-cell model (first pair))
                (mouse-update model #'nlt:make-mouse-click-msg x y :button :left)
                (is (eq dialog (nle::chat-model-dialog model)) "press alone does not dismiss")
                (mouse-update model #'nlt:make-mouse-release-msg 1 y :button :left)
                (is (eq dialog (nle::chat-model-dialog model)) "outside release does not dismiss")
                (drag-to model x y (1+ x) y :moves t)
                (is (eq dialog (nle::chat-model-dialog model)) "drag does not dismiss")))
            (click (first pair))
            (is (null (nle::chat-model-dialog model)) "second click closes outright even with a search query")
            (click (first pair))
            (is (eq (second pair) (nle::picker-dialog-kind (nle::chat-model-dialog model))) "third click reopens")
            (click (first pair)))
          (is (= cancelled 4) "closing uses each dialog's cancellation callback exactly once")
          (dolist (from '("p m" "(high)" "← sessions" "default"))
            (dolist (to '(("p m" . :model-providers) ("(high)" . :think)
                         ("← sessions" . :sessions) ("default" . :profiles)))
              (unless (equal from (car to))
                (click from)
                (click (car to))
                (is (eq (cdr to) (nle::picker-dialog-kind (nle::chat-model-dialog model))) "a different footer option switches to its picker")
                (click (car to))
                (is (null (nle::chat-model-dialog model)) "the destination option toggles closed"))))
          (is (zerop applied) "dismissal never selects an effort")
          (is (equal "keep my draft" (composer-value model)) "toggle preserves the draft"))))))

(deftest footer-gateway-token-is-fragment-only-and-encoded ()
  (with-frame-model (model 220 30 :session-id "gateway-token" :http-port 4321
                           :http-token "a&b=#/+?")
    (let* ((segments (first (nle::footer-right-candidates model)))
           (target (nle::seg-link (car (last segments)))))
      (is (equal "http://127.0.0.1:4321/web/#t=a%26b%3D%23%2F%2B%3F" target))
      (is (not (search "a&b" (nle::segs-text segments))) "paint never reveals the token"))
    (setf model.http-token nil)
    (is (equal "http://127.0.0.1:4321/web/"
               (nle::seg-link (car (last (first (nle::footer-right-candidates model)))))))))

(deftest footer-sessions-toggle-rejects-late-directory-completions ()
  (with-frame-model (model 220 30 :session-id "footer-late-sessions")
    (land-model-facts model :provider "p" :model "m" :effort "high")
    (setf (nle::chat-model-program model) (nlt:make-program model))
    (let ((pending nil))
      (with-stubbed-fdefinitions
          ((nle::cached-session-directory (shell) nil)
           (nle::off-loop (shell thunk continuation)
             (setf pending continuation)))
        (flet ((click-sessions ()
                 (multiple-value-bind (x y) (footer-test-cell model "← sessions") (click-at model x y))))
          (click-sessions)
          (let ((old pending))
            (click-sessions)
            (is (null (nle::chat-model-dialog model)) "second click closes the pending Sessions panel")
            (funcall old model nil)
            (is (null (nle::chat-model-dialog model)) "a late listing cannot reopen a closed panel")
            (nle::open-picker-dialog model "Other" nil nil :kind :profiles)
            (let ((other (nle::chat-model-dialog model)))
              (funcall old model nil)
              (is (eq other (nle::chat-model-dialog model)) "a late listing cannot replace a different panel"))
            (click-sessions)
            (let ((new (nle::chat-model-dialog model)))
              (funcall old model nil)
              (is (eq new (nle::chat-model-dialog model)) "old completion cannot replace a reopened panel")
              (is (getf (gethash new nle::*session-search*) :awaiting) "old completion cannot fill a newer pending panel")
              (funcall pending model nil)
              (is (not (getf (gethash new nle::*session-search*) :awaiting)) "the matching completion fills its own panel"))
            (click-sessions)
            (is (null (nle::chat-model-dialog model)))))))))
