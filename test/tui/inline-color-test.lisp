;;;; inline-color-test.lisp --- safe message colors, copy, wrap and link parity.
(in-package #:nodecode.test)

(deftest inline-color-golden-markup-and-copy ()
  (let ((path (asdf:system-relative-pathname "nodecode" "src/tui/inline-colors.json")))
    (loop for case across (gethash "cases" (nlk:decode-json (uiop:read-file-string path)))
          for source = (gethash "source" case)
          for expected = (gethash "plain" case)
          do (is (equal expected (shown-text source)) (gethash "name" case)))))

(deftest inline-color-paint-wrap-links-shadow-and-memos ()
  (let* ((nle::*palette* (nle::default-palette))
         (row (nle::make-transcript-row :kind :text :role "assistant"
                :text "before <span style=\"color:#B8A1E3\">**λ 界** [link](https://example.org/colors) more words</span> after")))
    (dolist (nle::*color-profile* '(:truecolor :ansi256 :ansi :none))
      (dolist (width '(25 120))
        (dotimes (pass 2)
          (multiple-value-bind (rows plains)
              (nle::llines-rows (nle::row-markdown-llines row (nle::transcript-row-text row) :width width) width)
            (is (notany (lambda (plain) (or (search "span" plain) (search "style=" plain))) plains) "markup never paints or copies")
            (is (every (lambda (plain) (<= (nle::text-display-width plain) width)) plains) "visible rows fit the viewport")
            (loop for text in plains for ansi in rows
                  for at = (search "λ" text)
                  when at
                    do (let* ((x (nle::text-display-width (subseq text 0 at)))
                              (buf (nlt:parse-styled-string (list ansi) width 1))
                              (cell (nlt:screen-buffer-ref buf x 0)))
                         (is (equal (unless (eq nle::*color-profile* :none) (nle::color-sgr '(184 161 227) t nle::*color-profile*)) (nlt:cell-fg cell)) "requested color reaches the cell")
                         (unless (eq nle::*color-profile* :none)
                           (is (logtest nlt::+attr-bold+ (nlt:cell-attrs cell)) "bold remains bold"))))
            (is (find "λ" plains :test #'search) "Unicode prose remains reachable")
            (let* ((plain (find-if (lambda (text) (search "link" text)) plains))
                   (metadata (and plain (nle::plain-row-links plain))))
              (is (equal "https://example.org/colors" (third (first metadata))) "link target survives paint, wrap and memo"))))))
    (let ((nle::*color-profile* :truecolor)
          (thought (nle::make-transcript-row :kind :reasoning :hydrated t
                     :text "<span style=\"color:#B8A1E3\">**λ**</span>")))
      (dolist (mode '(:standard :developer))
        (let ((nle::*tool-detail* mode)
              (nle::*expanded-tool-call* (and (eq mode :developer) thought)))
          (multiple-value-bind (painted plains)
              (nle::llines-rows (nle::row-body-llines thought 120) 120)
            (let* ((plain (first plains))
                   (x (nle::text-display-width (subseq plain 0 (search "λ" plain))))
                   (buf (nlt:parse-styled-string painted 120 1)))
              (is (equal (nle::color-sgr '(125 109 154) t :truecolor) (nlt:cell-fg (nlt:screen-buffer-ref buf x 0))) "Think shadow still dims the requested color"))))))
    (let* ((nle::*color-profile* :truecolor)
           (source (format nil "<span style=\"color:#B8A1E3\">~c[2J</span>" #\Escape))
           (paint (nle::lline-rows (first (nle::markdown-llines source)) 120)))
      (is (search "␛[2J" (first paint)) "raw terminal commands remain pictured, never executed"))))

(deftest inline-color-empty-code-and-streaming ()
  (let* ((source "<span style=\"color:#B8A1E3\">**λ 界**</span>")
         (empty (first (nle::markdown-llines "<span style=\"color:#B8A1E3\"></span>"))))
    (is (= 1 (length (nth-value 1 (nle::lline-rows empty 10)))) "empty markup does not create invisible wrapped rows")
    (loop for end below (length source)
          do (is (null (nle::inline-color-run (subseq source 0 end) 0)) "partial streamed tags cannot activate color"))
    (is (equal '(184 161 227) (fourth (nle::inline-color-run source 0))) "color activates when the region closes")
    ;; The slab's first row is its (here empty) language label.
    (let ((line (second (nle::markdown-llines (format nil "```~%~a~%```" source)))))
      (is (equal source (nle::lline-text line)) "a fenced code block retains its literal markup")
      (is (notany (lambda (span) (nle::visual-style-p (nle::mspan-tone span))) (nle::lline-spans line)) "code does not gain a foreground override"))))

(deftest think-bold-is-ice-blue-with-shadow-only-in-thoughts ()
  (let ((nle::*color-profile* :truecolor)
        (nle::*palette* (nle::default-palette)))
    ;; The strong run mid-paragraph: one a paragraph opens on is its lead, in
    ;; the heading's hue (LEAD-SPANS).
    (dolist (shadow '(nil t))
      (let* ((line (first (nle::markdown-llines "Some **Bold** plain" :shadow shadow)))
             (buf (nlt:parse-styled-string (nle::lline-rows line 80) 80 1)))
        (is (equal (nle::color-sgr (if shadow '(105 131 157) '(253 179 118)) t :truecolor)
                   (nlt:cell-fg (nlt:screen-buffer-ref buf 8 0))) "only reasoning strong changes to the selected shadowed Ice blue")
        (is (equal (nle::color-sgr (if shadow '(159 161 165) '(235 238 244)) t :truecolor)
                   (nlt:cell-fg (nlt:screen-buffer-ref buf 3 0))) "ordinary prose retains its foreground and reasoning shadow")
        (is (logtest nlt::+attr-bold+ (nlt:cell-attrs (nlt:screen-buffer-ref buf 8 0))) "emphasis stays bold")))))
