    (with-temp-file (nle::*shared-config-path*)
      (let ((nle::*account-usage* nil) (nle::*account-free-usage* nil) (nle::*account-login* nil))
        (nle::account-login-save (shasht:read-json +account-linked-free+))
        (nle::persist-shared-model-pin "default_model" "nodecode-free" "nodecode-cyber-v1")
        (multiple-value-bind (text out) (nle::account-logout :request #'signed-out-account)
          (is out)
          (is (search "needs /login or /models" text) "a default model on the free key needs a sign-in too"))
        (is (null (nle::account-credential "nodecode-free")))
        (is (null (nlk:json-value (nle::read-shared-config) :object "providers" "nodecode-free")))))))

(deftest account-models-badge-the-free-cyber-and-say-who-pays ()
  (let ((nle::*account-meter* (list :usage (shasht:read-json +account-usage-credit+)
                                    :free (list :label "Free key" :value "Cyber v1" :tone :success))))
    (destructuring-bind (free paid other)
        (nle::build-models-catalog-picker-rows
         (list (list :provider "nodecode-free" :model "nodecode-cyber-v1" :ctx 262144)
               (list :provider "nodecode" :model "nodecode-cyber-v1" :ctx 1048576)
               (list :provider "deepseek" :model "deepseek-chat" :name "DeepSeek Chat")))
      (is (equal "nodecode-free/nodecode-cyber-v1" (nle::picker-row-label free)))
      (is (equal '("FREE" . :success) (nle::picker-row-badge free)))
      (is (equal "nodecode-free · free" (nle::picker-row-detail free)))
      (is (equal "nodecode · from credit €12.40" (nle::picker-row-detail paid)) "the paid one says what it draws on")
      (is (null (nle::picker-row-badge paid)))
      (is (and (eq :own-model (nle::picker-row-tone free)) (eq :own-model (nle::picker-row-tone paid))))
      (is (equal "deepseek" (nle::picker-row-detail other)))
      (is (equal '("FREE" . :success) (nle::picker-row-badge (nle::models-root-row free))) "a root copy keeps the chip")
      (is (search "FREE" (format nil "~{~a~}" (mapcar #'nle::seg-text (nle::picker-field-segs free :label "nodecode-free/nodecode-cyber-v1" :system)))) "the chip follows the label")
      (is (equal '("nodecode-free" "nodecode") (mapcar (lambda (row) (first (getf (nle::picker-row-value row) :model))) (remove-if #'nle::picker-row-heading (nle::models-own-rows (list free paid other))))) "/models' Nodecode section holds both, the free one first"))))
