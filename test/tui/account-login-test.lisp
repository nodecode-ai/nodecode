(deftest account-sign-in-with-a-free-key-keeps-both-keys-apart ()
  (with-temp-file (nle::*auth-file-path*)
    (with-temp-file (nle::*shared-config-path*)
      (let ((claims '()) (asked '()) (out (make-string-output-stream)))
        (nle::account-login nil :mode "api" :output out :clock (lambda () 0) :wait #'identity
          :open (constantly t)
          :usage-request (lambda (url key timeout)
                           (declare (ignore timeout))
                           (push (list url key) asked)
                           (values (shasht:read-json (if (equal key "free-key-fixture") +account-usage-free+ +account-usage-credit+))
                                   200))
          :request (nlk:lambda-ignoring (method path body poll timeout)
                     (when (eq method :post) (push body claims))
                     (values (shasht:read-json (if (eq method :post) +account-signin-claim+ +account-linked-free+)) 200)))
        (is (eql 2 (nlk:json-value (first claims) :integer "keys")) "the claim says this machine keeps a free key apart")
        (is (equal "machine-key-fixture" (nlk:json-value (nle::read-auth-file nle::*auth-file-path*) :string "api_keys" "nodecode" "key")))
        (is (equal "free-key-fixture" (nlk:json-value (nle::read-auth-file nle::*auth-file-path*) :string "api_keys" "nodecode-free" "key")))
        (is (equal "https://api.nodecode.ai/v1" (nlk:json-value (nle::read-shared-config) :string "providers" "nodecode-free" "base_url")))
        (is (equal "openai-completions" (nle::configured-provider-lane "nodecode-free")))
        (is (equal '("nodecode-free" "nodecode-cyber-v1") (subseq (multiple-value-list (nle::shared-model-pin)) 0 2)) "the free model runs on the free key")
        (is (equal '(("https://api.nodecode.ai/v1/usage" "free-key-fixture") ("https://api.nodecode.ai/v1/usage" "machine-key-fixture")) asked))
        (let ((text (get-output-stream-string out)))
          (is-carrying text "Account key and free key saved" "API credit: €12.40" "Free key: Cyber v1 at no cost from this CLI"
            "Default model: nodecode-free nodecode-cyber-v1. Run nodecode to start."
            (:absent "free-key-fixture") (:absent "machine-key-fixture")))
        ;; A sign-in without a free key takes back the one an earlier sign-in saved.
        (nle::account-login-save (shasht:read-json +account-linked+))
        (is (null (nle::account-credential "nodecode-free")))
        (is (null (nlk:json-value (nle::read-shared-config) :object "providers" "nodecode-free")))
        (is (equal "machine-key-fixture" (nle::account-credential)))))))

(deftest account-logout-forgets-the-free-key-too ()
