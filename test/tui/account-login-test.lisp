(defmacro with-linked-home (() &body body)
  "BODY in a home signed in by a link (+ACCOUNT-LINKED+, request ...0002, poll-secret-fixture)."
  `(with-temp-file (nle::*auth-file-path*)
     (with-temp-file (nle::*shared-config-path*)
       (let ((nle::*account-usage* nil) (nle::*account-free-usage* nil) (nle::*account-login* nil))
         (nle::account-login-save (shasht:read-json +account-linked+))
         (nle::save-machine-link "00000000-0000-0000-0000-000000000002" "poll-secret-fixture")
         ,@body))))

(defun home-signed-out-p ()
  "Whether this home holds no nodecode.ai key and no link."
  (and (null (nle::account-credential))
       (null (nlk:json-value (nle::read-auth-file nle::*auth-file-path*) :object "machine_link"))))

(deftest account-logout-signs-the-machine-out-on-the-account ()
  ;; A sign-out that only forgot the key here left it answering on the account: the machine signs
  ;; itself out there first, with its link's own secret, so the key is revoked.
  (with-linked-home ()
    (let ((calls '()))
      (multiple-value-bind (text out)
          (nle::account-logout :request (lambda (&rest args) (push args calls) (signed-out-account nil nil nil nil nil)))
        (is out)
        (is (equal '((:delete "/api/link/00000000-0000-0000-0000-000000000002" nil "poll-secret-fixture" 10)) calls) "one DELETE of the link, proved by its poll secret")
        (is (search "key is ended on the account" text))
        (is (not (search "account/machines" text)) "nothing is left to remove by hand"))
      (is (home-signed-out-p))))
  (with-linked-home ()
    (multiple-value-bind (text out)
        (nle::account-logout :request (lambda (&rest args) (declare (ignore args))
                                        (values (nlk:json-object "error" "This machine was already signed out.") 410)))
      (is out)
      (is (search "had signed this machine out already" text) "a machine signed out on the Machines page is no failure"))
    (is (home-signed-out-p)))
  (with-linked-home ()
    (multiple-value-bind (text out)
        (nle::account-logout :request (lambda (&rest args) (declare (ignore args)) (error "nodecode.ai did not answer within 10s.")))
      (is out)
      (is (search "nodecode.ai was not told (nodecode.ai did not answer within 10s)" text) "it says the account kept the key, and why")
      (is (search "https://nodecode.ai/account/machines" text) "and where to end it"))
    (is (home-signed-out-p) "the home is signed out all the same"))
  (with-linked-home ()
    (multiple-value-bind (text out)
        (nle::account-logout :request (lambda (&rest args) (declare (ignore args))
                                        (values (nlk:json-object "error" "That is not this link's secret.") 401)))
      (is out)
      (is (search "was not told (That is not this link's secret (HTTP 401))" text) "a refusal is named")))
  ;; A key with no link (put in by hand, or from before links) has nothing to sign out with.
  (with-temp-file (nle::*auth-file-path*)
    (with-temp-file (nle::*shared-config-path*)
      (let ((nle::*account-usage* nil) (nle::*account-free-usage* nil) (nle::*account-login* nil))
        (nle::account-login-save (shasht:read-json +account-linked+))
        (multiple-value-bind (text out) (nle::account-logout :request (lambda (&rest args) (error "asked the account: ~s" args)))
          (is out)
          (is (search "https://nodecode.ai/account/machines to end its key there too" text) "no link: it says where the key ends"))
        (is (null (nle::account-credential)))))))

(deftest account-logout-forgets-the-key-and-the-link-and-says-so ()
  (is (equal '(nil (:logout) nil nil nil nil nil) (launch-plan "logout")))
  (is (search "no argument" (launch-refusal "logout" "now")))
