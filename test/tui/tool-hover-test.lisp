(in-package :nodecode.test)

(defun hover-accented (title &aux (accented (nle::copy-lline title)))
  "A copy of TITLE as the disclosure hover paints it: the accent tone, no
shadow, and every span giving its own tone up to the accent."
  (setf (nle::lline-tone accented) :disclosure-hover
        (nle::lline-shadow accented) nil
        (nle::lline-spans accented)
        (mapcar (lambda (span &aux (copy (nle::copy-mspan span)))
                  (setf (nle::mspan-tone copy) nil) copy)
                (nle::lline-spans title)))
  accented)

(defun is-hover-accenting-the-title-alone (row width expanded)
  "With *EXPANDED-TOOL-CALL* bound to EXPANDED, the pointer on ROW repaints its
title alone, in the disclosure accent; a memo hit answers the hovered block, and
the pointer leaving answers the quiet one."
  (let* ((nle::*expanded-tool-call* expanded)
         (nle::*hover-row* nil)
         (quiet (nle::row-display-block row :width width))
         (title (first (nle::row-body-llines row width))))
    (let* ((nle::*hover-row* row)
           (hovered (nle::row-display-block row :width width))
           (again (nle::row-display-block row :width width)))
      (is (equal (first (nle::lline-render (hover-accented title) width))
                 (first (nle::display-block-lines hovered))) "every span of the Standard title takes the disclosure accent, with no background")
      (is (equal (rest (nle::display-block-lines quiet))
                 (rest (nle::display-block-lines hovered))) "hover leaves the body untouched")
      (is (equal (nle::display-block-plain-lines quiet) (nle::display-block-plain-lines hovered)))
      (is (eq hovered again) "memo hit preserves the same painted block")
      (is (not (eq :disclosure-hover (nle::lline-tone title))) "the shared title is unchanged"))
    (is (equal (nle::display-block-lines quiet)
               (nle::display-block-lines (nle::row-display-block row :width width))))))

(deftest standard-open-process-members-share-the-disclosure-hover-policy ()
  ;; Opened, a run lists its calls and receipts a line each, and a click
  ;; opens one, so the pointer accents each line as it does the run's title.
  (let* ((nle::*color-profile* :truecolor)
         (nle::*tool-detail* :standard)
         (state (nle::ingest-message-fact (mutation-collapse-state) "assistant" nil
                  :reasoning "First λ thought" :turn-id "mutate-turn"))
         (state (nle::ingest-turn-terminal state "completed" :turn-id "mutate-turn"))
         (group (nle::display-block-row (second (nle:project-state state :width 100))))
         (nle::*expanded-tool-call* (nle::tool-group-key group))
         (thought (find :reasoning (nle::tool-group-members group) :key #'nle::transcript-row-kind)))
    (is (not (member thought (nle::display-block-refs (nle::tool-group-display-block group 100)))) "a thought is no line of it")
    (dolist (member (remove-if-not #'nle::run-trail-row-p (nle::tool-group-members group)))
      (let* ((nle::*hover-row* nil)
             (quiet (nle::tool-group-display-block group 100))
             (index (position member (nle::display-block-refs quiet) :test #'eq))
             (title (nle::run-tail-lline member 100)))
        (is index "every listed member retains its own hover/click identity")
        (let* ((nle::*hover-row* member)
               (hovered (nle::tool-group-display-block group 100)))
          (is (equal (first (nle::lline-render (nle::disclosure-hover-lline title) 100))
                     (nth index (nle::display-block-lines hovered))) "a call's line and a receipt's take the same accent")
          (is (equal (nle::display-block-plain-lines quiet) (nle::display-block-plain-lines hovered)))
          (loop for before in (nle::display-block-lines quiet)
                for after in (nle::display-block-lines hovered)
                for i from 0 unless (= i index)
                  do (is (equal before after) "only the hovered member title changes")))))))

(deftest standard-tool-hover-accents-only-the-disclosure-title (dolist (transparent '(t nil)))
  (dolist (profile '(:truecolor :ansi256 :ansi :none))
    (let ((nle::*palette* (theme-palette "Tungstene" :user
                           (if transparent nil "{\"themes\":[{\"name\":\"Tungstene\",\"transparent-background\":false}]}")))
          (nle::*color-profile* profile)
          (nle::*tool-detail* :standard))
      (dolist (name '("eval" "mcp:chrome/snapshot" "probe"))
        (dolist (status '("running" "done" "error"))
          (let* ((row (nle::make-transcript-row :kind :tool-call :tool-name name
                                              :tool-call-id "hover-call"
                                              :tool-args (eval-args ";; Inspect λ tools")
                                              :tool-status status :text "body remains unchanged")))
            (dolist (open '(nil t))
              ;; Retain bold/links but let every title span inherit the accent.
              (is-hover-accenting-the-title-alone row 80 (and open "hover-call")))))))))

(deftest standard-think-hover-accents-the-closed-title-not-open-prose ()
  (dolist (profile '(:truecolor :ansi256 :ansi :none))
    (let* ((nle::*color-profile* profile)
           (nle::*tool-detail* :standard)
           (row (nle::make-transcript-row :kind :reasoning :hydrated t
                   :text (format nil "**First λ thought** [link](https://example.com)~%Second thought"))))
      (dolist (open '(nil t))
        (let* ((nle::*expanded-tool-call* (and open row))
               (nle::*hover-row* nil)
               (quiet (nle::row-display-block row :width 100))
               (title (first (nle::row-body-llines row 100))))
          (let* ((nle::*hover-row* row)
                 (hovered (nle::row-display-block row :width 100))
                 (accented (hover-accented title)))
            (is (equal (nle::display-block-plain-lines quiet) (nle::display-block-plain-lines hovered)))
            (is (equal (if open (nle::display-block-lines quiet) (nle::lline-render accented 100))
                       (nle::display-block-lines hovered)) "closed Think title takes the same unshadowed accent; open prose stays unchanged")
            (is (eq hovered (nle::row-display-block row :width 100)))
            (is (not (eq :disclosure-hover (nle::lline-tone title))))
            (let* ((plain (first (nle::display-block-plain-lines hovered)))
                   (paint (first (nle::display-block-lines hovered)))
                   (cells (nlt:parse-styled-string (list paint) 100 1)))
              (loop for (x uri) in (link-glyphs plain)
                    do (is (or (eq profile :none)
                               (equal uri (nlt:cell-link (nlt:screen-buffer-ref cells x 0)))))))
          (let ((nle::*hover-row* nil))
            (is (equal (nle::display-block-lines quiet)
                       (nle::display-block-lines (nle::row-display-block row :width 100)))))))))))

(deftest standard-mutation-hover-accents-only-the-disclosure-title ()
  (dolist (profile '(:truecolor :ansi256 :ansi :none))
    (let* ((nle::*color-profile* profile)
           (nle::*tool-detail* :standard)
           (row (nle::make-transcript-row :kind :system-notice :text "Full load receipt"
                  :retention :live-only :metadata (nlk:json-object "summary"
                    (nlk:json-object "name" "Mutate" "comment" "Rewrite λ viewport")))))
      (dolist (open '(nil t))
        (is-hover-accenting-the-title-alone row 100 (and open row))))))

(deftest standard-think-hover-and-click-use-the-same-row-owner ()
  (with-frame-model (model 90 28 :session-id "standard-think-hover" :tool-detail :standard
                     :paint ((nle::ingest-message-fact "assistant" nil :reasoning (format nil "First thought~%Second thought"))
                             (nle::ingest-message-fact "assistant" "plain prose")))
    (let* ((index (line-row-index model :kind :reasoning))
           (owner (aref (nle::chat-model-line-rows model) index))
           (y (mouse-y-for-line model index)))
      (mouse-update model #'nlt:make-mouse-motion-msg 6 y)
      (is (eq owner (nle::chat-model-hover-row model)))
      (click-at model 6 y)
      (is (eq owner (nle::chat-model-expanded-tool-call model)))
      (is (rows-carry-p "Second thought" (coerce (nle::chat-model-line-plain model) 'list)))
      (click-at model 6 y)
      (is (null (nle::chat-model-expanded-tool-call model))))))

(deftest standard-tool-hover-and-click-use-the-same-row-owner ()
  (with-frame-model (model 90 28 :session-id "standard-tool-hover" :tool-detail :standard)
    (paint-model model
      (nle::ingest-tool-call-fact "hover-call" "eval" (eval-args ";; Inspect λ tools"))
      (nle::ingest-tool-result-fact "hover-call" "eval" "body remains unchanged")
      (nle::ingest-message-fact "assistant" "plain prose"))
    (let* ((index (line-row-index model :kind :tool-call))
           (owner (aref (nle::chat-model-line-rows model) index))
           (y (mouse-y-for-line model index)))
      (mouse-update model #'nlt:make-mouse-motion-msg 6 y)
      (is (eq owner (nle::chat-model-hover-row model)))
      (click-at model 6 y)
      (is (equal "hover-call" (nle::chat-model-expanded-tool-call model)))
      (is (rows-carry-p "body remains unchanged" (coerce (nle::chat-model-line-plain model) 'list)))
      (mouse-update model #'nlt:make-mouse-motion-msg 6
                    (mouse-y-for-line model (line-row-index model :kind :text)))
      (is (null (nle::chat-model-hover-row model)))
      (click-at model 6 y)
      (is (null (nle::chat-model-expanded-tool-call model))))))
