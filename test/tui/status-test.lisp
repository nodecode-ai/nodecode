(in-package #:nodecode.test)

(defun status-fixture ()
  (nle::json-object
   "as_of" 1700000000
   "identity" (nle::json-object "version" "effective-2" "build" "binary-1"
                                 "profile" "fixture" "started_at" 1699999900)
   "mode" "shell"
   "health" (nle::health-facts-json
              (list (nle::health-fact :model "model" "fixture-model on fixture")
                    (nle::health-fact :cells "cells" "2 loaded · 1 FAILED" :tone :danger)
                    (nle::health-fact :cell "broken" "reader refused" :tone :danger
                                            :remedy "/cells names the condition")
                    (nle::health-fact :sessions "sessions" "84")))
   "notices" (vector (nle::notice-payload "connected" :info "chat")
                     (nle::notice-payload "missed fire" :warning "job"))
   "activity" (nle::session-activity-payload '(("active-fixture" . "2023-11-14T22:12:00Z")))))

(deftest status-prioritizes-typed-attention-and-keeps-runtime-identities-separate ()
  (let* ((rows (nle::status-lines (status-fixture) nil :now 1700000000))
         (text (nle::status-report-text (status-fixture) nil :now 1700000000)))
    (is (equal "Needs attention" (getf (first rows) :label)))
    (is (< (search "reader refused" text) (search "Runtime" text)))
    (is (< (search "missed fire" text) (search "Runtime" text)))
    (is-carrying text "/cells" "effective-2" "binary-1" "Default model"
      ("84" "historical sessions remain separate") "active-fixture")
    (is (= 1 (count "missed fire" rows :test #'equal :key (lambda (row) (getf row :detail)))))))

(deftest status-absence-is-unavailable-and-unpriced-spend-is-a-floor ()
  (let ((failed (list :error "gateway disconnected")))
    (let ((text (nle::status-report-text failed failed :now 1700000000)))
      (is-carrying text "unavailable" (:absent "$0") (:absent "No reported warnings"))))
  (let* ((usage (nle::json-object "totals" (nle::json-object "cost_usd" 1.25 "unpriced" 2
                                 "calls" 4 "turns" 3 "failed_turns" 1)))
         (text (nle::status-report-text (status-fixture) usage :usage-at 1700000000
                                       :now 1700000000)))
    (is-carrying text "at least $1.25" "2 unpriced" "API-equivalent" "TTFT" (:absent "0 ms"))))

(deftest status-panel-held-replies-cannot-reopen-replace-or-overwrite (with-temp-store ())
  (let ((model (make-frame-model 100 40)))
    (with-stubbed-fdefinition (nle::off-loop (model thunk continuation) nil)
      (nle::slash-status-op model)
      (let ((closed model.dialog))
        (nle:update model (nlt:make-key-press-msg :code :escape))
        (is (null model.dialog))
        (is (eq :quiet (nle::install-status-read model closed :snapshot (status-fixture))))
        (is (null model.dialog)))
      (nle::slash-status-op model)
      (let ((replaced model.dialog))
        (nle::open-picker-dialog model "Other" '() nil :kind :other)
        (is (eq :quiet (nle::install-status-read model replaced :snapshot (status-fixture))))
        (is (eq :other (nle::picker-dialog-kind model.dialog))))
      (nle::slash-status-op model)
      (let ((old model.dialog))
        (nle::slash-status-op model)
        (let ((fresh model.dialog))
          (is (eq :quiet (nle::install-status-read model old :snapshot (status-fixture))))
          (is (eq fresh model.dialog))
          (is (not (search "effective-2" (format nil "~{~a~}" (row-labels fresh))))))))))

(deftest status-catalog-and-headless-are-sessionless-and-share-the-projection (with-temp-store ())
  (let ((entry (nle::find-slash-command "status"))
        (before (nle::session-count)))
    (is entry)
    (is (null (nle::slash-command-session entry)))
    (is (eq 'nle::headless-status (nle::slash-command-headless entry)))
    (is (find "status" (nle:slash-catalog) :key (lambda (row) (getf row :name)) :test #'equal))
    (is (find "status" (nle::slash-suggestions "/stat") :key #'nle::slash-command-name :test #'equal))
    (with-stubbed-fdefinitions ((nle::status-json (&optional session-id) (status-fixture))
                               (nle::usage-json (range) (is (equal "today" range))
                                 (nle::json-object "totals" (nle::json-object "calls" 0 "turns" 0))))
      (is (search "effective-2" (nle:slash "/status")))
      (is (search "does not take arguments" (nle:slash "/status surprise")))
      (is (equal "Usage: /status" (nle:slash "/status --help"))))
    (is (= before (nle::session-count)))))

(deftest status-projection-is-passive-partial-and-operator-only (with-temp-gateway (port))
  (with-stubbed-fdefinitions
      ((nle::doctor-facts () (error "status must not run doctor"))
       (nle::activity-json (range) (error "status must not classify historical steps"))
       (nle::usage-json (range) (error "usage belongs on its separate read"))
       (nle::health-facts () (error "fixture health unavailable")))
    (with-gateway-http (port :get "/api/gateway/overview" :status 200)
      (is (search "fixture health unavailable" (nlk:json-value body :string "health" "error")))
      (is (nlk:json-value body :string "identity" "version"))
      (is (vectorp (gethash "notices" body)))
      (is (vectorp (nlk:json-value body :any "activity" "sessions"))))
    (is-route (port :get "/api/gateway/overview" :token nil) 401 "the operator's overview")))

(deftest status-pushed-facts-win-over-an-older-read-and-clear-by-key (with-temp-store ())
  (let ((model (make-frame-model 100 40)))
    (setf (nle::gateway-model-sync-lifecycle model) :connected)
    (with-stubbed-fdefinition (nle::off-loop (model thunk continuation) nil)
      (nle::slash-status-op model)
      (let ((dialog model.dialog))
        ;; A frame lands before the HTTP snapshot completes.
        (nle::refresh-status-dialog model :board (nle::json-object "notices" (vector (nle::notice-payload "new warning" :warning "job"))))
        (nle::ingest-session-activity model (nle::session-activity-payload '()))
        (nle::refresh-status-dialog model :activity t)
        (nle::install-status-read model dialog :snapshot (status-fixture))
        (let ((text (format nil "~{~a~^~%~}" (mapcar #'nle::picker-row-detail (nle::picker-dialog-rows dialog)))))
          (is-carrying text "new warning" (:absent "missed fire")))
        (is (not (find "active-fixture" (nle::picker-dialog-rows dialog)
                       :key #'nle::picker-row-label :test #'equal)))
        (nle::refresh-status-dialog model :board (nle::json-object "notices" #()))
        (is (not (member "job" (row-labels dialog) :test #'equal)))
        (is (null (nle::picker-dialog-on-tick dialog)) "an idle panel arms no polling clock")
        (nle:update model (make-instance 'nle::gw-transport-error-msg :text "fixture dropped" :verdict :reconnecting))
        (is (member "Live updates unavailable" (row-labels dialog) :test #'equal))))))

(deftest status-panel-paints-normal-and-narrow-without-writing-session-state (with-temp-store ())
  (dolist (width '(110 48))
    (let ((model (make-frame-model width 40)))
      (setf (nle::gateway-model-sync-lifecycle model) :connected)
      (with-stubbed-fdefinitions
          ((nle::gateway-model-http-call (model method path body &rest options)
             (cond ((search "overview" path) (status-fixture))
                   ((search "usage" path) (nle::json-object "totals" (nle::json-object "calls" 0 "turns" 0)))
                   (t (error "unexpected dial ~a" path)))))
        (nle::execute-slash-command model "status" "")
        (is (eq :status (nle::picker-dialog-kind model.dialog)))
        (is (picker-selected-value model.dialog))
        (let ((rows (nle::dialog-panel-rows model width nil)))
          (is (some (lambda (line) (search "Status" line)) rows))
          (is (some (lambda (line) (search "Today" line)) rows))
          ;; A head is its label, then its note -- each cut to the panel's columns.
          (dolist (section '(("Runtime" "snapshot") ("Connections" "standing")
                             ("Work now" "live set") ("Today" "API-equiv")))
            (is-let* ((index (position-if (lambda (line &aux (at (search (first section) line)))
                                            (and at (search (second section) line
                                                            :start2 (+ at (length (first section))))))
                                          rows)))
              (index is) ((nle::trimmed (nth (1- index) rows)) "")))
          (is (not (some (lambda (line) (search "Version  Version" line)) rows)))
          (is (every (lambda (line) (<= (nle::text-display-width line) width)) rows)))
        (dotimes (step (* 2 (length (nle::picker-dialog-rows model.dialog))))
          (nle:update model (nlt:make-key-press-msg :code :down))
          (is (picker-selected-value model.dialog)))
        (nle:update model (nlt:make-key-press-msg :code :escape))
        (is (null model.dialog))))))

(deftest status-standing-board-pushes-quiet-updates-and-clears-without-toasts ()
  (with-gateway-session (port "status-board")
    ;; A peer an earlier test left behind may have had its board long ago:
    ;; the wait is for this connection's.
    (let* ((others (sb-ext:with-locked-hash-table (nle::*gateway-peer-states*)
                     (loop for state being the hash-values of nle::*gateway-peer-states*
                           collect state)))
           (frames (frames-while (ws port :subscribe '("status-board"))
                     (is-eventually
                      (sb-ext:with-locked-hash-table (nle::*gateway-peer-states*)
                        (loop for state being the hash-values of nle::*gateway-peer-states*
                              thereis (and (not (member state others))
                                           (nle::gw-peer-state-board-sent-p state)))) "subscription has sent its board")
                     (bt2:with-lock-held (nle::*standing-notice-publication-lock*) nil)
                     (nle:notice "quiet connected" :key "status-board-cell" :level :quiet)
                     (nle:notice "quiet connected" :key "status-board-cell" :level :quiet)
                     (nle:notice nil :key "status-board-cell")))
           (boards (frames-of-type frames "organism.notices")))
      (flet ((ours (board)
               ;; Another cell's standing notice may stand on the board too.
               (count "status-board-cell" (nlk:json-array (gethash "payload" board) "notices")
                      :key (lambda (notice) (gethash "key" notice)) :test #'equal)))
        (is (= 3 (length boards)) "subscribe, quiet change, then clear")
        (is (= 1 (ours (second boards))))
        (is (zerop (ours (third boards)))))
      (is (null (frames-of-type frames "organism.notice")) "no quiet/clear toast"))))

(deftest status-sections-have-single-nonselectable-gaps-in-panel-and-text ()
  (let* ((snapshot (status-fixture))
         (rows (nle::status-lines snapshot nil :now 1700000000))
         (panel (nle::status-panel-rows (list :snapshot snapshot :usage nil)))
         (text (nle::status-report-text snapshot nil :now 1700000000)))
    (is (= 4 (count "" rows :key (lambda (row) (getf row :label)) :test #'equal)))
    (is (plusp (length (getf (first rows) :label))))
    (is (plusp (length (getf (car (last rows)) :label))))
    (dolist (section '("Runtime" "Connections & cells" "Work now" "Today · this store"))
      (let* ((index (position section rows :key (lambda (row) (getf row :label)) :test #'equal))
             (gap (and index (plusp index) (nth (1- index) rows)))
             (panel-gap (and index (plusp index) (nth (1- index) panel))))
        (is index)
        (is-shape gap (:label "") (:detail ""))
        (is (null (getf gap :action)))
        (is-shape panel-gap (nle::picker-row-heading is) (nle::picker-row-value null)
          (nle::picker-row-mark ""))
        (is (not (equal "" (getf (nth (- index 2) rows) :label))))
        (is (search (format nil "~%~%~a  " section) text))))))
