(in-package #:nodecode.test)

(deftest eval-condition-code-rides-the-result-not-its-text ()
  (let ((nle::*executing-tool-call-id* "eval-error-code")
        (nle::*tool-result-metadata* nil))
    (multiple-value-bind (text failed) (nle::eval-string "(car 5)")
      (is failed)
      (is (search "TYPE-ERROR" text))
      (is (equal "TYPE-ERROR" (nlk:json-value nle::*tool-result-metadata* :string "error" "code")))))
  (let ((nle::*executing-tool-call-id* "eval-reader-code")
        (nle::*tool-result-metadata* nil))
    (nle::eval-string "\"never closed")
    (is (equal "READER-ERROR" (nlk:json-value nle::*tool-result-metadata* :string "error" "code")))))

(deftest standard-eval-error-header-keeps-code-and-folds-body ()
  (let ((row (tool-row "eval" (eval-args (format nil ";; Inspect λ tools~%(car 5)"))
                       :tool-call-id "eval-failed" :tool-status "error" :error-p t
                       :text "The actual condition report"
                       :metadata (nlk:json-object "error" (nlk:json-object "code" "TYPE-ERROR")))))
    (dolist (mode '(:standard :developer))
      (let* ((nle::*tool-detail* mode)
             (nle::*expanded-tool-call* nil)
             (block (nle::row-display-block row :width 90))
             (lines (nle::display-block-plain-lines block)))
        (is (rows-carry-p "TYPE-ERROR" block.lines) "the code survives a closed card in either viewport")
        (is (eq (eq mode :developer) (rows-carry-p "The actual condition report" lines))))
      (let ((nle::*tool-detail* mode) (nle::*expanded-tool-call* "eval-failed"))
        (is (rows-carry-p "The actual condition report" (nle::display-block-plain-lines (nle::row-display-block row :width 90))))))
    (let ((row (tool-row "eval" (eval-args "(format t \"ERROR: TYPE-ERROR: not a failure\")")
                         :tool-status "complete" :text "ERROR: TYPE-ERROR: not a failure")))
      (is (not (search "failed" (nle::lline-text (nle::tool-summary-lline row))))))))

(deftest shell-load-failure-stays-inside-its-eval-card (with-source-tree (root))
  (let* ((model (detached-shell "eval-load-failure"))
         (path (merge-pathnames "eval-broken-load.lisp" root)))
    (write-temp-file path (format nil "(in-package #:nodecode.evolved)~%(defparameter *eval-broken-load* (error \"load refused\"))~%"))
    (with-stubbed-fdefinition (nle::render-state (m) nil)
      (setf (nle::chat-model-state model)
            (nle::ingest-tool-call-fact nil "load-origin" "eval" (eval-args ";; Keep the result") :turn-id "load-turn"))
      (feed-wire model
                 (nlk:encode-unsequenced-frame
                  "organism.loaded"
                  (nlk:json-object "path" (namestring path)
                                   "session_id" "eval-load-failure" "turn_id" "load-turn"
                                   "call_id" "load-origin"
                                   "definitions" (vector (nlk:json-object "operator" "DEFPARAMETER" "label" "*eval-broken-load*")))))
      (setf (nle::chat-model-state model)
            (nle::ingest-tool-result-fact (nle::chat-model-state model) "load-origin" "eval" "42" :turn-id "load-turn"))
      (let* ((state (nle::chat-model-state model))
             (rows (nle::transcript-rows state))
             (row (first rows)))
        (is (= 1 (length rows)) "no standalone red diagnostic splits the work trail")
        (is (eq :tool-call (nle::transcript-row-kind row)))
        (let ((nle::*tool-detail* :standard) (nle::*expanded-tool-call* nil))
          (let ((lines (nle::display-block-plain-lines (nle::row-display-block row :width 90))))
            (is (rows-carry-p "SHELL-LOAD-FAILED" lines))
            (is (not (rows-carry-p "load refused" lines)))))
        (dolist (mode '(:standard :developer))
          (let ((nle::*tool-detail* mode) (nle::*expanded-tool-call* "load-origin"))
            (is (rows-carry-p "load refused" (nle::display-block-plain-lines (nle::row-display-block row :width 90))))))
        (let* ((nle::*tool-detail* :standard)
               (state (nle::ingest-turn-terminal state "completed" :turn-id "load-turn"))
               (items (nle::group-rows (nle::transcript-rows state))))
          (is (nle::tool-group-p (first items)) "the completed trail remains one disclosure"))))))

(deftest shell-load-errors-use-exact-call-and-turn-ownership ()
  (let* ((state (nle::ingest-tool-call-fact nil "first" "eval" "{}" :turn-id "turn-a"))
         (state (nle::ingest-tool-call-fact state "second" "eval" "{}" :turn-id "turn-a"))
         (rows (nle::transcript-rows state)))
    (is (eq nil (nle::ingest-tool-load-error state "missing" "turn-a" "wrong call")))
    (is (eq nil (nle::ingest-tool-load-error state "first" "turn-b" "wrong turn")))
    (is (eq t (nle::ingest-tool-load-error state "first" "turn-a" "shell refused first")))
    (is (null (nle::row-load-errors (second rows))))
    (setf state (nle::ingest-tool-result-fact state "first" "eval" "success" :turn-id "turn-a"))
    (is (equal '("shell refused first") (nle::row-load-errors (first rows))) "the durable successful result cannot erase the live-only shell error")
    (is (equal "complete" (nle::transcript-row-tool-status (first rows))))
    (is (null (nle::transcript-row-error-p (first rows))))
    (let ((nle::*tool-detail* :standard) (nle::*expanded-tool-call* nil))
      (let ((block (nle::row-display-block (first rows) :width 100)))
        (is (rows-carry-p "SHELL-LOAD-FAILED" (nle::display-block-plain-lines block)))
        (is (not (rows-carry-p "shell refused first" (nle::display-block-plain-lines block))))))))

(deftest loaded-frame-carries-typed-exact-call-provenance ()
  (let ((seen nil)
        (nle::*executing-tool-call-id* "exact-eval-call")
        (nle::*current-durable-turn* (nlk::%make-durable-turn :session-id "s" :turn-id "turn-a" :command-id "c" :definition-revision "base")))
    (with-stubbed-fdefinition (nle::broadcast-organism (kind payload)
                               (setf seen payload) (values t 1))
      (nle::announce-loaded #p"/tree/probe.lisp" '(("DEFUN" . "probe")))
      (is-shape seen ((:string "call_id") "exact-eval-call") ((:string "turn_id") "turn-a"))
      (let ((nle::*executing-tool-call-id* nil))
        (nle::announce-loaded #p"/tree/probe.lisp" '(("DEFUN" . "probe")))
        (is (null (nlk:json-value seen :any "call_id"))))))
  (dolist (bad '(7 ""))
    (is (signals-error nlk:protocol-error
          (nlk:decode-sync-message
           (nlk:encode-unsequenced-frame "organism.loaded"
            (nlk:json-object "path" "/tree/probe.lisp" "definitions" #() "call_id" bad)))))))
