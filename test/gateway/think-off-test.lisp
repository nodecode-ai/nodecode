;;;; think-off-test.lisp --- Explicit Off is not the provider default.
;;;; SPDX-License-Identifier: MIT

(in-package #:nodecode.test)

(deftest think-off-keeps-the-native-enabled-ladder ()
  (let ((nle::*models-catalog-path* nil)
        (nle::*model-capability-overrides*
          '(("native-reasoner" . (:effort-levels ("low" "high" "max")))
            ("explicit-off" . (:effort-levels ("off" "low" "high")))
            ("plain-model" . (:reasoning-p nil)))))
    (is (equal '("off" "low" "high" "max")
               (nle::effort-ladder "openai-responses" "native-reasoner")) "Off is a toggle beside the native enabled efforts")
    (is (equal '("off" "low" "high")
               (nle::effort-ladder "openai-responses" "explicit-off")) "an advertised Off appears only once")
    (is (equal "off" (nle::check-effort "openai-responses" "native-reasoner" "off")))
    (is (null (nle::check-effort "openai-responses" "native-reasoner" nil)) "Default remains a separate choice")
    (is (null (nle::effort-ladder "openai-responses" "plain-model")))
    (is (signals-error nle::effort-refusal
          (nle::check-effort "openai-responses" "native-reasoner" "minimal")) "no enabled rung is invented")))

(deftest think-off-responses-disables-instead-of-defaulting ()
  (let ((nle::*provider* "openai-responses")
        (nle::*temperature* 0.7))
    (flet ((body (effort &aux (nle::*reasoning-effort* effort))
             (nle::responses-request-body (user-context "hi"))))
      (let* ((off (body "off"))
             (reasoning (gethash "reasoning" off)))
        (is (equal "none" (nlk:json-value reasoning :string "effort")) "Off must cross the wire explicitly")
        (is (null (nth-value 1 (gethash "summary" reasoning))) "disabled reasoning requests no summary")
        (is (null (nth-value 1 (gethash "include" off))))
        (is (= 0.7 (gethash "temperature" off))))
      (is (null (nth-value 1 (gethash "reasoning" (body nil)))) "Default alone omits the reasoning control")
      (let ((high (body "high")))
        (is (equal "high" (nlk:json-value high :string "reasoning" "effort")))
        (is (equalp #("reasoning.encrypted_content") (gethash "include" high)))
        (is (null (nth-value 1 (gethash "temperature" high))))))))

(deftest think-off-picker-and-command-share-the-gateway ()
  (with-saved-globals
      ((nle::*reasoning-effort* "high")
       (nle::*model-capability-overrides*
         '(("native-reasoner" . (:effort-levels ("low" "high")))))
       (nle::*models-catalog-path* nil))
    (with-gateway-frame (model "think-off" "openai-responses" "native-reasoner")
      (with-slash-dialog (dialog model "think" "") "/think opens silently"
        (is (equal '(nil "off" "low" "high") (mapcar #'nle::picker-row-value dialog.rows)))
        (is (equal "Answer without reasoning." (nle::picker-row-detail (second dialog.rows))))
        (is (= 3 dialog.selection)))
      ;; Starting at high, two Up keys select Off, not Default.
      (dialog-keys model :up :up :enter)
      (is (null (nle::chat-model-dialog model)))
      (is (equal "off" (session-effort "think-off")))
      (is (equal "off" nle::*reasoning-effort*) "the choice becomes the next-turn default too")
      (is (equal "off" (nlk:json-value (nle::gateway-target-json :session-id "think-off") :string "effort")))
      (nle::execute-slash-command model "think" "")
      (let ((dialog model.dialog))
        (is (= 1 dialog.selection))
        (is (equal "current" (nle::picker-row-detail (second dialog.rows)))))
      (dialog-keys model :up :enter)
      (is (null (session-effort "think-off")) "Default clears the explicit disable")
      (multiple-value-bind (notice command) (nle::execute-slash-command model "think" "off")
        (is (null command) "the supplied-argument form starts no turn")
        (is (search ": off; applies from the next turn" notice)))
      (is (equal "off" (session-effort "think-off")))
      (is (search "ladder: off low high" (nle:slash "/think" :session-id "think-off")) "the headless surface reads the same ladder")
      (nle:slash "/think default" :session-id "think-off")
      (is (null (session-effort "think-off")))
      (nle:slash "/think off" :session-id "think-off")
      (is (equal "off" (session-effort "think-off")))
      (is (signals-error nle::effort-refusal (nle:slash "/think bogus" :session-id "think-off")))
      (is (equal "off" (session-effort "think-off")) "a refused pick leaves the disable intact"))))

(deftest think-off-rides-the-frozen-turn-config (with-session-store ("think-off-run"))
  (let ((nle::*models-catalog-path* nil)
        (nle::*model* "native-reasoner")
        (nle::*provider* "openai-responses")
        (nle::*reasoning-effort* "high")
        (nle::*model-capability-overrides*
          '(("native-reasoner" . (:effort-levels ("low" "high")))))
        (seen nil))
    (nlk:record-session-model-selection "think-off-run" :effort "off")
    (with-provider-stub
        (context
         (setf seen (nle::responses-request-body context))
         (wire-message "assistant" :content "ok"))
      (nle:run "hello" :session (nle:intern-session "think-off-run")))
    (is (equal "none" (nlk:json-value seen :string "reasoning" "effort")) "the admitted session choice reaches the provider request")
    (is (equal "off" (session-effort "think-off-run")))))
